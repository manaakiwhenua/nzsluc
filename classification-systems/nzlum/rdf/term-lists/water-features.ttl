@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix lus:  <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix wtr:  <https://nzlum.landcareresearch.co.nz/landuse/water-feature/> .
@prefix lu:   <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

lus:water_features a skos:ConceptScheme ;
  dct:title "NZLUM water features"@en ;
  dct:issued "2026-07-09"^^xsd:date .

wtr:drain a skos:Concept ;
  skos:inScheme lus:water_features ;
  skos:notation "drain" ;
  lu:colour "#C3DFFF" .

wtr:lagoon a skos:Concept ;
  skos:inScheme lus:water_features ;
  skos:notation "lagoon" ;
  lu:colour "#C3DFFF" .

wtr:lake a skos:Concept ;
  skos:inScheme lus:water_features ;
  skos:notation "lake" ;
  skos:usageNote "Matches any value prefixed with 'lake' (e.g. 'lake bed')."@en ;
  lu:colour "#C3DFFF" .

wtr:marine a skos:Concept ;
  skos:inScheme lus:water_features ;
  skos:notation "marine" ;
  lu:colour "#C3DFFF" .

wtr:pond a skos:Concept ;
  skos:inScheme lus:water_features ;
  skos:notation "pond" ;
  lu:colour "#C3DFFF" .

wtr:river a skos:Concept ;
  skos:inScheme lus:water_features ;
  skos:notation "river" ;
  lu:colour "#C3DFFF" .

wtr:sand a skos:Concept ;
  skos:inScheme lus:water_features ;
  skos:notation "sand" ;
  lu:colour "#FFFABA" .

wtr:mud a skos:Concept ;
  skos:inScheme lus:water_features ;
  skos:notation "mud" ;
  lu:colour "#D9C49E" .

wtr:ice a skos:Concept ;
  skos:inScheme lus:water_features ;
  skos:notation "ice" ;
  lu:colour "#EDF5FF" .

wtr:reef a skos:Concept ;
  skos:inScheme lus:water_features ;
  skos:notation "reef" ;
  lu:colour "#A9B0AD" .

wtr:swamp a skos:Concept ;
  skos:inScheme lus:water_features ;
  skos:notation "swamp" ;
  lu:colour "#83B09E" .

wtr:mangrove a skos:Concept ;
  skos:inScheme lus:water_features ;
  skos:notation "mangrove" ;
  lu:colour "#83B09E" .
