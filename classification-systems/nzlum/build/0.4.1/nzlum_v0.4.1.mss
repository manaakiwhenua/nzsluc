#nzlum {
  ::shape {
    polygon-opacity: 0.715;
    line-color: #232323;
    line-width: 0.26;
    line-opacity: 0.1;

    /* General unspecified/nulled category */
    [lu_code='NULL'] {
      polygon-fill: #fdffa6;
      polygon-opacity: 0.2;
    }

    // 1.0.0 Conservation and Minimal Use
    [lu_code = '1.0.0'] {
      polygon-fill: #7B6DB5;
    }

    // 1.1.0 Nature conservation
    [lu_code = '1.1.0'] {
      polygon-fill: #6A51A3;
    }

    // 1.1.1 Strict nature reserve
    [lu_code = '1.1.1'] {
      polygon-fill: #3F007D;
    }

    // 1.1.2 Wilderness area
    [lu_code = '1.1.2'] {
      polygon-fill: #54278F;
    }

    // 1.1.3 National Park
    [lu_code = '1.1.3'] {
      polygon-fill: #6A51A3;
    }

    // 1.1.4 Natural feature protection
    [lu_code = '1.1.4'] {
      polygon-fill: #807DBA;
    }

    // 1.1.5 Habitat or species management area
    [lu_code = '1.1.5'] {
      polygon-fill: #9E9AC8;
    }

    // 1.1.6 Protected landscape
    [lu_code = '1.1.6'] {
      polygon-fill: #BCBDDC;
    }

    // 1.1.7 Other conserved area
    [lu_code = '1.1.7'] {
      polygon-fill: #DADAEB;
    }

    // 1.2.0 Cultural and natural heritage
    [lu_code = '1.2.0'] {
      polygon-fill: #AD2D4A;
    }

    // 1.2.1 Indigenous cultural heritage
    [lu_code = '1.2.1'] {
      polygon-fill: #870330;
    }

    // 1.2.2 Cultural heritage
    [lu_code = '1.2.2'] {
      polygon-fill: #AD2D4A;
    }

    // 1.2.3 Natural heritage
    [lu_code = '1.2.3'] {
      polygon-fill: #DD5A70;
    }

    // 1.3.0 Minimal use from relatively natural environments
    [lu_code = '1.3.0'] {
      polygon-fill: #FFC77A;
    }

    // 1.3.1 Surface water supply
    [lu_code = '1.3.1'] {
      polygon-fill: #50816D;
    }

    // 1.3.2 Ground water
    [lu_code = '1.3.2'] {
      polygon-fill: #79AB96;
    }

    // 1.3.3 Grazing native vegetation
    [lu_code = '1.3.3'] {
      polygon-fill: #FFD5B1;
    }

    // 1.3.4 Production from indigenous vegetation
    [lu_code = '1.3.4'] {
      polygon-fill: #C6894C;
    }

    // 1.3.5 Customary use
    [lu_code = '1.3.5'] {
      polygon-fill: #A36B2E;
    }

    // 1.3.6 Defence land
    [lu_code = '1.3.6'] {
      polygon-fill: #FF9E17;
    }

    // 1.3.7 Environmental & infrastructure protection
    [lu_code = '1.3.7'] {
      polygon-fill: #FBB979;
    }

    // 1.3.8 Carbon forest
    [lu_code = '1.3.8'] {
      polygon-fill: #2E5E4B;
    }

    // 1.4.0 Unused and transitioning land
    [lu_code = '1.4.0'] {
      polygon-fill: #C8C69F;
    }

    // 1.4.1 Rehabilitating land
    [lu_code = '1.4.1'] {
      polygon-fill: #B2AC8B;
    }

    // 1.4.2 Unused land
    [lu_code = '1.4.2'] {
      polygon-fill: #DFD8B6;
    }

    // 2.0.0 Production agriculture and plantations
    [lu_code = '2.0.0'] {
      polygon-fill: #6E8C44;
    }

    // 2.1.0 Plantation forests
    [lu_code = '2.1.0'] {
      polygon-fill: #122112;
    }

    // 2.1.1 Exotic plantation forestry
    [lu_code = '2.1.1'] {
      polygon-fill: #0F3D1A;
    }

    // 2.1.2 Indigenous plantation forestry
    [lu_code = '2.1.2'] {
      polygon-fill: #23502B;
    }

    // 2.1.3 Other production uses
    [lu_code = '2.1.3'] {
      polygon-fill: #37633D;
    }

    // 2.1.4 Planted environmental & infrastructure protection
    [lu_code = '2.1.4'] {
      polygon-fill: #4A774F;
    }

    // 2.2.0 Grazing modified pasture systems
    [lu_code = '2.2.0'] {
      polygon-fill: #769B5C;
    }

    // 2.2.1 Dairy
    [lu_code = '2.2.1'] {
      polygon-fill: #5D8144;
    }

    // 2.2.2 Intensive dry stock
    [lu_code = '2.2.2'] {
      polygon-fill: #769B5C;
    }

    // 2.2.3 Extensive dry stock
    [lu_code = '2.2.3'] {
      polygon-fill: #91B675;
    }

    // 2.3.0 Short-rotation and seasonal cropping
    [lu_code = '2.3.0'] {
      polygon-fill: #C6A14D;
    }

    // 2.3.1 Arable cropping
    [lu_code = '2.3.1'] {
      polygon-fill: #A98734;
    }

    // 2.3.2 Arable and mixed livestock cropping
    [lu_code = '2.3.2'] {
      polygon-fill: #C6A14D;
    }

    // 2.3.3 Short-rotation horticulture
    [lu_code = '2.3.3'] {
      polygon-fill: #E3BC67;
    }

    // 2.3.4 Seasonal flowers and bulbs, and turf farming
    [lu_code = '2.3.4'] {
      polygon-fill: #FED57E;
    }

    // 2.4.0 Perennial horticulture
    [lu_code = '2.4.0'] {
      polygon-fill: #9EA083;
    }

    // 2.4.1 Tree crops
    [lu_code = '2.4.1'] {
      polygon-fill: #818367;
    }

    // 2.4.2 Vine fruits
    [lu_code = '2.4.2'] {
      polygon-fill: #9EA083;
    }

    // 2.4.3 Other perennial horticulture
    [lu_code = '2.4.3'] {
      polygon-fill: #BBBEA0;
    }

    // 2.5.0 Intensive horticulture
    [lu_code = '2.5.0'] {
      polygon-fill: #4A4C39;
    }

    // 2.5.1 Production nurseries
    [lu_code = '2.5.1'] {
      polygon-fill: #565126;
    }

    // 2.5.2 Glasshouses/shadehouses
    [lu_code = '2.5.2'] {
      polygon-fill: #797346;
    }

    // 2.6.0 Intensive animal production
    [lu_code = '2.6.0'] {
      polygon-fill: #C79588;
    }

    // 2.6.1 Intensive animal containment
    [lu_code = '2.6.1'] {
      polygon-fill: #9A6C60;
    }

    // 2.6.2 Poultry farms
    [lu_code = '2.6.2'] {
      polygon-fill: #C79588;
    }

    // 2.6.3 Piggeries
    [lu_code = '2.6.3'] {
      polygon-fill: #B08074;
    }

    // 2.6.4 Horse studs
    [lu_code = '2.6.4'] {
      polygon-fill: #DDAA9D;
    }

    // 2.6.5 Aquaculture
    [lu_code = '2.6.5'] {
      polygon-fill: #F5C0B2;
    }

    // 2.7.0 Water and wastewater
    [lu_code = '2.7.0'] {
      polygon-fill: #528582;
    }

    // 2.7.1 Stock water
    [lu_code = '2.7.1'] {
      polygon-fill: #528582;
    }

    // 2.7.2 Effluent pond
    [lu_code = '2.7.2'] {
      polygon-fill: #205351;
    }

    // 2.7.3 Water treatment – land application
    [lu_code = '2.7.3'] {
      polygon-fill: #396B69;
    }

    // 2.7.4 Water treatment – wetland
    [lu_code = '2.7.4'] {
      polygon-fill: #6C9F9C;
    }

    // 2.7.5 Irrigation reservoirs and canals
    [lu_code = '2.7.5'] {
      polygon-fill: #86BAB7;
    }

    // 2.8.0 Vacant and transitioning land
    [lu_code = '2.8.0'] {
      polygon-fill: #B6C8BC;
    }

    // 2.8.1 Rehabilitating land
    [lu_code = '2.8.1'] {
      polygon-fill: #B6C8BC;
    }

    // 2.8.2 Abandoned land
    [lu_code = '2.8.2'] {
      polygon-fill: #CADCD0;
    }

    // 2.8.3 Degraded land
    [lu_code = '2.8.3'] {
      polygon-fill: #94A599;
    }

    // 2.8.4 No defined use
    [lu_code = '2.8.4'] {
      polygon-fill: #DBEDE0;
    }

    // 2.9.0 Smallholder farm
    [lu_code = '2.9.0'] {
      polygon-fill: #E5D64F;
    }

    // 3.0.0 Built environment
    [lu_code = '3.0.0'] {
      polygon-fill: #8E7A78;
    }

    // 3.1.0 Residential
    [lu_code = '3.1.0'] {
      polygon-fill: #815E5B;
    }

    // 3.1.1 High-density residential
    [lu_code = '3.1.1'] {
      polygon-fill: #4C3B39;
    }

    // 3.1.2 Medium-density residential
    [lu_code = '3.1.2'] {
      polygon-fill: #644E4C;
    }

    // 3.1.3 Low-density residential
    [lu_code = '3.1.3'] {
      polygon-fill: #815E5B;
    }

    // 3.1.4 Rural residential
    [lu_code = '3.1.4'] {
      polygon-fill: #A87A76;
    }

    // 3.2.0 Public recreation and services
    [lu_code = '3.2.0'] {
      polygon-fill: #C19878;
    }

    // 3.2.1 Outdoor recreation
    [lu_code = '3.2.1'] {
      polygon-fill: #C19878;
    }

    // 3.2.2 Indoor recreation
    [lu_code = '3.2.2'] {
      polygon-fill: #958273;
    }

    // 3.2.3 Community services
    [lu_code = '3.2.3'] {
      polygon-fill: #E09962;
    }

    // 3.3.0 Commercial
    [lu_code = '3.3.0'] {
      polygon-fill: #6E94BA;
    }

    // 3.3.1 Retail
    [lu_code = '3.3.1'] {
      polygon-fill: #6E94BA;
    }

    // 3.3.2 Office
    [lu_code = '3.3.2'] {
      polygon-fill: #396285;
    }

    // 3.3.3 Hospitality
    [lu_code = '3.3.3'] {
      polygon-fill: #A4CAF2;
    }

    // 3.3.4 Entertainment
    [lu_code = '3.3.4'] {
      polygon-fill: #89AFD6;
    }

    // 3.3.5 Healthcare
    [lu_code = '3.3.5'] {
      polygon-fill: #D0E5FC;
    }

    // 3.3.6 Transportation & warehousing
    [lu_code = '3.3.6'] {
      polygon-fill: #547B9F;
    }

    // 3.4.0 Manufacturing and industrial
    [lu_code = '3.4.0'] {
      polygon-fill: #9598A8;
    }

    // 3.4.1 General purpose factory
    [lu_code = '3.4.1'] {
      polygon-fill: #9598A8;
    }

    // 3.4.2 Food processing factory
    [lu_code = '3.4.2'] {
      polygon-fill: #CED1E2;
    }

    // 3.4.3 Major industrial complex
    [lu_code = '3.4.3'] {
      polygon-fill: #838695;
    }

    // 3.4.4 Sawmill
    [lu_code = '3.4.4'] {
      polygon-fill: #A8AABB;
    }

    // 3.4.5 Farm buildings/infrastructure
    [lu_code = '3.4.5'] {
      polygon-fill: #E2E4F6;
    }

    // 3.4.6 Abattoirs
    [lu_code = '3.4.6'] {
      polygon-fill: #BBBDCE;
    }

    // 3.5.0 Utilities
    [lu_code = '3.5.0'] {
      polygon-fill: #955085;
    }

    // 3.5.1 Fuel powered electricity generation
    [lu_code = '3.5.1'] {
      polygon-fill: #7652A3;
    }

    // 3.5.2 Hydroelectricity generation
    [lu_code = '3.5.2'] {
      polygon-fill: #9670C4;
    }

    // 3.5.3 Wind electricity generation
    [lu_code = '3.5.3'] {
      polygon-fill: #D6B2FD;
    }

    // 3.5.4 Solar electricity generation
    [lu_code = '3.5.4'] {
      polygon-fill: #B78FE5;
    }

    // 3.5.5 Electricity substations and transmission
    [lu_code = '3.5.5'] {
      polygon-fill: #955085;
    }

    // 3.5.6 Gas treatment, storage, and transmission
    [lu_code = '3.5.6'] {
      polygon-fill: #B36CA2;
    }

    // 3.5.7 Water extraction and transmission
    [lu_code = '3.5.7'] {
      polygon-fill: #D289BF;
    }

    // 3.5.8 Navigation and communication
    [lu_code = '3.5.8'] {
      polygon-fill: #F2A6DE;
    }

    // 3.6.0 Transportation
    [lu_code = '3.6.0'] {
      polygon-fill: #72737E;
    }

    // 3.6.1 Airports/aerodromes
    [lu_code = '3.6.1'] {
      polygon-fill: #75777E;
    }

    // 3.6.2 Roads
    [lu_code = '3.6.2'] {
      polygon-fill: #494B51;
    }

    // 3.6.3 Railways
    [lu_code = '3.6.3'] {
      polygon-fill: #33353A;
    }

    // 3.6.4 Ports and water transport
    [lu_code = '3.6.4'] {
      polygon-fill: #61636A;
    }

    // 3.7.0 Mining
    [lu_code = '3.7.0'] {
      polygon-fill: #E1CEA7;
    }

    // 3.7.1 Mines
    [lu_code = '3.7.1'] {
      polygon-fill: #836639;
    }

    // 3.7.2 Quarries
    [lu_code = '3.7.2'] {
      polygon-fill: #9E7E51;
    }

    // 3.7.3 Tailings
    [lu_code = '3.7.3'] {
      polygon-fill: #BA9869;
    }

    // 3.7.4 Evaporation basins
    [lu_code = '3.7.4'] {
      polygon-fill: #FCD7A5;
    }

    // 3.7.5 Extractive industry not in use
    [lu_code = '3.7.5'] {
      polygon-fill: #D7B383;
    }

    // 3.8.0 Waste treatment and disposal
    [lu_code = '3.8.0'] {
      polygon-fill: #E77148;
    }

    // 3.8.1 Landfills
    [lu_code = '3.8.1'] {
      polygon-fill: #AC3F25;
    }

    // 3.8.2 Transfer stations and recycling facilities
    [lu_code = '3.8.2'] {
      polygon-fill: #E97453;
    }

    // 3.8.3 Municipal wastewater
    [lu_code = '3.8.3'] {
      polygon-fill: #CB593B;
    }

    // 3.8.4 Wastewater treatment – land application
    [lu_code = '3.8.4'] {
      polygon-fill: #FF9475;
    }

    // 3.8.5 Stormwater management
    [lu_code = '3.8.5'] {
      polygon-fill: #FEBDAA;
    }

    // 3.9.0 Vacant and transitioning land
    [lu_code = '3.9.0'] {
      polygon-fill: #D69B97;
    }

    // 3.9.1 Brownfield development
    [lu_code = '3.9.1'] {
      polygon-fill: #87636E;
    }

    // 3.9.2 Greenfield development
    [lu_code = '3.9.2'] {
      polygon-fill: #AC8792;
    }

    // 3.9.3 Idle and derelict land
    [lu_code = '3.9.3'] {
      polygon-fill: #D3ACB7;
    }

    /* Water features, other than ice or wetlands (below) */
    [water!=''][water!='ice'][water!='swamp'][water!='mangrove'] {
      polygon-fill: #43a2ca;
    }

    /* Wetlands - coloured separately, matching wtr:swamp/wtr:mangrove
       in rdf/term-lists/water-features.ttl */
    [water='swamp'], [water='mangrove'] {
      polygon-fill: #83B09E;
    }

    /* Slightly emphasise parcels with a recorded commodity */
    [commod!=''] {
      polygon-opacity: 0.95;
    }
  }

  ::label {
    [zoom>14] {
      text-name: [comment];
      text-face-name: 'Open Sans Regular';
      text-avoid-edges: true;
      text-allow-overlap: false;
      text-character-spacing: 0.5;
      text-size: 12;
      text-fill: #fff;
      text-halo-fill: fadeout(black, 40%);
      text-halo-radius: 1;
    }
  }
}
