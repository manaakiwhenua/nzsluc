@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:animals skos:member com:geese ;
    skos:prefLabel "Animals"@en .

com:geese.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:geese.jsonld,
        com:geese.rdf,
        com:geese.ttl .

com:geese.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:geese .

com:geese.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:geese .

com:geese.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:geese .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:geese a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "geese" ;
    skos:usageNote "Poultry farms."@en ;
    foaf:isPrimaryTopicOf com:geese.html .

