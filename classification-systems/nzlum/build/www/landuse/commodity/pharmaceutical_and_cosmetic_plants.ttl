@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:crop skos:member com:pharmaceutical_and_cosmetic_plants ;
    skos:prefLabel "Crop"@en .

com:pharmaceutical_and_cosmetic_plants.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:pharmaceutical_and_cosmetic_plants.jsonld,
        com:pharmaceutical_and_cosmetic_plants.rdf,
        com:pharmaceutical_and_cosmetic_plants.ttl .

com:pharmaceutical_and_cosmetic_plants.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:pharmaceutical_and_cosmetic_plants .

com:pharmaceutical_and_cosmetic_plants.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:pharmaceutical_and_cosmetic_plants .

com:pharmaceutical_and_cosmetic_plants.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:pharmaceutical_and_cosmetic_plants .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:pharmaceutical_and_cosmetic_plants a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "pharmaceutical and cosmetic plants" ;
    foaf:isPrimaryTopicOf com:pharmaceutical_and_cosmetic_plants.html .

