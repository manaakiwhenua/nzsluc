@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:vegetables_and_herbs skos:member com:asparagus ;
    skos:prefLabel "Vegetables and herbs"@en .

com:asparagus.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:asparagus.jsonld,
        com:asparagus.rdf,
        com:asparagus.ttl .

com:asparagus.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:asparagus .

com:asparagus.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:asparagus .

com:asparagus.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:asparagus .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:asparagus a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "asparagus" ;
    foaf:isPrimaryTopicOf com:asparagus.html .

