@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:grapefruit ;
    skos:prefLabel "Fruit"@en .

com:grapefruit.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:grapefruit.jsonld,
        com:grapefruit.rdf,
        com:grapefruit.ttl .

com:grapefruit.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:grapefruit .

com:grapefruit.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:grapefruit .

com:grapefruit.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:grapefruit .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:grapefruit a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "grapefruit" ;
    foaf:isPrimaryTopicOf com:grapefruit.html .

