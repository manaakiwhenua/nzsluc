@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:aloe_vera skos:notation "aloe vera"@en .

com:cocoa skos:notation "cocoa"@en .

com:coffee skos:notation "coffee" .

com:cotton skos:notation "cotton"@en .

com:cotton_seed skos:notation "cotton seed"@en .

com:crop.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:crop.jsonld,
        com:crop.rdf,
        com:crop.ttl .

com:crop.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:crop .

com:crop.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:crop .

com:crop.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:crop .

com:essential_oil_crops skos:notation "essential oil crops"@en .

com:ginger skos:notation "ginger"@en .

com:hops skos:notation "hops" .

com:horseradish skos:notation "horseradish" .

com:jute skos:notation "jute" .

com:oil_palms skos:notation "oil palms" .

com:pepper skos:notation "pepper" .

com:pharmaceutical_and_cosmetic_plants skos:notation "pharmaceutical and cosmetic plants" .

com:poppies skos:notation "poppies " .

com:pyrethrum skos:notation "pyrethrum" .

com:sugar_cane skos:notation "sugar cane" .

com:tea skos:notation "tea" .

com:tobacco skos:notation "tobacco" .

com:wasabi skos:notation "wasabi" .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:crop a skos:Collection ;
    skos:inScheme lus:commodities ;
    skos:member com:aloe_vera,
        com:cocoa,
        com:coffee,
        com:cotton,
        com:cotton_seed,
        com:essential_oil_crops,
        com:ginger,
        com:hops,
        com:horseradish,
        com:jute,
        com:oil_palms,
        com:pepper,
        com:pharmaceutical_and_cosmetic_plants,
        com:poppies,
        com:pyrethrum,
        com:sugar_cane,
        com:tea,
        com:tobacco,
        com:wasabi ;
    skos:prefLabel "Crop"@en ;
    foaf:isPrimaryTopicOf com:crop.html .

