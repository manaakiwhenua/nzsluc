@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:animals skos:member com:goats_meat ;
    skos:prefLabel "Animals"@en .

com:goats skos:notation "goats" .

com:goats_meat.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:goats_meat.jsonld,
        com:goats_meat.rdf,
        com:goats_meat.ttl .

com:goats_meat.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:goats_meat .

com:goats_meat.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:goats_meat .

com:goats_meat.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:goats_meat .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:goats_meat a skos:Concept ;
    skos:broader com:goats ;
    skos:inScheme lus:commodities ;
    skos:notation "goats meat" ;
    skos:usageNote "Goats for meat production."@en ;
    foaf:isPrimaryTopicOf com:goats_meat.html .

