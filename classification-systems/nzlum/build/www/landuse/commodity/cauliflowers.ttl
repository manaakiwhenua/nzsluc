@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:vegetables_and_herbs skos:member com:cauliflowers ;
    skos:prefLabel "Vegetables and herbs"@en .

com:cauliflowers.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:cauliflowers.jsonld,
        com:cauliflowers.rdf,
        com:cauliflowers.ttl .

com:cauliflowers.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:cauliflowers .

com:cauliflowers.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:cauliflowers .

com:cauliflowers.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:cauliflowers .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:cauliflowers a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "cauliflowers" ;
    foaf:isPrimaryTopicOf com:cauliflowers.html .

