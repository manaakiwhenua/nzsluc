@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:animals skos:member com:chickens_meat ;
    skos:prefLabel "Animals"@en .

com:chickens skos:notation "chickens" .

com:chickens_meat.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:chickens_meat.jsonld,
        com:chickens_meat.rdf,
        com:chickens_meat.ttl .

com:chickens_meat.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:chickens_meat .

com:chickens_meat.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:chickens_meat .

com:chickens_meat.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:chickens_meat .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:chickens_meat a skos:Concept ;
    skos:broader com:chickens ;
    skos:inScheme lus:commodities ;
    skos:notation "chickens meat" ;
    skos:usageNote "Poultry farms. Production mainly for meat."@en ;
    foaf:isPrimaryTopicOf com:chickens_meat.html .

