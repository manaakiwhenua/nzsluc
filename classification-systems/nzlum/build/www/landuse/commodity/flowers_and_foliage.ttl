@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:flowers_and_bulbs skos:member com:flowers_and_foliage ;
    skos:prefLabel "Flowers and bulbs"@en .

com:flowers_and_foliage.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:flowers_and_foliage.jsonld,
        com:flowers_and_foliage.rdf,
        com:flowers_and_foliage.ttl .

com:flowers_and_foliage.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:flowers_and_foliage .

com:flowers_and_foliage.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:flowers_and_foliage .

com:flowers_and_foliage.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:flowers_and_foliage .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:flowers_and_foliage a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "flowers and foliage" ;
    foaf:isPrimaryTopicOf com:flowers_and_foliage.html .

