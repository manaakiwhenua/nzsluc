@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:mines skos:member com:copper ;
    skos:prefLabel "Mines"@en .

com:copper.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:copper.jsonld,
        com:copper.rdf,
        com:copper.ttl .

com:copper.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:copper .

com:copper.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:copper .

com:copper.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:copper .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:copper a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "copper" ;
    foaf:isPrimaryTopicOf com:copper.html .

