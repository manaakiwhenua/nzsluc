@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:oilseeds skos:member com:safflower ;
    skos:prefLabel "Oilseeds"@en .

com:safflower.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:safflower.jsonld,
        com:safflower.rdf,
        com:safflower.ttl .

com:safflower.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:safflower .

com:safflower.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:safflower .

com:safflower.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:safflower .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:safflower a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "safflower" ;
    foaf:isPrimaryTopicOf com:safflower.html .

