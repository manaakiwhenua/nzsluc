@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:vegetables_and_herbs skos:member com:echinacea ;
    skos:prefLabel "Vegetables and herbs"@en .

com:echinacea.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:echinacea.jsonld,
        com:echinacea.rdf,
        com:echinacea.ttl .

com:echinacea.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:echinacea .

com:echinacea.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:echinacea .

com:echinacea.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:echinacea .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:echinacea a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "echinacea" ;
    foaf:isPrimaryTopicOf com:echinacea.html .

