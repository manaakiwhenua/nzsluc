@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:forest skos:member com:bamboo ;
    skos:prefLabel "Forest"@en .

com:bamboo.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:bamboo.jsonld,
        com:bamboo.rdf,
        com:bamboo.ttl .

com:bamboo.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:bamboo .

com:bamboo.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:bamboo .

com:bamboo.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:bamboo .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:bamboo a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "bamboo" ;
    foaf:isPrimaryTopicOf com:bamboo.html .

