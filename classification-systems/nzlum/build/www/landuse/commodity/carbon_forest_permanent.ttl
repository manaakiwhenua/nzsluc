@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:forest skos:member com:carbon_forest_permanent ;
    skos:prefLabel "Forest"@en .

com:carbon_forest_permanent.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:carbon_forest_permanent.jsonld,
        com:carbon_forest_permanent.rdf,
        com:carbon_forest_permanent.ttl .

com:carbon_forest_permanent.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:carbon_forest_permanent .

com:carbon_forest_permanent.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:carbon_forest_permanent .

com:carbon_forest_permanent.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:carbon_forest_permanent .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:carbon_forest_permanent a skos:Concept ;
    skos:definition "Permanent carbon forestry under the ETS. These are post-1989 forests that will not be clear-felled. They are expected to remain in permanent forestry for at least 50 years. Before 1 January 2023, the ETS didn't distinguish between standard and permanent forestry. Post-1989 forest land that entered the ETS before 1 January 2023 is standard forestry, unless an application has been accepted to change it to permanent forestry."@en ;
    skos:inScheme lus:commodities ;
    skos:notation "carbon forest permanent" ;
    foaf:isPrimaryTopicOf com:carbon_forest_permanent.html .

