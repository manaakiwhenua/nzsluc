@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:vegetables_and_herbs skos:member com:sweet_potatoes ;
    skos:prefLabel "Vegetables and herbs"@en .

com:sweet_potatoes.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:sweet_potatoes.jsonld,
        com:sweet_potatoes.rdf,
        com:sweet_potatoes.ttl .

com:sweet_potatoes.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:sweet_potatoes .

com:sweet_potatoes.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:sweet_potatoes .

com:sweet_potatoes.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:sweet_potatoes .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:sweet_potatoes a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "sweet potatoes" ;
    foaf:isPrimaryTopicOf com:sweet_potatoes.html .

