@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:crop skos:member com:pepper ;
    skos:prefLabel "Crop"@en .

com:pepper.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:pepper.jsonld,
        com:pepper.rdf,
        com:pepper.ttl .

com:pepper.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:pepper .

com:pepper.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:pepper .

com:pepper.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:pepper .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:pepper a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "pepper" ;
    foaf:isPrimaryTopicOf com:pepper.html .

