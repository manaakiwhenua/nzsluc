@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:vegetables_and_herbs skos:member com:leeks ;
    skos:prefLabel "Vegetables and herbs"@en .

com:leeks.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:leeks.jsonld,
        com:leeks.rdf,
        com:leeks.ttl .

com:leeks.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:leeks .

com:leeks.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:leeks .

com:leeks.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:leeks .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:leeks a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "leeks" ;
    foaf:isPrimaryTopicOf com:leeks.html .

