@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:vegetables_and_herbs skos:member com:garlic ;
    skos:prefLabel "Vegetables and herbs"@en .

com:garlic.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:garlic.jsonld,
        com:garlic.rdf,
        com:garlic.ttl .

com:garlic.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:garlic .

com:garlic.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:garlic .

com:garlic.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:garlic .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:garlic a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "garlic" ;
    foaf:isPrimaryTopicOf com:garlic.html .

