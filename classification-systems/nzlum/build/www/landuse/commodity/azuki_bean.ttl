@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:pulses skos:member com:azuki_bean ;
    skos:prefLabel "Pulses"@en .

com:azuki_bean.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:azuki_bean.jsonld,
        com:azuki_bean.rdf,
        com:azuki_bean.ttl .

com:azuki_bean.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:azuki_bean .

com:azuki_bean.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:azuki_bean .

com:azuki_bean.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:azuki_bean .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:azuki_bean a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "azuki bean" ;
    foaf:isPrimaryTopicOf com:azuki_bean.html .

