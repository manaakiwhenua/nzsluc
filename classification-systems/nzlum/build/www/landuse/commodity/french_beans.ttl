@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:vegetables_and_herbs skos:member com:french_beans ;
    skos:prefLabel "Vegetables and herbs"@en .

com:french_beans.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:french_beans.jsonld,
        com:french_beans.rdf,
        com:french_beans.ttl .

com:french_beans.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:french_beans .

com:french_beans.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:french_beans .

com:french_beans.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:french_beans .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:french_beans a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "french beans" ;
    foaf:isPrimaryTopicOf com:french_beans.html .

