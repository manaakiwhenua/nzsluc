@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:flowers_and_bulbs skos:member com:orchids ;
    skos:prefLabel "Flowers and bulbs"@en .

com:orchids.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:orchids.jsonld,
        com:orchids.rdf,
        com:orchids.ttl .

com:orchids.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:orchids .

com:orchids.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:orchids .

com:orchids.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:orchids .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:orchids a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "orchids" ;
    foaf:isPrimaryTopicOf com:orchids.html .

