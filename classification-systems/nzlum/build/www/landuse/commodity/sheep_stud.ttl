@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:animals skos:member com:sheep_stud ;
    skos:prefLabel "Animals"@en .

com:sheep skos:notation "sheep" .

com:sheep_stud.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:sheep_stud.jsonld,
        com:sheep_stud.rdf,
        com:sheep_stud.ttl .

com:sheep_stud.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:sheep_stud .

com:sheep_stud.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:sheep_stud .

com:sheep_stud.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:sheep_stud .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:sheep_stud a skos:Concept ;
    skos:broader com:sheep ;
    skos:inScheme lus:commodities ;
    skos:notation "sheep stud" ;
    skos:usageNote "Sheep raised for sale as breeding animals."@en ;
    foaf:isPrimaryTopicOf com:sheep_stud.html .

