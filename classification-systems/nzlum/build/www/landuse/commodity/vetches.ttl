@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:pulses skos:member com:vetches ;
    skos:prefLabel "Pulses"@en .

com:vetches.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:vetches.jsonld,
        com:vetches.rdf,
        com:vetches.ttl .

com:vetches.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:vetches .

com:vetches.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:vetches .

com:vetches.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:vetches .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:vetches a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "vetches" ;
    foaf:isPrimaryTopicOf com:vetches.html .

