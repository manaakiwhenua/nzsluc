@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:vegetables_and_herbs skos:member com:silverbeet_and_spinach ;
    skos:prefLabel "Vegetables and herbs"@en .

com:silverbeet_and_spinach.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:silverbeet_and_spinach.jsonld,
        com:silverbeet_and_spinach.rdf,
        com:silverbeet_and_spinach.ttl .

com:silverbeet_and_spinach.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:silverbeet_and_spinach .

com:silverbeet_and_spinach.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:silverbeet_and_spinach .

com:silverbeet_and_spinach.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:silverbeet_and_spinach .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:silverbeet_and_spinach a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "silverbeet and spinach" ;
    foaf:isPrimaryTopicOf com:silverbeet_and_spinach.html .

