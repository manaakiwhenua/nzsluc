@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:flowers_and_bulbs skos:member com:chrysanthemums ;
    skos:prefLabel "Flowers and bulbs"@en .

com:chrysanthemums.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:chrysanthemums.jsonld,
        com:chrysanthemums.rdf,
        com:chrysanthemums.ttl .

com:chrysanthemums.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:chrysanthemums .

com:chrysanthemums.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:chrysanthemums .

com:chrysanthemums.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:chrysanthemums .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:chrysanthemums a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "chrysanthemums" ;
    foaf:isPrimaryTopicOf com:chrysanthemums.html .

