@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:crop skos:member com:essential_oil_crops ;
    skos:prefLabel "Crop"@en .

com:essential_oil_crops.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:essential_oil_crops.jsonld,
        com:essential_oil_crops.rdf,
        com:essential_oil_crops.ttl .

com:essential_oil_crops.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:essential_oil_crops .

com:essential_oil_crops.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:essential_oil_crops .

com:essential_oil_crops.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:essential_oil_crops .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:essential_oil_crops a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "essential oil crops"@en ;
    foaf:isPrimaryTopicOf com:essential_oil_crops.html .

