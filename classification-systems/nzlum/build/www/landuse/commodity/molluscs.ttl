@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:animals skos:member com:molluscs ;
    skos:prefLabel "Animals"@en .

com:molluscs.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:molluscs.jsonld,
        com:molluscs.rdf,
        com:molluscs.ttl .

com:molluscs.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:molluscs .

com:molluscs.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:molluscs .

com:molluscs.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:molluscs .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:molluscs a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "molluscs" ;
    skos:usageNote "Aquaculture: includes peal oysters, edible oysters, abalone, mussels."@en ;
    foaf:isPrimaryTopicOf com:molluscs.html .

