@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:melons ;
    skos:prefLabel "Fruit"@en .

com:melons.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:melons.jsonld,
        com:melons.rdf,
        com:melons.ttl .

com:melons.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:melons .

com:melons.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:melons .

com:melons.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:melons .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:melons a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "melons" ;
    foaf:isPrimaryTopicOf com:melons.html .

