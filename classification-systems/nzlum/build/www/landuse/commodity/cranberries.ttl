@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:cranberries ;
    skos:prefLabel "Fruit"@en .

com:cranberries.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:cranberries.jsonld,
        com:cranberries.rdf,
        com:cranberries.ttl .

com:cranberries.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:cranberries .

com:cranberries.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:cranberries .

com:cranberries.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:cranberries .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:cranberries a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "cranberries" ;
    foaf:isPrimaryTopicOf com:cranberries.html .

