@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:custard_apples ;
    skos:prefLabel "Fruit"@en .

com:custard_apples.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:custard_apples.jsonld,
        com:custard_apples.rdf,
        com:custard_apples.ttl .

com:custard_apples.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:custard_apples .

com:custard_apples.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:custard_apples .

com:custard_apples.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:custard_apples .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:custard_apples a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "custard apples" ;
    foaf:isPrimaryTopicOf com:custard_apples.html .

