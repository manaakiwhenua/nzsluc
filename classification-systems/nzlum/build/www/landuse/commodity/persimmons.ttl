@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:persimmons ;
    skos:prefLabel "Fruit"@en .

com:persimmons.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:persimmons.jsonld,
        com:persimmons.rdf,
        com:persimmons.ttl .

com:persimmons.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:persimmons .

com:persimmons.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:persimmons .

com:persimmons.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:persimmons .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:persimmons a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "persimmons" ;
    foaf:isPrimaryTopicOf com:persimmons.html .

