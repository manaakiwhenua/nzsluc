@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:animals skos:member com:goats_dairy ;
    skos:prefLabel "Animals"@en .

com:goats skos:notation "goats" .

com:goats_dairy.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:goats_dairy.jsonld,
        com:goats_dairy.rdf,
        com:goats_dairy.ttl .

com:goats_dairy.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:goats_dairy .

com:goats_dairy.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:goats_dairy .

com:goats_dairy.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:goats_dairy .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:goats_dairy a skos:Concept ;
    skos:broader com:goats ;
    skos:inScheme lus:commodities ;
    skos:notation "goats dairy" ;
    skos:usageNote "Goats for milk production."@en ;
    foaf:isPrimaryTopicOf com:goats_dairy.html .

