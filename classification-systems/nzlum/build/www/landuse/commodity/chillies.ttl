@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:vegetables_and_herbs skos:member com:chillies ;
    skos:prefLabel "Vegetables and herbs"@en .

com:chillies.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:chillies.jsonld,
        com:chillies.rdf,
        com:chillies.ttl .

com:chillies.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:chillies .

com:chillies.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:chillies .

com:chillies.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:chillies .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:chillies a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "chillies" ;
    foaf:isPrimaryTopicOf com:chillies.html .

