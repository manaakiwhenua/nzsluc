@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:nuts skos:member com:pistachios ;
    skos:prefLabel "Nuts"@en .

com:pistachios.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:pistachios.jsonld,
        com:pistachios.rdf,
        com:pistachios.ttl .

com:pistachios.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:pistachios .

com:pistachios.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:pistachios .

com:pistachios.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:pistachios .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:pistachios a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "pistachios" ;
    foaf:isPrimaryTopicOf com:pistachios.html .

