@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:raspberries ;
    skos:prefLabel "Fruit"@en .

com:raspberries.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:raspberries.jsonld,
        com:raspberries.rdf,
        com:raspberries.ttl .

com:raspberries.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:raspberries .

com:raspberries.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:raspberries .

com:raspberries.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:raspberries .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:raspberries a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "raspberries" ;
    foaf:isPrimaryTopicOf com:raspberries.html .

