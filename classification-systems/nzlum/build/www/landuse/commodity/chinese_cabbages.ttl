@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:vegetables_and_herbs skos:member com:chinese_cabbages ;
    skos:prefLabel "Vegetables and herbs"@en .

com:chinese_cabbages.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:chinese_cabbages.jsonld,
        com:chinese_cabbages.rdf,
        com:chinese_cabbages.ttl .

com:chinese_cabbages.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:chinese_cabbages .

com:chinese_cabbages.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:chinese_cabbages .

com:chinese_cabbages.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:chinese_cabbages .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:chinese_cabbages a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "chinese cabbages" ;
    foaf:isPrimaryTopicOf com:chinese_cabbages.html .

