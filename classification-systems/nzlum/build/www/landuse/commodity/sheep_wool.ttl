@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:animals skos:member com:sheep_wool ;
    skos:prefLabel "Animals"@en .

com:sheep skos:notation "sheep" .

com:sheep_wool.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:sheep_wool.jsonld,
        com:sheep_wool.rdf,
        com:sheep_wool.ttl .

com:sheep_wool.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:sheep_wool .

com:sheep_wool.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:sheep_wool .

com:sheep_wool.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:sheep_wool .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:sheep_wool a skos:Concept ;
    skos:broader com:sheep ;
    skos:inScheme lus:commodities ;
    skos:notation "sheep wool" ;
    skos:usageNote "Sheep for fibre production."@en ;
    foaf:isPrimaryTopicOf com:sheep_wool.html .

