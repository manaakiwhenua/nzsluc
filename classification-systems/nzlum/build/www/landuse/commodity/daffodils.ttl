@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:flowers_and_bulbs skos:member com:daffodils ;
    skos:prefLabel "Flowers and bulbs"@en .

com:daffodils.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:daffodils.jsonld,
        com:daffodils.rdf,
        com:daffodils.ttl .

com:daffodils.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:daffodils .

com:daffodils.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:daffodils .

com:daffodils.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:daffodils .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:daffodils a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "daffodils" ;
    foaf:isPrimaryTopicOf com:daffodils.html .

