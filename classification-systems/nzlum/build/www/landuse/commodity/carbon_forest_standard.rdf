  <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/commodity/forest">
    <skos:member>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/commodity/carbon_forest_standard">
        <skos:definition xml:lang="en">Standard carbon foresty under the ETS. Standard forestry refers to post-1989 forests under the ETS that are expected to be regularly harvested and replanted, such as commercial plantation forests. Other commodities (such as sawlog) are compatible.</skos:definition>
        <skos:notation>carbon forest standard</skos:notation>
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/commodities"/>
        <foaf:isPrimaryTopicOf rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/commodity/carbon_forest_standard.html"/>
      </skos:Concept>
    </skos:member>
    <skos:prefLabel xml:lang="en">Forest</skos:prefLabel>
  </rdf:Description>
