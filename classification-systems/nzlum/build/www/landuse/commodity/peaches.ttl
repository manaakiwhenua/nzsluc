@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:peaches ;
    skos:prefLabel "Fruit"@en .

com:peaches.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:peaches.jsonld,
        com:peaches.rdf,
        com:peaches.ttl .

com:peaches.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:peaches .

com:peaches.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:peaches .

com:peaches.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:peaches .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:peaches a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "peaches" ;
    foaf:isPrimaryTopicOf com:peaches.html .

