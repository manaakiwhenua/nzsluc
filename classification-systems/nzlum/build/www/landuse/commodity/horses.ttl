@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:animals skos:member com:horses ;
    skos:prefLabel "Animals"@en .

com:horses.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:horses.jsonld,
        com:horses.rdf,
        com:horses.ttl .

com:horses.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:horses .

com:horses.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:horses .

com:horses.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:horses .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:horses a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "horses" ;
    skos:usageNote "Includes horse studs and recreational uses."@en ;
    foaf:isPrimaryTopicOf com:horses.html .

