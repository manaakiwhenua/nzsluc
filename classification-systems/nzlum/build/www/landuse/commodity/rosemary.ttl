@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:vegetables_and_herbs skos:member com:rosemary ;
    skos:prefLabel "Vegetables and herbs"@en .

com:rosemary.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:rosemary.jsonld,
        com:rosemary.rdf,
        com:rosemary.ttl .

com:rosemary.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:rosemary .

com:rosemary.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:rosemary .

com:rosemary.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:rosemary .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:rosemary a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "rosemary" ;
    foaf:isPrimaryTopicOf com:rosemary.html .

