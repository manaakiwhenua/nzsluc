lus:commodities dcterms:title "NZLUM commodities"@en .

com:fruit a skos:Collection ;
    skos:inScheme lus:commodities ;
    skos:member com:apples,
        com:apricots,
        com:avocados,
        com:babacos,
        com:bananas,
        com:blackberries,
        com:blackcurrants,
        com:blueberries,
