com:grapes_wine skos:notation "grapes wine" .

com:guavas skos:notation "guavas" .

com:jackfruit skos:notation "jackfruit" .

com:kiwifruit skos:notation "kiwifruit" .

com:kumquat skos:notation "kumquat" .

