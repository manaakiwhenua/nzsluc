@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:apples skos:notation "apples" .

com:apricots skos:notation "apricots" .

com:avocados skos:notation "avocados" .

com:babacos skos:notation "babacos" .

com:bananas skos:notation "bananas" .

com:blackberries skos:notation "blackberries" .

com:blackcurrants skos:notation "blackcurrants" .

com:blueberries skos:notation "blueberries" .

com:boysenberries skos:notation "boysenberries" .

com:carambolas skos:notation "carambolas" .

com:cherries skos:notation "cherries" .

com:chokos skos:notation "chokos" .

com:coconut skos:notation "coconut" .

com:cranberries skos:notation "cranberries" .

com:custard_apples skos:notation "custard apples" .

com:dates skos:notation "dates" .

com:dragon_fruit skos:notation "dragon fruit" .

com:feijoa skos:notation "feijoa" .

com:figs skos:notation "figs" .

com:fruit.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:fruit.jsonld,
        com:fruit.rdf,
        com:fruit.ttl .

com:fruit.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:fruit .

com:fruit.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:fruit .

com:fruit.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:fruit .

com:gooseberries skos:notation "gooseberries" .

