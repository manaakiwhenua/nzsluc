@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:pasture skos:member com:sorghum_forage ;
    skos:prefLabel "Pasture"@en .

com:sorghum_forage.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:sorghum_forage.jsonld,
        com:sorghum_forage.rdf,
        com:sorghum_forage.ttl .

com:sorghum_forage.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:sorghum_forage .

com:sorghum_forage.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:sorghum_forage .

com:sorghum_forage.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:sorghum_forage .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:sorghum_forage a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "sorghum forage" ;
    foaf:isPrimaryTopicOf com:sorghum_forage.html .

