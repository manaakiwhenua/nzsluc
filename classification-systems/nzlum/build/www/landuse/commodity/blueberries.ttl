@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:blueberries ;
    skos:prefLabel "Fruit"@en .

com:blueberries.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:blueberries.jsonld,
        com:blueberries.rdf,
        com:blueberries.ttl .

com:blueberries.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:blueberries .

com:blueberries.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:blueberries .

com:blueberries.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:blueberries .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:blueberries a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "blueberries" ;
    foaf:isPrimaryTopicOf com:blueberries.html .

