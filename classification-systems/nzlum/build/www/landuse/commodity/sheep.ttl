@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:animals skos:member com:sheep ;
    skos:prefLabel "Animals"@en .

com:sheep.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:sheep.jsonld,
        com:sheep.rdf,
        com:sheep.ttl .

com:sheep.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:sheep .

com:sheep.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:sheep .

com:sheep.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:sheep .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:sheep a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "sheep" ;
    skos:usageNote "Specify meat, dairy, stud or wool where appropriate."@en ;
    foaf:isPrimaryTopicOf com:sheep.html .

