@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:vegetables_and_herbs skos:member com:bitter_melon ;
    skos:prefLabel "Vegetables and herbs"@en .

com:bitter_melon.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:bitter_melon.jsonld,
        com:bitter_melon.rdf,
        com:bitter_melon.ttl .

com:bitter_melon.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:bitter_melon .

com:bitter_melon.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:bitter_melon .

com:bitter_melon.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:bitter_melon .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:bitter_melon a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "bitter melon" ;
    foaf:isPrimaryTopicOf com:bitter_melon.html .

