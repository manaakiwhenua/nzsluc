@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:cherries ;
    skos:prefLabel "Fruit"@en .

com:cherries.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:cherries.jsonld,
        com:cherries.rdf,
        com:cherries.ttl .

com:cherries.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:cherries .

com:cherries.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:cherries .

com:cherries.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:cherries .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:cherries a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "cherries" ;
    foaf:isPrimaryTopicOf com:cherries.html .

