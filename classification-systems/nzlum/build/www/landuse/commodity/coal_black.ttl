@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:mines skos:member com:coal_black ;
    skos:prefLabel "Mines"@en .

com:coal_black.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:coal_black.jsonld,
        com:coal_black.rdf,
        com:coal_black.ttl .

com:coal_black.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:coal_black .

com:coal_black.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:coal_black .

com:coal_black.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:coal_black .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:coal_black a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "coal_black " ;
    foaf:isPrimaryTopicOf com:coal_black.html .

