@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:animals skos:member com:cattle_meat ;
    skos:prefLabel "Animals"@en .

com:cattle skos:notation "cattle" .

com:cattle_meat.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:cattle_meat.jsonld,
        com:cattle_meat.rdf,
        com:cattle_meat.ttl .

com:cattle_meat.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:cattle_meat .

com:cattle_meat.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:cattle_meat .

com:cattle_meat.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:cattle_meat .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:cattle_meat a skos:Concept ;
    skos:broader com:cattle ;
    skos:inScheme lus:commodities ;
    skos:notation "cattle meat" ;
    skos:usageNote "Cattle for meat (beef) production."@en ;
    foaf:isPrimaryTopicOf com:cattle_meat.html .

