@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:kumquat ;
    skos:prefLabel "Fruit"@en .

com:kumquat.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:kumquat.jsonld,
        com:kumquat.rdf,
        com:kumquat.ttl .

com:kumquat.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:kumquat .

com:kumquat.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:kumquat .

com:kumquat.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:kumquat .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:kumquat a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "kumquat" ;
    foaf:isPrimaryTopicOf com:kumquat.html .

