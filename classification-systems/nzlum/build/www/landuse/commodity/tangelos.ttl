@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:tangelos ;
    skos:prefLabel "Fruit"@en .

com:tangelos.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:tangelos.jsonld,
        com:tangelos.rdf,
        com:tangelos.ttl .

com:tangelos.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:tangelos .

com:tangelos.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:tangelos .

com:tangelos.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:tangelos .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:tangelos a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "tangelos" ;
    foaf:isPrimaryTopicOf com:tangelos.html .

