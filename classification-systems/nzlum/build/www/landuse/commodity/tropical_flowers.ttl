@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:flowers_and_bulbs skos:member com:tropical_flowers ;
    skos:prefLabel "Flowers and bulbs"@en .

com:tropical_flowers.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:tropical_flowers.jsonld,
        com:tropical_flowers.rdf,
        com:tropical_flowers.ttl .

com:tropical_flowers.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:tropical_flowers .

com:tropical_flowers.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:tropical_flowers .

com:tropical_flowers.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:tropical_flowers .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:tropical_flowers a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "tropical flowers" ;
    foaf:isPrimaryTopicOf com:tropical_flowers.html .

