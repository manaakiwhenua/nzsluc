@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:pawpaws ;
    skos:prefLabel "Fruit"@en .

com:pawpaws.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:pawpaws.jsonld,
        com:pawpaws.rdf,
        com:pawpaws.ttl .

com:pawpaws.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:pawpaws .

com:pawpaws.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:pawpaws .

com:pawpaws.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:pawpaws .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:pawpaws a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "pawpaws" ;
    foaf:isPrimaryTopicOf com:pawpaws.html .

