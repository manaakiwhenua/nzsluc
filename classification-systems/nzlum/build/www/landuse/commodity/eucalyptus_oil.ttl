@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:forest skos:member com:eucalyptus_oil ;
    skos:prefLabel "Forest"@en .

com:eucalyptus_oil.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:eucalyptus_oil.jsonld,
        com:eucalyptus_oil.rdf,
        com:eucalyptus_oil.ttl .

com:eucalyptus_oil.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:eucalyptus_oil .

com:eucalyptus_oil.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:eucalyptus_oil .

com:eucalyptus_oil.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:eucalyptus_oil .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:eucalyptus_oil a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "eucalyptus oil" ;
    foaf:isPrimaryTopicOf com:eucalyptus_oil.html .

