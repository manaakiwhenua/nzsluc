@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:clover skos:notation "clover" .

com:lucerne skos:notation "lucerne" .

com:pasture.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:pasture.jsonld,
        com:pasture.rdf,
        com:pasture.ttl .

com:pasture.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:pasture .

com:pasture.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:pasture .

com:pasture.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:pasture .

com:plantain skos:notation "plantain" .

com:sorghum_forage skos:notation "sorghum forage" .

com:turnips_forage skos:notation "turnips forage" .

com:yarrow skos:notation "yarrow" .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:pasture a skos:Collection ;
    skos:inScheme lus:commodities ;
    skos:member com:clover,
        com:lucerne,
        com:plantain,
        com:sorghum_forage,
        com:turnips_forage,
        com:yarrow ;
    skos:prefLabel "Pasture"@en ;
    foaf:isPrimaryTopicOf com:pasture.html .

