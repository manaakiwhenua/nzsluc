@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:pears ;
    skos:prefLabel "Fruit"@en .

com:pears.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:pears.jsonld,
        com:pears.rdf,
        com:pears.ttl .

com:pears.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:pears .

com:pears.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:pears .

com:pears.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:pears .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:pears a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "pears" ;
    foaf:isPrimaryTopicOf com:pears.html .

