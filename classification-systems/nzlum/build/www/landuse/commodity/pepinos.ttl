@prefix com: <https://nzlum.landcareresearch.co.nz/landuse/commodity/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

com:fruit skos:member com:pepinos ;
    skos:prefLabel "Fruit"@en .

com:pepinos.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat com:pepinos.jsonld,
        com:pepinos.rdf,
        com:pepinos.ttl .

com:pepinos.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic com:pepinos .

com:pepinos.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic com:pepinos .

com:pepinos.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic com:pepinos .

lus:commodities dcterms:title "NZLUM commodities"@en .

com:pepinos a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "pepinos" ;
    foaf:isPrimaryTopicOf com:pepinos.html .

