      "skos:prefLabel": {
        "@language": "en",
        "@value": "Grazing"
      }
    },
    {
      "@id": "mgmt:grazing_rotational",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Moving livestock between paddocks in regular sequence to permit the recovery and growth of the pasture plants after grazing."
      },
      "skos:inScheme": {
        "@id": "lus:management_practices"
      },
      "skos:notation": "grazing rotational",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Also cell grazing."
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Stocking rates per paddock are higher than under set stocking."
      }
    },
    {
      "@id": "mgmt:grazing_set_stocking",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "lus:management_practices"
      },
      "skos:notation": "grazing set stocking"
    },
    {
      "@id": "mgmt:grazing_tactical",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "lus:management_practices"
      },
      "skos:notation": "grazing tactical"
    },
