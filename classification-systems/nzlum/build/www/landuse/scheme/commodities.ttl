com:animals a skos:Collection ;
    skos:inScheme lus:commodities ;
    skos:member com:bees,
        com:cats,
        com:cattle,
        com:cattle_dairy,
        com:cattle_meat,
        com:cattle_stud,
        com:chickens,
        com:chickens_eggs,
        com:chickens_meat,
        com:crocodiles,
        com:crustaceans,
        com:deer,
        com:dogs,
        com:ducks,
        com:emus,
        com:finfish,
        com:geese,
        com:goats,
