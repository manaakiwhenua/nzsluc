lus:commodities.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat lus:commodities.jsonld,
        lus:commodities.rdf,
        lus:commodities.ttl .

lus:commodities.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic lus:commodities .

lus:commodities.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic lus:commodities .

lus:commodities.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic lus:commodities .

