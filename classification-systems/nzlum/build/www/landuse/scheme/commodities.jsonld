    {
      "@id": "com:carbon_forest_permanent",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Permanent carbon forestry under the ETS. These are post-1989 forests that will not be clear-felled. They are expected to remain in permanent forestry for at least 50 years. Before 1 January 2023, the ETS didn't distinguish between standard and permanent forestry. Post-1989 forest land that entered the ETS before 1 January 2023 is standard forestry, unless an application has been accepted to change it to permanent forestry."
      },
      "skos:inScheme": {
        "@id": "lus:commodities"
      },
      "skos:notation": "carbon forest permanent"
    },
    {
      "@id": "com:carbon_forest_standard",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Standard carbon foresty under the ETS. Standard forestry refers to post-1989 forests under the ETS that are expected to be regularly harvested and replanted, such as commercial plantation forests. Other commodities (such as sawlog) are compatible."
      },
      "skos:inScheme": {
        "@id": "lus:commodities"
      },
      "skos:notation": "carbon forest standard"
    },
