  <skos:Collection rdf:about="https://nzlum.landcareresearch.co.nz/landuse/management_practice/grazing">
    <skos:member>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/management_practice/grazing_rotational">
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/management_practices"/>
        <skos:definition xml:lang="en">Moving livestock between paddocks in regular sequence to permit the recovery and growth of the pasture plants after grazing.</skos:definition>
        <skos:notation>grazing rotational</skos:notation>
        <skos:usageNote xml:lang="en">Stocking rates per paddock are higher than under set stocking.</skos:usageNote>
        <skos:scopeNote xml:lang="en">Also cell grazing.</skos:scopeNote>
      </skos:Concept>
    </skos:member>
    <skos:member>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/management_practice/grazing_set_stocking">
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/management_practices"/>
        <skos:notation>grazing set stocking</skos:notation>
      </skos:Concept>
    </skos:member>
    <skos:member>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/management_practice/grazing_tactical">
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/management_practices"/>
        <skos:notation>grazing tactical</skos:notation>
      </skos:Concept>
    </skos:member>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/management_practices"/>
    <skos:prefLabel xml:lang="en">Grazing</skos:prefLabel>
  </skos:Collection>
  <skos:Collection rdf:about="https://nzlum.landcareresearch.co.nz/landuse/management_practice/irrigation">
    <skos:member>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/management_practice/irrigation_drip">
        <skos:definition xml:lang="en">Irrigation system that applies water to the soil very slowly through tubes/tapes either above or below the soil surface.</skos:definition>
        <skos:notation>irrigation drip</skos:notation>
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/management_practices"/>
        <skos:scopeNote xml:lang="en">Also trickle irrigation.</skos:scopeNote>
      </skos:Concept>
    </skos:member>
    <skos:member>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/management_practice/irrigation_spray">
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/management_practices"/>
        <skos:scopeNote xml:lang="en">Sprinklers including set systems, permanent (solid set/fixed), continuous/travelling systems and micro-sprinklers.</skos:scopeNote>
        <skos:definition xml:lang="en">Irrigation system that sprays water into the air allowing it to fall on the plants and soil much like natural rainfall.</skos:definition>
        <skos:notation>irrigation spray</skos:notation>
      </skos:Concept>
    </skos:member>
    <skos:member>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/management_practice/irrigation_surface">
        <skos:scopeNote xml:lang="en">Also flood/furrow irrigation.</skos:scopeNote>
        <skos:notation>irrigation surface</skos:notation>
        <skos:definition xml:lang="en">Water is applied to the land by allowing it to flow by simple gravity before infiltrating. Under furrow irrigation, small parallel channels carry water to irrigate the crop with the crop usually grown on the ridges between the furrows.</skos:definition>
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/management_practices"/>
      </skos:Concept>
    </skos:member>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/management_practices"/>
    <skos:prefLabel xml:lang="en">Irrigation</skos:prefLabel>
  </skos:Collection>
