@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu_proverb: <https://nzlum.landcareresearch.co.nz/landuse/doc/proverb/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

lus:nzlum.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat lus:nzlum.jsonld,
        lus:nzlum.rdf,
        lus:nzlum.ttl .

lus:nzlum.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic lus:nzlum .

lus:nzlum.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic lus:nzlum .

lus:nzlum.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic lus:nzlum .

lus:nzlum0.3.0 dcterms:isVersionOf lus:nzlum .

lus:nzlum0.4.0 dcterms:isVersionOf lus:nzlum .

lus:nzlum a skos:ConceptScheme ;
    dcterms:hasVersion lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    dcterms:relation lu_proverb:kotahi_te_aho ;
    dcterms:title "New Zealand Land Use and Management classification system"@en ;
    doap:repository [ a doap:GitRepository ;
            doap:browse <https://github.com/manaakiwhenua/nzsluc> ] ;
    foaf:homepage <https://nzlum.landcareresearch.co.nz/> ;
    foaf:isPrimaryTopicOf lus:nzlum.html .

