        <skos:notation>eucalyptus oil</skos:notation>
      </skos:Concept>
    </skos:member>
    <skos:prefLabel xml:lang="en">Forest</skos:prefLabel>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/commodities"/>
