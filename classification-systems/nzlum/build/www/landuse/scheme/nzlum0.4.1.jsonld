  "@graph": [
    {
      "@id": "lu:colour",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Authoritative colour assigned to this concept for cartographic representation, given as a hex RGB triplet (e.g. \"#7F6DF2\"). Optional; absence means no colour has been assigned."
      },
      "rdfs:domain": {
        "@id": "skos:Concept"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "colour"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "lu_person:kingi_tawhiao",
      "@type": "foaf:Person",
      "foaf:name": [
        {
          "@language": "mi",
          "@value": "Tūkaroto Matutaera Pōtatau Te Wherowhero Tāwhiao"
        },
        {
          "@language": "mi",
          "@value": "Kīngi Tāwhiao"
        }
      ]
    },
    {
      "@id": "lu_proverb:kotahi_te_aho",
      "@type": "dcterms:BibliographicResource",
      "dcterms:creator": {
        "@id": "lu_person:kingi_tawhiao"
      },
      "dcterms:description": [
        {
          "@language": "mi",
          "@value": "Kotahi te aho ka whati, ki te kāpuia e kore e whati."
        },
        {
          "@language": "en",
          "@value": "One strand of flax is easy to break, but many strands together will stand strong."
        }
      ]
    },
    {
      "@id": "lu_status:draft",
      "@type": "rdfs:Resource",
      "rdfs:label": {
        "@language": "en",
        "@value": "Draft"
      }
    },
    {
      "@id": "lu_status:published",
      "@type": "rdfs:Resource",
      "rdfs:label": {
        "@language": "en",
        "@value": "Published"
      }
    },
    {
      "@id": "lu_status:superseded",
      "@type": "rdfs:Resource",
      "rdfs:label": {
        "@language": "en",
        "@value": "Superseded"
      }
    },
    {
      "@id": "luc:abandoned_land_ag",
      "@type": "skos:Concept",
      "lu:colour": "#CADCD0",
      "skos:broader": {
        "@id": "luc:vacant_and_transitioning_land"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "Changed notation at v0.4.0"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land where a previous pattern of agriculture may be observed but that is not currently under production, but not due to physical land degradation."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.8.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Abandoned land"
      }
    },
    {
      "@id": "luc:abattoirs",
      "@type": "skos:Concept",
      "lu:colour": "#BBBDCE",
      "skos:broader": {
        "@id": "luc:manufacturing_industrial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Areas with specialised improvements for the slaughter of stock and the preparation of meat for the wholesale market."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.4.6",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Abattoirs"
      }
    },
    {
      "@id": "luc:airports_aerodromes",
      "@type": "skos:Concept",
      "lu:colour": "#75777E",
      "skos:broader": {
        "@id": "luc:transport"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Locations from which aircraft flight operations take place, including areas used for the accommodation of aircraft and coordination of air cargo or passengers (including heliports)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.6.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Airports/aerodromes"
      }
    },
    {
      "@id": "luc:aquaculture",
      "@type": "skos:Concept",
      "lu:colour": "#F5C0B2",
      "skos:broader": {
        "@id": "luc:intensive_animal_production"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Controlled cultivation of aquatic organisms (e.g. fish, molluscs, algae) in natural or artificial environments, typically for food production, but also for stock feeds, pharmaceutical uses, biofuels, etc."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.6.5",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Aquaculture"
      }
    },
    {
      "@id": "luc:arable_cropping",
      "@type": "skos:Concept",
      "lu:colour": "#A98734",
      "skos:broader": {
        "@id": "luc:short_rotation_seasonal_cropping"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Predominantly grain, seed, or fodder crops (and over time may include vegetable rotations). May be used for dairy support."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.3.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Arable cropping"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "The specific commodity or commodities should be noted if known."
      }
    },
    {
      "@id": "luc:arable_mixed_livestock_cropping",
      "@type": "skos:Concept",
      "lu:colour": "#C6A14D",
      "skos:broader": {
        "@id": "luc:short_rotation_seasonal_cropping"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Predominantly grain, seed, or fodder crops; over time it may include short-term (c. 1–3 years) pasture and livestock rotations, and/or vegetable rotations. Pasture and livestock rotations may occur less than 50% of the time.."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.3.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Arable and mixed livestock cropping"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Includes maize, barley, wheat, peas, other grain and seed crops, and fodder crops. May be used for dairy support (which should be recorded as a management practice, if this is known)."
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "The specific commodity or commodities should be noted if known."
      }
    },
    {
      "@id": "luc:brownfield_development",
      "@type": "skos:Concept",
      "lu:colour": "#87636E",
      "skos:broader": {
        "@id": "luc:vacant_transitioning_land_urban"
      },
      "skos:changeNote": "Notation changed from 3.9.3 to 3.9.1 at v0.4.0",
      "skos:definition": {
        "@language": "en",
        "@value": "Areas of active redevelopment of previously developed (often industrial) land that may be abandoned, contaminated, or under-utilised, to rehabilitate and repurpose sites for new urban activities."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.9.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Brownfield development"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "May include residential areas undergoing infill development that increase housing density."
      }
    },
    {
      "@id": "luc:built_environment",
      "@type": "skos:Concept",
      "lu:colour": "#8E7A78",
      "skos:definition": {
        "@language": "en",
        "@value": "Land uses that involve high levels of interference with natural processes, generally in association with the built environment of closer settlement and supporting infrastructure. The level of intervention may be high enough to completely remodel the natural landscape – the vegetation, surface and groundwater systems, and land surface."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:commercial"
        },
        {
          "@id": "luc:manufacturing_industrial"
        },
        {
          "@id": "luc:mining"
        },
        {
          "@id": "luc:public_recreation_services"
        },
        {
          "@id": "luc:residential"
        },
        {
          "@id": "luc:transport"
        },
        {
          "@id": "luc:utilities"
        },
        {
          "@id": "luc:vacant_transitioning_land_urban"
        },
        {
          "@id": "luc:waste_treatment_disposal"
        }
      ],
      "skos:notation": "3.0.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Built environment"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Active outdoor recreation and/or tourism outside of urban areas that is not captured in other land-use categories may be captured under 3.2.1 Outdoor recreation, though may still retain much natural character."
      },
      "skos:topConceptOf": {
        "@id": "lus:nzlum0.4.1"
      }
    },
    {
      "@id": "luc:carbon_forest_retained",
      "@type": "skos:Concept",
      "lu:colour": "#2E5E4B",
      "skos:broader": {
        "@id": "luc:minimal_use_relatively_natural"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Retained (non-planted) indigenous vegetation set aside for carbon credits."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.3.8",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Carbon forest"
      }
    },
    {
      "@id": "luc:commercial",
      "@type": "skos:Concept",
      "lu:colour": "#6E94BA",
      "skos:broader": {
        "@id": "luc:built_environment"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land in a built environment context used for private-sector economic activities, including retail, office, hospitality, entertainment, healthcare, transportation, and warehousing."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:entertainment"
        },
        {
          "@id": "luc:healthcare"
        },
        {
          "@id": "luc:hospitality"
        },
        {
          "@id": "luc:office"
        },
        {
          "@id": "luc:retail"
        },
        {
          "@id": "luc:transportation_warehousing_commercial"
        }
      ],
      "skos:notation": "3.3.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Commercial"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Central government offices when these are privately rented should be captured in this category, even if they are public-facing."
      }
    },
    {
      "@id": "luc:community_services",
      "@type": "skos:Concept",
      "lu:colour": "#E09962",
      "skos:broader": {
        "@id": "luc:public_recreation_services"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land used for providing essential services and facilities to support the local community."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Educational institutions, public healthcare facilities, libraries, museums, courts, prisons, civic buildings, emergency services, marae, religious buildings, cemeteries."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.2.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Community services"
      }
    },
    {
      "@id": "luc:conservation",
      "@type": "skos:Concept",
      "lu:colour": "#7B6DB5",
      "skos:definition": {
        "@language": "en",
        "@value": "Land that has a relatively low level of human intervention. The land may be formally reserved by government for conservation purposes, or conserved through other legal or administrative arrangements. Areas may have multiple uses but nature conservation is a central consideration. (Some land may be unused because of a deliberate decision of the government or landowner, or due to circumstances)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:cultural_natural_heritage"
        },
        {
          "@id": "luc:minimal_use_relatively_natural"
        },
        {
          "@id": "luc:nature_cons"
        },
        {
          "@id": "luc:unused_and_transitioning"
        }
      ],
      "skos:notation": "1.0.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Conservation and Minimal Use"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Areas with lower levels of biodiversity protection are anticipated to have other primary uses, but biodiversity protection ranking could be captured as an ancillary use with class 1.1.4 and 1.1.5."
      },
      "skos:topConceptOf": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Where a classification is based on information about legal protection, the relevant information (e.g. the Act) should be mentioned in the `comment` field."
      }
    },
    {
      "@id": "luc:cultural_heritage",
      "@type": "skos:Concept",
      "lu:colour": "#AD2D4A",
      "skos:broader": {
        "@id": "luc:cultural_natural_heritage"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Cultural heritage areas (e.g. historical mining sites, selected DOC 'iconic sites', Toru Whenua and other cultural landmarks)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.2.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Cultural heritage"
      }
    },
    {
      "@id": "luc:cultural_natural_heritage",
      "@type": "skos:Concept",
      "lu:colour": "#AD2D4A",
      "skos:broader": {
        "@id": "luc:conservation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Conservation classes are for purposes other than biodiversity protecton."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:cultural_heritage"
        },
        {
          "@id": "luc:indigenous_cultural_heritage"
        },
        {
          "@id": "luc:natural_heritage"
        }
      ],
      "skos:notation": "1.2.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Cultural and natural heritage"
      }
    },
    {
      "@id": "luc:customary_use",
      "@type": "skos:Concept",
      "lu:colour": "#A36B2E",
      "skos:broader": {
        "@id": "luc:minimal_use_relatively_natural"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Natural environments associated with traditional and sustainable Indigenous food-gathering practices (mahinga kai)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.3.5",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Customary use"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "This may include land zoned for Māori purposes, and should only describe contemporary, not historical, use."
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "This is often an ancillary use; assign only if customary use is the prime use of the land."
      }
    },
    {
      "@id": "luc:dairy",
      "@type": "skos:Concept",
      "lu:colour": "#5D8144",
      "skos:broader": {
        "@id": "luc:grazing_modified_pasture_systems"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land on which milking cows (or other stock, such as goats or sheep) are grazed during the milking season, where dairy is the primary purpose of the land."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.2.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Dairy"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "Dairy production systems can include rotations of grazed forage crops and maize for silage, and dry-stock grazing, but this class should only be used where dairy is the primary purpose of the land."
        },
        {
          "@language": "en",
          "@value": "Where the land is permanently used for dry-stock grazing, it should be classified under dry-stock land use."
        }
      ]
    },
    {
      "@id": "luc:defence_land_natural_areas",
      "@type": "skos:Concept",
      "lu:colour": "#FF9E17",
      "skos:broader": {
        "@id": "luc:minimal_use_relatively_natural"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Natural areas allocated to field training, weapons testing, and other field defence uses, predominantly in rural areas."
      },
      "skos:example": [
        {
          "@language": "en",
          "@value": "Kaipara Air Weapons Range"
        },
        {
          "@language": "en",
          "@value": "Waiouru Military Camp"
        }
      ],
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.3.6",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Defence land"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Areas associated with buildings or more built environments on defence land are captured under an urban class."
      }
    },
    {
      "@id": "luc:degraded_land_ag",
      "@type": "skos:Concept",
      "lu:colour": "#94A599",
      "skos:broader": {
        "@id": "luc:vacant_and_transitioning_land"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "Changed notation at v0.4.0"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Unused land that is degraded through erosion or flood events that is not being rehabilitated."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.8.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Degraded land"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Can include contaminated land."
      }
    },
    {
      "@id": "luc:effluent_pond",
      "@type": "skos:Concept",
      "lu:colour": "#205351",
      "skos:broader": {
        "@id": "luc:water_wastewater_agriculture"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Effluent ponds typically associated with dairying."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.7.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Effluent pond"
      }
    },
    {
      "@id": "luc:electricity_substations_transmission",
      "@type": "skos:Concept",
      "lu:colour": "#955085",
      "skos:broader": {
        "@id": "luc:utilities"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Facilities and infrastructure associated with distribution and transmission of electrical power."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Substations, transformers, high-voltage transmission towers."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.5.5",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Electricity substations and transmission"
      }
    },
    {
      "@id": "luc:entertainment",
      "@type": "skos:Concept",
      "lu:colour": "#89AFD6",
      "skos:broader": {
        "@id": "luc:commercial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land areas and facilities offering leisure and recreational activities for public enjoyment."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Cinemas, theatres, amusement parks, casinos, concert venues."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.3.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Entertainment"
      }
    },
    {
      "@id": "luc:environmental_infrastructure_protection",
      "@type": "skos:Concept",
      "lu:colour": "#FBB979",
      "skos:broader": {
        "@id": "luc:minimal_use_relatively_natural"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land, usually under vegetative cover, used for non-production or environmental purposes (e.g. prevention of land degradation, windbreaks, shade, shelter). Includes land with a primary purpose of flood management (e.g. stop banks, spillways)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.3.7",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Environmental & infrastructure protection"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "This is not limited to indigenous vegetation."
        },
        {
          "@language": "en",
          "@value": "Land planted for environmental and infrastructure protection should be captured under 2.1.4."
        }
      ]
    },
    {
      "@id": "luc:evaporation_basins",
      "@type": "skos:Concept",
      "lu:colour": "#FCD7A5",
      "skos:broader": {
        "@id": "luc:mining"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Basins and associated facilities used for evaporation of water from irrigation drainage or (predominantly) salt extraction."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.7.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Evaporation basins"
      }
    },
    {
      "@id": "luc:exotic_plantation_forestry",
      "@type": "skos:Concept",
      "lu:colour": "#0F3D1A",
      "skos:broader": {
        "@id": "luc:plantation_forests"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "Consideration of carbon sequestration and carbon credits were added in NZLUM v0.4.0"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area managed for pulpwood or saw-log production, or for carbon sequestration and carbon credits (exotic species)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.1.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Exotic plantation forestry"
      },
      "skos:usageNote": [
        {
          "@language": "en",
          "@value": "The specific commodity or commodities should be noted if known."
        },
        {
          "@language": "en",
          "@value": "Specific additional attributes that could be captured in comments or supplementary attributes are plantation age, rotation number, and species."
        }
      ]
    },
    {
      "@id": "luc:extensive_dry_stock",
      "@type": "skos:Concept",
      "lu:colour": "#91B675",
      "skos:broader": {
        "@id": "luc:grazing_modified_pasture_systems"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Grazing on modified pastures with relatively fewer inputs, lower likelihood of irrigation, and lower stocking rates; more likely on hill, hard-hill, or high-country terrain."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.2.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Extensive dry stock"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "Where there is a high proportion of indigenous vegetation for grazing land, land use should be classified as grazing native vegetation."
        },
        {
          "@language": "en",
          "@value": "Arable or winter forage crops are unlikely to be common rotations in this land-use category"
        },
        {
          "@language": "en",
          "@value": "Grazing livestock other than dairy, sheep or beef should usually be captured in this class (though it does not exclude sheep or beef)"
        }
      ],
      "skos:usageNote": {
        "@language": "en",
        "@value": "The specific commodity or commodities should be noted if known."
      }
    },
    {
      "@id": "luc:extractive_industry_not_in_use",
      "@type": "skos:Concept",
      "lu:colour": "#D7B383",
      "skos:broader": {
        "@id": "luc:mining"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land undergoing rehabilitation after mining activities, and unmined land within a mining permit."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.7.5",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Extractive industry not in use"
      }
    },
    {
      "@id": "luc:farm_buildings_infrastructure",
      "@type": "skos:Concept",
      "lu:colour": "#E2E4F6",
      "skos:broader": {
        "@id": "luc:manufacturing_industrial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area with buildings, sheds, and other infrastructure associated with farm enterprises supporting agricultural operations."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Barns, silos, storage sheds, and irrigation systems."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.4.5",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Farm buildings/infrastructure"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "If it is possible to discriminate a domestic area from a farm, the house and adjoining non-productive land should be classified as 3.1.4 Rural residential."
      }
    },
    {
      "@id": "luc:food_processing_factory",
      "@type": "skos:Concept",
      "lu:colour": "#CED1E2",
      "skos:broader": {
        "@id": "luc:manufacturing_industrial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area where the principal use is food processing, packaging, and preservation. The building is most likely to be purpose built and may have extensive plant and equipment included."
      },
      "skos:example": "Cannery; milk production plant.",
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.4.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Food processing factory"
      }
    },
    {
      "@id": "luc:fuel_powered_electricity_generation",
      "@type": "skos:Concept",
      "lu:colour": "#7652A3",
      "skos:broader": {
        "@id": "luc:utilities"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Facilities that produce electricity by burning fossil fuels such as coal, oil, and natural gas."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.5.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Fuel powered electricity generation"
      }
    },
    {
      "@id": "luc:gas_treatment_storage_transmission",
      "@type": "skos:Concept",
      "lu:colour": "#B36CA2",
      "skos:broader": {
        "@id": "luc:utilities"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Facilities and infrastructure for processing, storage, and transport of natural gas."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Treatment plants, storage facilities, pipelines."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.5.6",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Gas treatment, storage, and transmission"
      }
    },
    {
      "@id": "luc:general_purpose_factory",
      "@type": "skos:Concept",
      "lu:colour": "#9598A8",
      "skos:broader": {
        "@id": "luc:manufacturing_industrial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area used for manufacturing, assembly, or repairs of various products."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.4.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "General purpose factory"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Includes some specialised or purpose-built machinery and equipment for mass production across multiple industries."
      }
    },
    {
      "@id": "luc:glasshouses_shadehouses",
      "@type": "skos:Concept",
      "lu:colour": "#797346",
      "skos:broader": {
        "@id": "luc:intensive_horticulture"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Controlled-environment structures for protected cultivation of plants, including vegetable and floriculture production."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.5.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Glasshouses/shadehouses"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Glasshouses provide a transparent enclosure, typically made of glass or plastic, allowing natural sunlight to penetrate while shielding plants from adverse weather conditions. Shadehouses utilise shade cloth or netting to regulate light exposure and temperature levels. These structures enable year-round production of a wide variety of crops, including vegetables, herbs, flowers, and ornamental plants."
      }
    },
    {
      "@id": "luc:grazing_modified_pasture_systems",
      "@type": "skos:Concept",
      "lu:colour": "#769B5C",
      "skos:broader": {
        "@id": "luc:production_agriculture_plantations"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Grazing pasture and/or forage systems based on significant active modification or replacement of the natural vegetation."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:dairy"
        },
        {
          "@id": "luc:extensive_dry_stock"
        },
        {
          "@id": "luc:intensive_dry_stock"
        }
      ],
      "skos:notation": "2.2.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Grazing modified pasture systems"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "Land under pasture at the time of mapping may be in a rotation system, so that at another time the same area may be, for example, under cropping."
        },
        {
          "@language": "en",
          "@value": "Dairy support is land that is used to support non-lactating dairy stock (dry cows, heifers and calves). It will include any feed required, and will often include winter crops and potentially summer crops (location/irrigation dependent), along with cereal crops, such as maize, barley, and wheat. It can also include feed that is cut and carried to the milking platform. Dairy support land that is not actively used for grazing should be classified as an arable use."
        }
      ],
      "skos:usageNote": {
        "@language": "en",
        "@value": "The ability to distinguish between dairy and dry-stock production is provided by including the relevant commodity information, such as `cattle dairy`, `cattle beef`, `sheep wool`, `sheep meat`, etc. Multiple commodities should be recorded if appropriate. Crops used in rotation should also be recorded as commodities, if known."
      }
    },
    {
      "@id": "luc:grazing_native_vegetation",
      "@type": "skos:Concept",
      "lu:colour": "#FFD5B1",
      "skos:broader": {
        "@id": "luc:minimal_use_relatively_natural"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land uses based on grazing by domestic stock on native vegetation where there has been limited or no deliberate attempt at pasture modification (e.g. native tussock grazing). Some change in species composition may have occurred."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.3.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Grazing native vegetation"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "This is probably limited to South Island high-country farms. Verification (e.g. assessment of vegetation on grazed land) to assess the extent of modification is required. ALUM specifies this class when there is greater than 50% dominant native species, although this criterion needs to be confirmed as being appropriate in a New Zealand context."
      }
    },
    {
      "@id": "luc:greenfield_development",
      "@type": "skos:Concept",
      "lu:colour": "#AC8792",
      "skos:broader": {
        "@id": "luc:vacant_transitioning_land_urban"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Previously undeveloped or agricultural land zoned for or undergoing new construction projects or urban expansion, involving conversion of rural or natural areas into built uses."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.9.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Greenfield development"
      }
    },
    {
      "@id": "luc:ground_water",
      "@type": "skos:Concept",
      "lu:colour": "#79AB96",
      "skos:broader": {
        "@id": "luc:minimal_use_relatively_natural"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area managed as an aquifer recharge zone."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.3.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ground water"
      }
    },
    {
      "@id": "luc:habitat_or_species_management",
      "@type": "skos:Concept",
      "dcterms:source": {
        "@language": "en",
        "@value": "IUCN (2008) Protected Areas Management Categories, Category IV: Habitat/Species Management Area."
      },
      "lu:colour": "#9E9AC8",
      "skos:broader": {
        "@id": "luc:nature_cons"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Protected area managed mainly for conservation through management intervention. An area of land or sea subject to active intervention for management purposes to ensure the maintenance of habitats or to meet the requirements of specific species. This may include areas on private land."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.1.5",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Habitat or species management area"
      }
    },
    {
      "@id": "luc:healthcare",
      "@type": "skos:Concept",
      "lu:colour": "#D0E5FC",
      "skos:broader": {
        "@id": "luc:commercial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land dedicated to providing private medical services aimed at diagnosis, treatment, and prevention of illness or injury."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Hospitals, specialist clinics, physiotherapists, medical offices, laboratories"
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.3.5",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Healthcare"
      }
    },
    {
      "@id": "luc:high_density_residential",
      "@type": "skos:Concept",
      "lu:colour": "#4C3B39",
      "skos:broader": {
        "@id": "luc:residential"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Areas characterised by a high concentration of housing units per unit of land area, typically in multi-storey buildings or high-rise developments, often found in urban centres supporting high population density."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.1.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "High-density residential"
      }
    },
    {
      "@id": "luc:horse_studs",
      "@type": "skos:Concept",
      "lu:colour": "#DDAA9D",
      "skos:broader": {
        "@id": "luc:intensive_animal_production"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Establishments focused on the breeding and raising of horses."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.6.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Horse studs"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Applies to the intensive part of horse studs; relatively more extensive and pastoral aspects are not included."
      }
    },
    {
      "@id": "luc:hospitality",
      "@type": "skos:Concept",
      "lu:colour": "#A4CAF2",
      "skos:broader": {
        "@id": "luc:commercial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land and buildings providing accommodation, food, and beverage services to the public."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Hotels, motels, resorts, bed and breakfast establishments, restaurants, bars, nightclubs."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.3.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Hospitality"
      }
    },
    {
      "@id": "luc:hydroelectricity_generation",
      "@type": "skos:Concept",
      "lu:colour": "#9670C4",
      "skos:broader": {
        "@id": "luc:utilities"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Facilities that use the energy of flowing or falling water (typically hydroelectric dams) to generate electricity."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.5.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Hydroelectricity generation"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Includes canals and other water conveyance infrastructure associated with hydroelectricity generation."
      }
    },
    {
      "@id": "luc:indigenous_cultural_heritage",
      "@type": "skos:Concept",
      "lu:colour": "#870330",
      "skos:broader": {
        "@id": "luc:cultural_natural_heritage"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Indigenous cultural heritage sites and areas (e.g. historical pā sites, New Zealand land wars sites, and other indigenous heritage sites)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.2.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Indigenous cultural heritage"
      }
    },
    {
      "@id": "luc:indigenous_plantation_forestry",
      "@type": "skos:Concept",
      "lu:colour": "#23502B",
      "skos:broader": {
        "@id": "luc:plantation_forests"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "Consideration of carbon sequestration and carbon credits were added in NZLUM v0.4.0"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area managed for pulpwood or saw-log production, or for carbon sequestration and carbon credits (native species)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.1.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Indigenous plantation forestry"
      },
      "skos:usageNote": [
        {
          "@language": "en",
          "@value": "The specific commodity or commodities should be noted if known."
        },
        {
          "@language": "en",
          "@value": "Specific additional attributes that could be captured in comments or supplementary attributes are plantation age, rotation number, and species."
        }
      ]
    },
    {
      "@id": "luc:indoor_recreation",
      "@type": "skos:Concept",
      "lu:colour": "#958273",
      "skos:broader": {
        "@id": "luc:public_recreation_services"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Facilities designed for recreational activities conducted within enclosed or semi-enclosed structures."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Sports centres, gyms, swimming pools, indoor arenas."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.2.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Indoor recreation"
      }
    },
    {
      "@id": "luc:intensive_animal_containment",
      "@type": "skos:Concept",
      "lu:colour": "#9A6C60",
      "skos:broader": {
        "@id": "luc:intensive_animal_production"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Facilities or systems designed to confine and manage animals, including feed lots, pens, dairy sheds and yards, and herd homes, where animals are raised intensively for meat production or other purposes."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.6.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Intensive animal containment"
      }
    },
    {
      "@id": "luc:intensive_animal_production",
      "@type": "skos:Concept",
      "lu:colour": "#C79588",
      "skos:broader": {
        "@id": "luc:production_agriculture_plantations"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Intensive forms of non-pastoral animal production, livestock production facilities, or animal-holding yards."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:aquaculture"
        },
        {
          "@id": "luc:horse_studs"
        },
        {
          "@id": "luc:intensive_animal_containment"
        },
        {
          "@id": "luc:piggeries"
        },
        {
          "@id": "luc:poultry_farms"
        }
      ],
      "skos:notation": "2.6.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Intensive animal production"
      },
      "skos:usageNote": [
        {
          "@language": "en",
          "@value": "The management field can be used to record practices such as free range or organic."
        },
        {
          "@language": "en",
          "@value": "Record animal types as commodities, if known."
        }
      ]
    },
    {
      "@id": "luc:intensive_dry_stock",
      "@type": "skos:Concept",
      "lu:colour": "#769B5C",
      "skos:broader": {
        "@id": "luc:grazing_modified_pasture_systems"
      },
      "skos:changeNote": [
        {
          "@id": "https://github.com/manaakiwhenua/nzsluc/issues/66"
        },
        {
          "@language": "en",
          "@value": "A prior definition of this classes treated deer, goats, and horses as extensive by definition; it is now recogised that such systems can also be intensive."
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Non-milking platform grazing land with higher inputs (e.g. fertiliser), higher likelihood of irrigation, and higher stocking rates; typically on flat or rolling terrain."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.2.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Intensive dry stock"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Land used for high-intensity dry-stock grazing may include rotations for arable or winter forage crops, as well as grazing of non-lactating (dry) dairy cattle, beef cattle, sheep, and cattle breeding."
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Stock density is an ideal attribute to assist in classification of intensive vs extensive dry stock; physiography (i.e. flat/hill/high country) can be used as a proxy where stock density data is absent."
      }
    },
    {
      "@id": "luc:intensive_horticulture",
      "@type": "skos:Concept",
      "lu:colour": "#4A4C39",
      "skos:broader": {
        "@id": "luc:production_agriculture_plantations"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Intensive forms of plant production, often with special-purpose improvements used for horticultural production."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:glasshouses_shadehouses"
        },
        {
          "@id": "luc:production_nurseries"
        }
      ],
      "skos:notation": "2.5.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Intensive horticulture"
      },
      "skos:usageNote": [
        {
          "@language": "en",
          "@value": "Record management practices such as hydroponic systems, irrigation, and netting, if known."
        },
        {
          "@language": "en",
          "@value": "The specific commodity or commodities should be noted if known."
        }
      ]
    },
    {
      "@id": "luc:irrigation_reservoirs_canals",
      "@type": "skos:Concept",
      "lu:colour": "#86BAB7",
      "skos:broader": {
        "@id": "luc:water_wastewater_agriculture"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land used for water storage, management, or distribution intended for agricultural purposes; areas allocated for irrigation for agricultural purposes."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.7.5",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Irrigation reservoirs and canals"
      }
    },
    {
      "@id": "luc:landfills",
      "@type": "skos:Concept",
      "lu:colour": "#AC3F25",
      "skos:broader": {
        "@id": "luc:waste_treatment_disposal"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Designated areas for disposal of solid waste, where waste materials are deposited, compacted, and covered to reduce contamination and control emissions."
      },
      "skos:example": "Landfills designed to receive inert construction materials.",
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.8.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Landfills"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "Landfill gas recovery systems are classified as part of a landfill land use."
        },
        {
          "@language": "en",
          "@value": "Includes all class 1 to 5 landfills"
        }
      ]
    },
    {
      "@id": "luc:low_density_residential",
      "@type": "skos:Concept",
      "lu:colour": "#815E5B",
      "skos:broader": {
        "@id": "luc:residential"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Residential properties within urban boundaries that fall within large-lot or low-density residential zones and are often single-family, one- to two- storey houses with yards and landscaping and lower population density."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.1.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Low-density residential"
      }
    },
    {
      "@id": "luc:major_industrial_complex",
      "@type": "skos:Concept",
      "lu:colour": "#838695",
      "skos:broader": {
        "@id": "luc:manufacturing_industrial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area with large-scale industrial use and significant infrastructure ."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Car plant, paper mill."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.4.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Major industrial complex"
      }
    },
    {
      "@id": "luc:manufacturing_industrial",
      "@type": "skos:Concept",
      "lu:colour": "#9598A8",
      "skos:broader": {
        "@id": "luc:built_environment"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land uses dedicated to production, processing, and industrial activities, contributing to the production of goods and materials for commercial purposes."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:abattoirs"
        },
        {
          "@id": "luc:farm_buildings_infrastructure"
        },
        {
          "@id": "luc:food_processing_factory"
        },
        {
          "@id": "luc:general_purpose_factory"
        },
        {
          "@id": "luc:major_industrial_complex"
        },
        {
          "@id": "luc:sawmill"
        }
      ],
      "skos:notation": "3.4.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Manufacturing and industrial"
      }
    },
    {
      "@id": "luc:medium_density_residential",
      "@type": "skos:Concept",
      "lu:colour": "#644E4C",
      "skos:broader": {
        "@id": "luc:residential"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Areas featuring a moderate concentration of housing units per unit of land area, often in suburban or semi-urban settings."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Townhouses, terraced housing, low-rise apartments."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.1.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Medium-density residential"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Alignment to the Medium Density Residential Standards (MfE 2022) should be considered."
      }
    },
    {
      "@id": "luc:mines",
      "@type": "skos:Concept",
      "lu:colour": "#836639",
      "skos:broader": {
        "@id": "luc:mining"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land from which minerals, precious stones or coal is being extracted, including open-cut and deep-shaft mines."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.7.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Mines"
      }
    },
    {
      "@id": "luc:minimal_use_relatively_natural",
      "@type": "skos:Concept",
      "lu:colour": "#FFC77A",
      "skos:broader": {
        "@id": "luc:conservation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "This class includes land that is subject to relatively low levels of intervention or that is largely unused in the context of prime use or use for resource protection. This land may be covered with indigenous or exotic plant species. It includes land where the structure of the native vegetation generally remains intact despite deliberate use, although the floristics of the vegetation may have changed markedly (e.g. grazing on native tussock land)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:carbon_forest_retained"
        },
        {
          "@id": "luc:customary_use"
        },
        {
          "@id": "luc:defence_land_natural_areas"
        },
        {
          "@id": "luc:environmental_infrastructure_protection"
        },
        {
          "@id": "luc:grazing_native_vegetation"
        },
        {
          "@id": "luc:ground_water"
        },
        {
          "@id": "luc:production_from_indigenous_vegetation"
        },
        {
          "@id": "luc:surface_water_supply"
        }
      ],
      "skos:notation": "1.3.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Minimal use from relatively natural environments"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Where native grasses have been deliberately and extensively replaced with other species, the land use should not be classified under class 1."
      }
    },
    {
      "@id": "luc:mining",
      "@type": "skos:Concept",
      "lu:colour": "#E1CEA7",
      "skos:broader": {
        "@id": "luc:built_environment"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Mining and extractive industries (including salt extraction from evaporation basins)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:evaporation_basins"
        },
        {
          "@id": "luc:extractive_industry_not_in_use"
        },
        {
          "@id": "luc:mines"
        },
        {
          "@id": "luc:quarries"
        },
        {
          "@id": "luc:tailings"
        }
      ],
      "skos:notation": "3.7.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Mining"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Record the specific type of mining activitiy in the commodity attribute, if known."
      }
    },
    {
      "@id": "luc:municipal_wastewater",
      "@type": "skos:Concept",
      "lu:colour": "#CB593B",
      "skos:broader": {
        "@id": "luc:waste_treatment_disposal"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Wastewater generated from residential, commercial, and industrial activities within urban areas requiring treatment before discharge or reuse; includes municipal wastewater ponds and sewerage pipelines."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.8.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Municipal wastewater"
      }
    },
    {
      "@id": "luc:national_park",
      "@type": "skos:Concept",
      "dcterms:source": {
        "@language": "en",
        "@value": "IUCN (2008) Protected Areas Management Categories, Category Ib: national park."
      },
      "lu:colour": "#6A51A3",
      "skos:broader": {
        "@id": "luc:nature_cons"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Protected area managed mainly for ecosystem conservation and recreation. A natural area of land, designated to:\n\n  a) protect the ecological integrity of one or more ecosystems for the current and future generations;\n\n  b) exclude exploitation or occupation detrimental to the purposes of designation of the area; and\n\n  c) provide a foundation for spiritual, scientific, educational, recreational and visitor opportunities, all of which must be environmentally and culturally compatible."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.1.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "National Park"
      }
    },
    {
      "@id": "luc:natural_feature_protection",
      "@type": "skos:Concept",
      "dcterms:source": {
        "@language": "en",
        "@value": "IUCN (2008) Protected Areas Management Categories, Category III: Natural Monument or Feature."
      },
      "lu:colour": "#807DBA",
      "skos:broader": {
        "@id": "luc:nature_cons"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Protected area managed for conservation of specific natural features. An area containing one or more specific natural or cultural features that are of outstanding value because of their inherent rarity, representative or aesthetic qualities, or cultural significance."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.1.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Natural feature protection"
      }
    },
    {
      "@id": "luc:natural_heritage",
      "@type": "skos:Concept",
      "lu:colour": "#DD5A70",
      "skos:broader": {
        "@id": "luc:cultural_natural_heritage"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Protected areas for the conservation of specific natural features and landscapes (e.g. UNESCO Global Geoparks)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.2.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Natural heritage"
      }
    },
    {
      "@id": "luc:nature_cons",
      "@type": "skos:Concept",
      "lu:colour": "#6A51A3",
      "skos:broader": {
        "@id": "luc:conservation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Nature conservation classes are determined by the classification scheme adopted for the Protected Areas Network of New Zealand (PAN-NZ)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:habitat_or_species_management"
        },
        {
          "@id": "luc:national_park"
        },
        {
          "@id": "luc:natural_feature_protection"
        },
        {
          "@id": "luc:other_conserved_area"
        },
        {
          "@id": "luc:protected_landscape"
        },
        {
          "@id": "luc:strict_nature_res"
        },
        {
          "@id": "luc:wilderness"
        }
      ],
      "skos:notation": "1.1.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Nature conservation"
      }
    },
    {
      "@id": "luc:navigation_communication",
      "@type": "skos:Concept",
      "lu:colour": "#F2A6DE",
      "skos:broader": {
        "@id": "luc:utilities"
      },
      "skos:changeNote": [
        {
          "@id": "https://github.com/manaakiwhenua/nzsluc/issues/69"
        },
        {
          "@language": "en",
          "@value": "Notation changed from 3.6.5 to 3.5.8 at v0.4.0 when class 3.6.0 redefined to exclude navigation and communication infrastructure."
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Navigation and communication infrastructure."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Radar stations, beacons, lighthouses, TV and radio transmission towers."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.5.8",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Navigation and communication"
      }
    },
    {
      "@id": "luc:no_defined_use_ag",
      "@type": "skos:Concept",
      "lu:colour": "#DBEDE0",
      "skos:broader": {
        "@id": "luc:vacant_and_transitioning_land"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "Changed notation at v0.4.0"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land cleared of vegetation where the current proposed land use is unknown."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Land being prepared for new primary production use (farms, mines, etc.) but where the precise nature of the proposed land use is unknown."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.8.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "No defined use"
      }
    },
    {
      "@id": "luc:office",
      "@type": "skos:Concept",
      "lu:colour": "#396285",
      "skos:broader": {
        "@id": "luc:commercial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land and buildings primarily used for administrative, professional, or managerial activities."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Corporate offices, professional services, banks, government buildings, business parks, coworking spaces."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.3.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Office"
      }
    },
    {
      "@id": "luc:other_conserved_area",
      "@type": "skos:Concept",
      "lu:colour": "#DADAEB",
      "skos:broader": {
        "@id": "luc:nature_cons"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land under forms of nature conservation protection that fall outside the scope of the CAPAD classification. This includes heritage agreements, voluntary conservation arrangements, registered property agreements, and recreation areas with primarily native cover ."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.1.7",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other conserved area"
      },
      "skos:scopeNote": "If the recreation area is primarily cleared or non-native cover assign to 3.2.1 ‘Outdoor recreation’"
    },
    {
      "@id": "luc:other_perennial_horticulture",
      "@type": "skos:Concept",
      "lu:colour": "#BBBEA0",
      "skos:broader": {
        "@id": "luc:perennial_horticulture"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Perennial plants beyond tree crops and vine fruits, such as berries (e.g. strawberries, blueberries), perennial herbs (e.g. lavender, rosemary), and ornamental perennials (e.g. roses, lilies)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.4.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other perennial horticulture"
      }
    },
    {
      "@id": "luc:other_production_plantations",
      "@type": "skos:Concept",
      "lu:colour": "#37633D",
      "skos:broader": {
        "@id": "luc:plantation_forests"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area managed for non-pulpwood production, including oil, wildflowers, and honey plantations."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.1.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other production uses"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "The specific commodity or commodities should be noted if known."
      }
    },
    {
      "@id": "luc:outdoor_recreation",
      "@type": "skos:Concept",
      "lu:colour": "#C19878",
      "skos:broader": {
        "@id": "luc:public_recreation_services"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land areas dedicated to leisure activities conducted in natural or semi-natural settings, typically with considerable unsealed vegetated areas."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Parks, trails, sportsgrounds, camping grounds, zoos, botanic gardens, recreational reserves."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.2.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Outdoor recreation"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "The specific identification of this land is intended to enable more ready identification of urban green space. However, this category may also be used to identify developed recreational areas that fall outside urban boundaries, such as mountain-bike parks."
        },
        {
          "@language": "en",
          "@value": "Parks or reserves with a high level of native bush or that are protected areas should be classified under class 1."
        }
      ]
    },
    {
      "@id": "luc:perennial_horticulture",
      "@type": "skos:Concept",
      "lu:colour": "#9EA083",
      "skos:broader": {
        "@id": "luc:production_agriculture_plantations"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Crop plants living for more than 2 years that are intensively cultivated, usually involving a relatively high degree of nutrient, weed, and moisture control."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:other_perennial_horticulture"
        },
        {
          "@id": "luc:tree_crops"
        },
        {
          "@id": "luc:vine_fruits"
        }
      ],
      "skos:notation": "2.4.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Perennial horticulture"
      },
      "skos:usageNote": [
        {
          "@language": "en",
          "@value": "Management practices such as irrigation or netting can be recorded as management practices."
        },
        {
          "@language": "en",
          "@value": "Crop type can be recorded as the commodity and used to identify key crops (e.g. kiwifruit, avocados, and grapes)."
        }
      ]
    },
    {
      "@id": "luc:piggeries",
      "@type": "skos:Concept",
      "lu:colour": "#B08074",
      "skos:broader": {
        "@id": "luc:intensive_animal_production"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Facilities designed for the intensive rearing of pigs."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.6.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Piggeries"
      }
    },
    {
      "@id": "luc:plantation_forests",
      "@type": "skos:Concept",
      "lu:colour": "#122112",
      "skos:broader": {
        "@id": "luc:production_agriculture_plantations"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land on which plantations of trees or shrubs (native or exotic species) have been established (i.e. planted) for production, or environmental and resource protection purposes, including carbon forestry."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:exotic_plantation_forestry"
        },
        {
          "@id": "luc:indigenous_plantation_forestry"
        },
        {
          "@id": "luc:other_production_plantations"
        },
        {
          "@id": "luc:planted_environmental_infrastructure_protection"
        }
      ],
      "skos:notation": "2.1.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Plantation forests"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "This includes farm forestry and may consist of monocultures or mixed species."
      }
    },
    {
      "@id": "luc:planted_environmental_infrastructure_protection",
      "@type": "skos:Concept",
      "lu:colour": "#4A774F",
      "skos:broader": {
        "@id": "luc:plantation_forests"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area managed for environmental and indirect production uses (e.g. prevention of land degradation, windbreaks, shade, and shelter) where trees or shrubs have been planted."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.1.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Planted environmental & infrastructure protection"
      }
    },
    {
      "@id": "luc:ports_water_transport",
      "@type": "skos:Concept",
      "lu:colour": "#61636A",
      "skos:broader": {
        "@id": "luc:transport"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Harbour locations where ships dock to transfer people or cargo, including terrestrial parts and designated marine areas that are specifically designated and controlled for activities associated with the port."
      },
      "skos:example": [
        {
          "@language": "en",
          "@value": "Harbours, navigational channels."
        },
        {
          "@language": "en",
          "@value": "Ports, docks, and wharves."
        }
      ],
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.6.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ports and water transport"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "The water attribute can be used to differentiate the terrestrial and marine parts of the same facility."
      }
    },
    {
      "@id": "luc:poultry_farms",
      "@type": "skos:Concept",
      "lu:colour": "#C79588",
      "skos:broader": {
        "@id": "luc:intensive_animal_production"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Specialised dacilities dedicated to the intensive production of domestic fowl (e.g. chickens, turkeys, ducks, geese) for meat or egg production."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.6.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Poultry farms"
      }
    },
    {
      "@id": "luc:production_agriculture_plantations",
      "@type": "skos:Concept",
      "lu:colour": "#6E8C44",
      "skos:definition": {
        "@language": "en",
        "@value": "Land used principally for primary production, where native vegetation has largely been replaced by introduced species through clearing, the sowing of new species, the application of fertilisers, or the dominance of volunteer species. Includes plantation forests, pasture production for stock, cropping and fodder production, and horticultural production."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:grazing_modified_pasture_systems"
        },
        {
          "@id": "luc:intensive_animal_production"
        },
        {
          "@id": "luc:intensive_horticulture"
        },
        {
          "@id": "luc:perennial_horticulture"
        },
        {
          "@id": "luc:plantation_forests"
        },
        {
          "@id": "luc:short_rotation_seasonal_cropping"
        },
        {
          "@id": "luc:smallholder_farm"
        },
        {
          "@id": "luc:vacant_and_transitioning_land"
        },
        {
          "@id": "luc:water_wastewater_agriculture"
        }
      ],
      "skos:notation": "2.0.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Production agriculture and plantations"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "If there is evidence of irrigation infrastructure or water-take consents, record irrigation as a management practice, even if irrigation water has not been recently applied."
      },
      "skos:topConceptOf": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Fallow or ploughed land should be assigned to the most likely land use based on the dominant activity conducted in comparable nearby areas or other available evidence. Fallow or ploughed land should be allocated to the relevant pasture, cropping or horticultural class (rather than using land in transition). The fallow or ploughed status should be recorded in the management field."
      }
    },
    {
      "@id": "luc:production_from_indigenous_vegetation",
      "@type": "skos:Concept",
      "lu:colour": "#C6894C",
      "skos:broader": {
        "@id": "luc:minimal_use_relatively_natural"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "The definition of this class was clarified in NZLUM v0.4.0 by explicitly referring to non-plantation native forests."
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Commercial production from retained (non-plantation) native forests and related activities on public and private land (e.g. selective native timber production without clearfelling, and other non-sawlong, non-pulpwood, native forest products including oil, wildflowers, firewood, fenceposts, and mānuka/kānuka honey)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.3.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Production from indigenous vegetation"
      }
    },
    {
      "@id": "luc:production_nurseries",
      "@type": "skos:Concept",
      "lu:colour": "#565126",
      "skos:broader": {
        "@id": "luc:intensive_horticulture"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Specialised intensive horticultural facilities dedicated to propagating and growing plants for commercial purposes (outdoor or under cover)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.5.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Production nurseries"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "Nurseries may be outdoor (exposed) or under cover. Production nurseries may employ advanced techniques such as grafting, tissue culture, and controlled environment systems to optimise plant growth and quality."
        },
        {
          "@language": "en",
          "@value": "These nurseries focus on cultivating a wide range of plant species, including ornamentals, fruit trees, and shrubs, typically for landscaping, reforestation, or ornamental purposes."
        }
      ]
    },
    {
      "@id": "luc:protected_landscape",
      "@type": "skos:Concept",
      "dcterms:source": {
        "@language": "en",
        "@value": "IUCN (2008) Protected Areas Management Categories, Category V: Protected Landscape/Seascape."
      },
      "lu:colour": "#BCBDDC",
      "skos:broader": {
        "@id": "luc:nature_cons"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Protected area managed mainly for landscape conservation and recreation. An area of land where the interaction of people and nature over time has produced a distinct character with significant aesthetic, cultural or ecological value, and often high biodiversity."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.1.6",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Protected landscape"
      }
    },
    {
      "@id": "luc:public_recreation_services",
      "@type": "skos:Concept",
      "lu:colour": "#C19878",
      "skos:broader": {
        "@id": "luc:built_environment"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land designated for recreational facilities and community amenities, serving recreational needs and essential functions of the local population."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:community_services"
        },
        {
          "@id": "luc:indoor_recreation"
        },
        {
          "@id": "luc:outdoor_recreation"
        }
      ],
      "skos:notation": "3.2.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Public recreation and services"
      }
    },
    {
      "@id": "luc:quarries",
      "@type": "skos:Concept",
      "lu:colour": "#9E7E51",
      "skos:broader": {
        "@id": "luc:mining"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land from which stone, gravel, clay, slate, sand, soil, rock, or other construction materials are being extracted."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.7.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Quarries"
      }
    },
    {
      "@id": "luc:railways",
      "@type": "skos:Concept",
      "lu:colour": "#33353A",
      "skos:broader": {
        "@id": "luc:transport"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Permanent rail transport tracks and associated infrastructure, including stations and terminals; includes the full rail corridor required for safety clearance."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.6.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Railways"
      }
    },
    {
      "@id": "luc:rehabilitating_land",
      "@type": "skos:Concept",
      "lu:colour": "#B2AC8B",
      "skos:broader": {
        "@id": "luc:unused_and_transitioning"
      },
      "skos:changeNote": {
        "@id": "https://github.com/manaakiwhenua/nzsluc/issues/36"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Degraded land (e.g. due to erosion or flood damage) that is being actively rehabilitated through planting with indigenous or exotic species to return land to a natural state."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.4.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Rehabilitating land"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "This may include riparian plantings."
      }
    },
    {
      "@id": "luc:rehabilitating_land_ag",
      "@type": "skos:Concept",
      "lu:colour": "#B6C8BC",
      "skos:broader": {
        "@id": "luc:vacant_and_transitioning_land"
      },
      "skos:changeNote": "Changed notation at v0.4.0",
      "skos:definition": {
        "@language": "en",
        "@value": "Land in the process of rehabilitation for agricultural production (e.g. after significant flooding), and which is actively being recovered."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.8.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Rehabilitating land"
      }
    },
    {
      "@id": "luc:residential",
      "@type": "skos:Concept",
      "lu:colour": "#815E5B",
      "skos:broader": {
        "@id": "luc:built_environment"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land uses primarily designated for private, long-term human habitation, encompassing a variety of housing types and densities."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:high_density_residential"
        },
        {
          "@id": "luc:low_density_residential"
        },
        {
          "@id": "luc:medium_density_residential"
        },
        {
          "@id": "luc:rural_residential"
        }
      ],
      "skos:notation": "3.1.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Residential"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "The class includes holidays homes, retirement villages, student hostels and other forms of low-turnover or longer-term accommodation, even if these are run commercially. Shorter- term forms of accommodation (motels, hotels, holiday parks, etc.) are captured under ‘3.3.0 Commercial’ or ‘3.3.3 Hospitality’"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Some alignment with the National Planning Standards (Zone Framework Standard) (MfE 2019) has been considered in the development of the subclasses. This information (as at time of classification) should be captured in the zone attribute to allow for some reclassification and specification."
      }
    },
    {
      "@id": "luc:retail",
      "@type": "skos:Concept",
      "lu:colour": "#6E94BA",
      "skos:broader": {
        "@id": "luc:commercial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Areas used for the sale of goods and services directly to consumers."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Shops, supermarkets, shopping malls, convenience stores, suburban dairies, and other retail outlets."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.3.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Retail"
      }
    },
    {
      "@id": "luc:roads",
      "@type": "skos:Concept",
      "lu:colour": "#494B51",
      "skos:broader": {
        "@id": "luc:transport"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The full roading corridor, including sealed road areas and unsealed roadside strips."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.6.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Roads"
      }
    },
    {
      "@id": "luc:rural_residential",
      "@type": "skos:Concept",
      "lu:colour": "#A87A76",
      "skos:broader": {
        "@id": "luc:residential"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Residential properties with low-intensity (non-commercial) land management practices on land in rural or peri-urban areas."
      },
      "skos:historyNote": {
        "@language": "en",
        "@value": "In land fragmentation analyses, parcels greater than 2 ha in size (with or without a dwelling) have been considered non-residential. The term lifestyle is disfavoured in this context, as it is not a landuse but rather it indicates that some form of primary production does occur but that it is not the resident's primary source of income. Thus the term 'lifestyle' reflects a motivation for a particular land use, but is not itself a useful land use."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.1.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Rural residential"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Typically featuring larger parcel sizes amidst agricultural or natural surroundings. Concordant with the ‘Rural lifestyle zone’ from the Zone Framework Standard."
      },
      "skos:usageNote": [
        {
          "@language": "en",
          "@value": "As a general guideline, properties with a dwelling, and between 0.4 ha and 2 ha in size, should be considered rural residential. Larger properties should be considered under class 2, especially if the zone context is non-residential, and even if they are declared residential or lifestyle in the District Valuation Roll."
        },
        {
          "@language": "en",
          "@value": "Properties in this size interval and without a dwelling could be in transition to residential."
        }
      ]
    },
    {
      "@id": "luc:sawmill",
      "@type": "skos:Concept",
      "lu:colour": "#A8AABB",
      "skos:broader": {
        "@id": "luc:manufacturing_industrial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area with special improvements for the processing (milling and curing) of raw timber, wood products, and by-products."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.4.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Sawmill"
      }
    },
    {
      "@id": "luc:seasonal_flowers_bulbs_turf",
      "@type": "skos:Concept",
      "lu:colour": "#FED57E",
      "skos:broader": {
        "@id": "luc:short_rotation_seasonal_cropping"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Cultivation of seasonal ornamental flowers, bulbs, and turf grass for commercial purposes."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.3.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Seasonal flowers and bulbs, and turf farming"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "This class encompasses activities such as the cultivation of flowers and bulbs for seasonal markets, landscaping, and turf-farming for sports fields, lawns, and recreational areas."
      }
    },
    {
      "@id": "luc:short_rotation_horticulture",
      "@type": "skos:Concept",
      "lu:colour": "#E3BC67",
      "skos:broader": {
        "@id": "luc:short_rotation_seasonal_cropping"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Crop plants living for less than 2 years that are intensively cultivated; predominantly rotations of vegetable crops or seasonal fruits grown for human consumption."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.3.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Short-rotation horticulture"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "May include livestock rotations, but this is considered less likely"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "The specific commodity or commodities should be noted if known."
      }
    },
    {
      "@id": "luc:short_rotation_seasonal_cropping",
      "@type": "skos:Concept",
      "lu:colour": "#C6A14D",
      "skos:broader": {
        "@id": "luc:production_agriculture_plantations"
      },
      "skos:changeNote": [
        {
          "@id": "https://github.com/manaakiwhenua/nzsluc/issues/65"
        },
        {
          "@language": "en",
          "@value": "The explicit five year periodicity was added in v0.4.0."
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "This class includes agricultural practices characterised by the cultivation of crops with rapid turnover cycles and seasonal planting patterns, typically optimised for efficient land use and high-yield production."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:arable_cropping"
        },
        {
          "@id": "luc:arable_mixed_livestock_cropping"
        },
        {
          "@id": "luc:seasonal_flowers_bulbs_turf"
        },
        {
          "@id": "luc:short_rotation_horticulture"
        }
      ],
      "skos:notation": "2.3.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Short-rotation and seasonal cropping"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "The period of rotation to be considered (e.g. in the listing of commodities, or when deciding whether there is any rotation at all) is five years."
        },
        {
          "@language": "en",
          "@value": "Arable, and mixed livestock cropping, integrating both crop cultivation and animal husbandry, are also included in this class."
        },
        {
          "@language": "en",
          "@value": "This class encompasses agricultural activities such as the cultivation of fast-growing crops such as maize, barley, and certain vegetables, often rotated on short-term cycles to maintain soil health and maximise productivity."
        }
      ],
      "skos:usageNote": {
        "@language": "en",
        "@value": "If the type of crop is known, record this in the commodity field. For mixed arable and livestock operations, both commodities should be captured as the primary commodity (neither is ancillary)."
      }
    },
    {
      "@id": "luc:smallholder_farm",
      "@type": "skos:Concept",
      "lu:colour": "#E5D64F",
      "skos:broader": {
        "@id": "luc:production_agriculture_plantations"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "Added at v0.4.0 to capture the gap between 3.1.4 Rural residential (0.4–2 ha) and commercial pastoral classes (2.2.0)."
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A rural property larger than a rural residential property (> 2 ha) but where the primary motivation is still residential rather than commercial agricultural production, and where any land management is low-intensity and incidental to the residential occupation."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.9.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Smallholder farm"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "Properties classified here may carry small numbers of stock or maintain informal pasture, but these activities are subsidiary to the residential use of the land."
        },
        {
          "@language": "en",
          "@value": "Extends 3.1.4 Rural residential to properties that exceed the lifestyle block size threshold but retain distinctive residential/lifestyle character. Distinguishable from 2.2.0 Grazing modified pasture systems by the absence of commercial pastoral intent and the relatively low level of active land management."
        }
      ],
      "skos:usageNote": [
        {
          "@language": "en",
          "@value": "As a subclass of 2.0.0, commodities and management practices may still be recorded."
        },
        {
          "@language": "en",
          "@value": "Typical evidence: NDVR lifestyle codes (property uses 21 single-unit lifestyle, 22 multi-unit lifestyle) or possibly category L with land area in the range 2–40 ha. Properties substantially exceeding 40 ha with lifestyle NDVR codes should typically be excluded, in favour of classification under 2.2.2 or 2.2.3."
        }
      ]
    },
    {
      "@id": "luc:solar_electricity_generation",
      "@type": "skos:Concept",
      "lu:colour": "#B78FE5",
      "skos:broader": {
        "@id": "luc:utilities"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Facilities that harness sunlight using photovoltaic cells or solar thermal systems to generate electricity."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.5.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Solar electricity generation"
      }
    },
    {
      "@id": "luc:stock_water",
      "@type": "skos:Concept",
      "lu:colour": "#528582",
      "skos:broader": {
        "@id": "luc:water_wastewater_agriculture"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Reservoirs or farm dams on agricultural land for the purpose of supplying drinking-water for stock."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.7.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Stock water"
      }
    },
    {
      "@id": "luc:stormwater_management",
      "@type": "skos:Concept",
      "lu:colour": "#FEBDAA",
      "skos:broader": {
        "@id": "luc:waste_treatment_disposal"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Infrastructure aimed at controlling and mitigating stormwater runoff to prevent flooding, erosion, and pollution."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Detention basins, drainage systems, retention ponds, rain gardens, wetlands."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.8.5",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Stormwater management"
      }
    },
    {
      "@id": "luc:strict_nature_res",
      "@type": "skos:Concept",
      "dcterms:source": {
        "@language": "en",
        "@value": "IUCN (2008) Protected Areas Management Categories, Category Ia: strict nature reserve."
      },
      "lu:colour": "#3F007D",
      "skos:broader": {
        "@id": "luc:nature_cons"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Protected area managed mainly for science. An area of land possessing outstanding or representative ecosystems, geological or physiological features or species, which is available primarily for scientific research and/or environmental monitoring."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.1.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Strict nature reserve"
      }
    },
    {
      "@id": "luc:surface_water_supply",
      "@type": "skos:Concept",
      "lu:colour": "#50816D",
      "skos:broader": {
        "@id": "luc:minimal_use_relatively_natural"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area managed as a catchment for water supply."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.3.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Surface water supply"
      }
    },
    {
      "@id": "luc:tailings",
      "@type": "skos:Concept",
      "lu:colour": "#BA9869",
      "skos:broader": {
        "@id": "luc:mining"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Tailings dumps and dams for storage or treatment of waste material left over after extraction, often stored in containment facilities or ponds (including quarrying output)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.7.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Tailings"
      }
    },
    {
      "@id": "luc:transfer_stations_recycling",
      "@type": "skos:Concept",
      "lu:colour": "#E97453",
      "skos:broader": {
        "@id": "luc:waste_treatment_disposal"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Facilities where solid waste is collected, sorted, processed, and prepared for recycling or transfer to landfills or other disposal sites."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.8.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Transfer stations and recycling facilities"
      }
    },
    {
      "@id": "luc:transport",
      "@type": "skos:Concept",
      "lu:colour": "#72737E",
      "skos:broader": {
        "@id": "luc:built_environment"
      },
      "skos:changeNote": [
        {
          "@id": "https://github.com/manaakiwhenua/nzsluc/issues/69"
        },
        {
          "@language": "en",
          "@value": "Redefinition of class 3.6.0 to exclude navigation and communication infrastructure, which is now captured under 3.5.8. Renamed from 'Transport and communication'."
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Land allocated to infrastructure used for the transportation of goods or people."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:airports_aerodromes"
        },
        {
          "@id": "luc:ports_water_transport"
        },
        {
          "@id": "luc:railways"
        },
        {
          "@id": "luc:roads"
        }
      ],
      "skos:notation": "3.6.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Transportation"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Zoning of land for roading or rail purposes that has not yet been constructed should be captured as attributes."
      }
    },
    {
      "@id": "luc:transportation_warehousing_commercial",
      "@type": "skos:Concept",
      "lu:colour": "#547B9F",
      "skos:broader": {
        "@id": "luc:commercial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Privately owned land associated with the movement and storage of goods, including distribution centres, warehouses, logistics facilities, car dealerships, and commercial parking lots."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.3.6",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Transportation & warehousing"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Excludes airports, ports, roads, and train stations (captured under 3.6.0)"
      }
    },
    {
      "@id": "luc:tree_crops",
      "@type": "skos:Concept",
      "lu:colour": "#818367",
      "skos:broader": {
        "@id": "luc:perennial_horticulture"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Long-term cultivated plants, typically trees or woody shrubs, grown for fruits, nuts, or other edible parts. These crops require intensive management practices aimed at ensuring optimal growth, productivity, and quality over multiple years."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.4.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Tree crops"
      },
      "skos:usageNote": [
        {
          "@language": "en",
          "@value": "Management practices may include pruning, pest and disease control, irrigation, and harvesting techniques specific to tree crops."
        },
        {
          "@language": "en",
          "@value": "Examples include orchard fruits such as olives, apples, oranges, and apricots, as well as tree nuts such as hazelnuts, macadamias, and chestnuts, which should be recorded in the commodity attribute, if known."
        }
      ]
    },
    {
      "@id": "luc:unused_and_transitioning",
      "@type": "skos:Concept",
      "lu:colour": "#C8C69F",
      "skos:broader": {
        "@id": "luc:conservation"
      },
      "skos:changeNote": {
        "@id": "https://github.com/manaakiwhenua/nzsluc/issues/36"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land unused for rural production and urban development, without particular conservation instruments, and without any apparent built structure; or land that is transitioning towards a vacant and considerably natural state."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:rehabilitating_land"
        },
        {
          "@id": "luc:unused_land"
        }
      ],
      "skos:notation": "1.4.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unused and transitioning land"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "Does not per se include land undergoing natural succession in the context of changing plant species."
        },
        {
          "@language": "en",
          "@value": "Corridors and roadside areas may fit under this class."
        },
        {
          "@language": "en",
          "@value": "Unused land (in the sense of non-productive, non-conservation or non-built uses), such as cliffs, rock faces, boulders, and tors, and where there are relatively low levels of disturbance, may be included."
        }
      ]
    },
    {
      "@id": "luc:unused_land",
      "@type": "skos:Concept",
      "lu:colour": "#DFD8B6",
      "skos:broader": {
        "@id": "luc:unused_and_transitioning"
      },
      "skos:changeNote": {
        "@id": "https://github.com/manaakiwhenua/nzsluc/issues/36"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land that is unused or unusable for productive agriculture or urban uses, such as cliffs, rock faces, boulders, and tors, where there are relatively low levels of disturbance."
      },
      "skos:example": [
        {
          "@language": "en",
          "@value": "CERA Red Zone land in Christchurch, abandoned after the 2011 Canterbury earthquake and presently pending use."
        },
        {
          "@language": "en",
          "@value": "A vacant farm, apparently undergoing natural succession."
        }
      ],
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.4.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unused land"
      }
    },
    {
      "@id": "luc:utilities",
      "@type": "skos:Concept",
      "lu:colour": "#955085",
      "skos:broader": {
        "@id": "luc:built_environment"
      },
      "skos:changeNote": [
        {
          "@language": "en",
          "@value": "Class 3.5.0 redefined at v0.4.0 to include naviation and communciation infrastructure, which was formerly captured under class 3.6.0."
        },
        {
          "@id": "https://github.com/manaakiwhenua/nzsluc/issues/69"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Land allocated to providing electricity, gas, or water; or for navigation and communication infrastructure."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:electricity_substations_transmission"
        },
        {
          "@id": "luc:fuel_powered_electricity_generation"
        },
        {
          "@id": "luc:gas_treatment_storage_transmission"
        },
        {
          "@id": "luc:hydroelectricity_generation"
        },
        {
          "@id": "luc:navigation_communication"
        },
        {
          "@id": "luc:solar_electricity_generation"
        },
        {
          "@id": "luc:water_extraction_transmission"
        },
        {
          "@id": "luc:wind_electricity_generation"
        }
      ],
      "skos:notation": "3.5.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Utilities"
      }
    },
    {
      "@id": "luc:vacant_and_transitioning_land",
      "@type": "skos:Concept",
      "lu:colour": "#B6C8BC",
      "skos:broader": {
        "@id": "luc:production_agriculture_plantations"
      },
      "skos:changeNote": [
        {
          "@id": "https://github.com/manaakiwhenua/nzsluc/issues/36"
        },
        {
          "@language": "en",
          "@value": "Preferred label changed from 'Land in transition' at v0.4.0"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "As a subclass of Production agriculture and plantations, land must recently have been used for agriculture or plantations."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:abandoned_land_ag"
        },
        {
          "@id": "luc:degraded_land_ag"
        },
        {
          "@id": "luc:no_defined_use_ag"
        },
        {
          "@id": "luc:rehabilitating_land_ag"
        }
      ],
      "skos:notation": "2.8.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Vacant and transitioning land"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "In the case of greenfield development where land use is transitioning to a built-environment category, classify under 3.9.0 Vacant and transitioning land (or a subclass) rather than 2.8.0."
      }
    },
    {
      "@id": "luc:vacant_land",
      "@type": "skos:Concept",
      "lu:colour": "#D3ACB7",
      "skos:broader": {
        "@id": "luc:vacant_transitioning_land_urban"
      },
      "skos:changeNote": "Notation changed from 3.9.1 to 3.9.3 at v0.4.0",
      "skos:definition": {
        "@language": "en",
        "@value": "Derelict land and developed land that is idle."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.9.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Idle and derelict land"
      }
    },
    {
      "@id": "luc:vacant_transitioning_land_urban",
      "@type": "skos:Concept",
      "lu:colour": "#D69B97",
      "skos:broader": {
        "@id": "luc:built_environment"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "This land-use type includes areas that are currently unused or undergoing a transition from one land use to another, but in this case with a clear transition towards or within other concepts under the built environment."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:brownfield_development"
        },
        {
          "@id": "luc:greenfield_development"
        },
        {
          "@id": "luc:vacant_land"
        }
      ],
      "skos:notation": "3.9.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Vacant and transitioning land"
      }
    },
    {
      "@id": "luc:vine_fruits",
      "@type": "skos:Concept",
      "lu:colour": "#9EA083",
      "skos:broader": {
        "@id": "luc:perennial_horticulture"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Fruit-bearing plants that grow on vines or trailing stems, often requiring support structures (e.g. trellises, arbours). These plants produce fruits that typically hang from vines and may include grapes, kiwifruit, and passionfruit. Vine fruit cultivation involves specific management practices such as pruning, training, trellising, and pest and disease control specific to vine plants."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.4.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Vine fruits"
      }
    },
    {
      "@id": "luc:waste_treatment_disposal",
      "@type": "skos:Concept",
      "lu:colour": "#E77148",
      "skos:broader": {
        "@id": "luc:built_environment"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land uses dedicated to managing and processing waste materials (solid waste, wastewater, stormwater), primarily associated with industrial and urban activities, to mitigate environmental impacts and protect public health."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:landfills"
        },
        {
          "@id": "luc:municipal_wastewater"
        },
        {
          "@id": "luc:stormwater_management"
        },
        {
          "@id": "luc:transfer_stations_recycling"
        },
        {
          "@id": "luc:wastewater_treatment_land_application"
        }
      ],
      "skos:notation": "3.8.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Waste treatment and disposal"
      }
    },
    {
      "@id": "luc:wastewater_treatment_land_application",
      "@type": "skos:Concept",
      "lu:colour": "#FF9475",
      "skos:broader": {
        "@id": "luc:waste_treatment_disposal"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Areas where treated municipal wastewater is applied onto land for beneficial reuse, following appropriate treatment processes to ensure environmental safety."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Irrigation, groundwater recharge, soil fertility enhancement."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.8.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Wastewater treatment – land application"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": " This is often likely to be an ancillary use."
      }
    },
    {
      "@id": "luc:water_extraction_transmission",
      "@type": "skos:Concept",
      "lu:colour": "#D289BF",
      "skos:broader": {
        "@id": "luc:utilities"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Facilities and infrastructure for extracting, purifying, treating, and transporting water from natural sources to meet human needs."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.5.7",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Water extraction and transmission"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Includes drinking water reservoirs."
      }
    },
    {
      "@id": "luc:water_treatment_land_application",
      "@type": "skos:Concept",
      "lu:colour": "#396B69",
      "skos:broader": {
        "@id": "luc:water_wastewater_agriculture"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land used for effluent disposal"
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.7.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Water treatment – land application"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "probably an ancillary use where some form of grazing is the primary use."
      }
    },
    {
      "@id": "luc:water_treatment_wetland",
      "@type": "skos:Concept",
      "lu:colour": "#6C9F9C",
      "skos:broader": {
        "@id": "luc:water_wastewater_agriculture"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Constructed or natural wetlands used to improve water quality prior to discharge."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "2.7.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Water treatment – wetland"
      }
    },
    {
      "@id": "luc:water_wastewater_agriculture",
      "@type": "skos:Concept",
      "lu:colour": "#528582",
      "skos:broader": {
        "@id": "luc:production_agriculture_plantations"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Built water features associated with agricultural use."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:narrower": [
        {
          "@id": "luc:effluent_pond"
        },
        {
          "@id": "luc:irrigation_reservoirs_canals"
        },
        {
          "@id": "luc:stock_water"
        },
        {
          "@id": "luc:water_treatment_land_application"
        },
        {
          "@id": "luc:water_treatment_wetland"
        }
      ],
      "skos:notation": "2.7.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Water and wastewater"
      }
    },
    {
      "@id": "luc:wilderness",
      "@type": "skos:Concept",
      "dcterms:source": {
        "@language": "en",
        "@value": "IUCN (2008) Protected Areas Management Categories, Category Ib: wilderness area."
      },
      "lu:colour": "#54278F",
      "skos:broader": {
        "@id": "luc:nature_cons"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Protected area managed mainly for wilderness protection. A large area of unmodified or slightly modified land, retaining its natural character and influence, without permanent or significant habitation, which is protected and managed so as to preserve its natural condition."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "1.1.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Wilderness area"
      }
    },
    {
      "@id": "luc:wind_electricity_generation",
      "@type": "skos:Concept",
      "lu:colour": "#D6B2FD",
      "skos:broader": {
        "@id": "luc:utilities"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Power generation from wind, including wind farms."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.1"
      },
      "skos:notation": "3.5.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Wind electricity generation"
      }
    },
    {
      "@id": "lus:nzlum",
      "@type": "skos:ConceptScheme",
      "dcterms:hasVersion": [
        {
          "@id": "lus:nzlum0.3.0"
        },
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.4.1"
        }
      ],
      "dcterms:relation": {
        "@id": "lu_proverb:kotahi_te_aho"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "New Zealand Land Use and Management classification system"
      },
      "doap:repository": {
        "@id": "ns1:nzsluc"
      },
      "foaf:homepage": {
        "@id": "https://nzlum.landcareresearch.co.nz/"
      }
    },
    {
      "@id": "lus:nzlum0.3.0",
      "@type": "skos:ConceptScheme",
      "adms:status": {
        "@id": "lu_status:superseded"
      },
      "dcterms:isReplacedBy": {
        "@id": "lus:nzlum0.4.0"
      },
      "dcterms:isVersionOf": {
        "@id": "lus:nzlum"
      },
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2025-06-30"
      },
      "owl:versionInfo": "0.3.0",
      "skos:hasTopConcept": [
        {
          "@id": "luc:built_environment"
        },
        {
          "@id": "luc:conservation"
        },
        {
          "@id": "luc:production_agriculture_plantations"
        }
      ]
    },
    {
      "@id": "lus:nzlum0.4.0",
      "@type": "skos:ConceptScheme",
      "adms:status": {
        "@id": "lu_status:published"
      },
