@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:animal skos:member mgmt:milking_herringbone ;
    skos:prefLabel "Animal"@en .

mgmt:milking_herringbone.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:milking_herringbone.jsonld,
        mgmt:milking_herringbone.rdf,
        mgmt:milking_herringbone.ttl .

mgmt:milking_herringbone.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:milking_herringbone .

mgmt:milking_herringbone.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:milking_herringbone .

mgmt:milking_herringbone.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:milking_herringbone .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:milking_herringbone a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "milking herringbone" ;
    foaf:isPrimaryTopicOf mgmt:milking_herringbone.html .

