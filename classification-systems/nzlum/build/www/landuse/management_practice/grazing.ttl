@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:grazing.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:grazing.jsonld,
        mgmt:grazing.rdf,
        mgmt:grazing.ttl .

mgmt:grazing.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:grazing .

mgmt:grazing.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:grazing .

mgmt:grazing.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:grazing .

mgmt:grazing_rotational skos:notation "grazing rotational" .

mgmt:grazing_set_stocking skos:notation "grazing set stocking" .

mgmt:grazing_tactical skos:notation "grazing tactical" .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:grazing a skos:Collection ;
    skos:inScheme lus:management_practices ;
    skos:member mgmt:grazing_rotational,
        mgmt:grazing_set_stocking,
        mgmt:grazing_tactical ;
    skos:prefLabel "Grazing"@en ;
    foaf:isPrimaryTopicOf mgmt:grazing.html .

