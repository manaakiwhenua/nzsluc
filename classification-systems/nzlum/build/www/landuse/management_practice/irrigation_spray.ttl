@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:irrigation skos:member mgmt:irrigation_spray ;
    skos:prefLabel "Irrigation"@en .

mgmt:irrigation_spray.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:irrigation_spray.jsonld,
        mgmt:irrigation_spray.rdf,
        mgmt:irrigation_spray.ttl .

mgmt:irrigation_spray.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:irrigation_spray .

mgmt:irrigation_spray.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:irrigation_spray .

mgmt:irrigation_spray.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:irrigation_spray .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:irrigation_spray a skos:Concept ;
    skos:definition "Irrigation system that sprays water into the air allowing it to fall on the plants and soil much like natural rainfall."@en ;
    skos:inScheme lus:management_practices ;
    skos:notation "irrigation spray" ;
    skos:scopeNote "Sprinklers including set systems, permanent (solid set/fixed), continuous/travelling systems and micro-sprinklers."@en ;
    foaf:isPrimaryTopicOf mgmt:irrigation_spray.html .

