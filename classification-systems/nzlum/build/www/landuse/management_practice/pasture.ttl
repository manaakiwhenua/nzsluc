@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:biodynamic skos:notation "biodynamic" .

mgmt:crop_pasture_rotation skos:notation "crop pasture rotation" .

mgmt:organic skos:notation "organic" .

mgmt:pasture.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:pasture.jsonld,
        mgmt:pasture.rdf,
        mgmt:pasture.ttl .

mgmt:pasture.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:pasture .

mgmt:pasture.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:pasture .

mgmt:pasture.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:pasture .

mgmt:pasture_cropping skos:notation "pasture cropping" .

mgmt:precision_agriculture skos:notation "precision agriculture" .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:pasture a skos:Collection ;
    skos:inScheme lus:management_practices ;
    skos:member mgmt:biodynamic,
        mgmt:crop_pasture_rotation,
        mgmt:organic,
        mgmt:pasture_cropping,
        mgmt:precision_agriculture ;
    skos:prefLabel "Pasture"@en ;
    foaf:isPrimaryTopicOf mgmt:pasture.html .

