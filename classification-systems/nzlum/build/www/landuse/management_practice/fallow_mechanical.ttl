@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:crop skos:member mgmt:fallow_mechanical ;
    skos:prefLabel "Crop"@en .

mgmt:fallow_mechanical.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:fallow_mechanical.jsonld,
        mgmt:fallow_mechanical.rdf,
        mgmt:fallow_mechanical.ttl .

mgmt:fallow_mechanical.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:fallow_mechanical .

mgmt:fallow_mechanical.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:fallow_mechanical .

mgmt:fallow_mechanical.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:fallow_mechanical .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:fallow_mechanical a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "fallow mechanical" ;
    foaf:isPrimaryTopicOf mgmt:fallow_mechanical.html .

