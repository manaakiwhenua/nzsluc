@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:free_standing skos:notation "free standing" .

mgmt:fully_protected skos:notation "fully protected" .

mgmt:hedgerow skos:notation "hedgerow" .

mgmt:horticulture.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:horticulture.jsonld,
        mgmt:horticulture.rdf,
        mgmt:horticulture.ttl .

mgmt:horticulture.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:horticulture .

mgmt:horticulture.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:horticulture .

mgmt:horticulture.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:horticulture .

mgmt:mulching_matting skos:notation "mulching/matting" .

mgmt:open_growing skos:notation "open growing" .

mgmt:semi_protected skos:notation "semi-protected" .

mgmt:trellis_espalier skos:notation "trellis/espalier" .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:horticulture a skos:Collection ;
    skos:inScheme lus:management_practices ;
    skos:member mgmt:free_standing,
        mgmt:fully_protected,
        mgmt:hedgerow,
        mgmt:mulching_matting,
        mgmt:open_growing,
        mgmt:semi_protected,
        mgmt:trellis_espalier ;
    skos:prefLabel "Horticulture"@en ;
    foaf:isPrimaryTopicOf mgmt:horticulture.html .

