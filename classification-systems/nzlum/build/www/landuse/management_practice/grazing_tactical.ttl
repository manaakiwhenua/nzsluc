@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:grazing skos:member mgmt:grazing_tactical ;
    skos:prefLabel "Grazing"@en .

mgmt:grazing_tactical.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:grazing_tactical.jsonld,
        mgmt:grazing_tactical.rdf,
        mgmt:grazing_tactical.ttl .

mgmt:grazing_tactical.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:grazing_tactical .

mgmt:grazing_tactical.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:grazing_tactical .

mgmt:grazing_tactical.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:grazing_tactical .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:grazing_tactical a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "grazing tactical" ;
    foaf:isPrimaryTopicOf mgmt:grazing_tactical.html .

