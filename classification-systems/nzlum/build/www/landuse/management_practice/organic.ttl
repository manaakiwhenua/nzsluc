@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:crop skos:member mgmt:organic ;
    skos:prefLabel "Crop"@en .

mgmt:pasture skos:member mgmt:organic ;
    skos:prefLabel "Pasture"@en .

mgmt:organic.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:organic.jsonld,
        mgmt:organic.rdf,
        mgmt:organic.ttl .

mgmt:organic.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:organic .

mgmt:organic.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:organic .

mgmt:organic.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:organic .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:organic a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "organic" ;
    foaf:isPrimaryTopicOf mgmt:organic.html .

