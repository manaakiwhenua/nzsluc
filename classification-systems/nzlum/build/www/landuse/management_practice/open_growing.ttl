@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:horticulture skos:member mgmt:open_growing ;
    skos:prefLabel "Horticulture"@en .

mgmt:open_growing.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:open_growing.jsonld,
        mgmt:open_growing.rdf,
        mgmt:open_growing.ttl .

mgmt:open_growing.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:open_growing .

mgmt:open_growing.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:open_growing .

mgmt:open_growing.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:open_growing .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:open_growing a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "open growing" ;
    foaf:isPrimaryTopicOf mgmt:open_growing.html .

