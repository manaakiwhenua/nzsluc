      "@type": "skos:Concept",
      "foaf:isPrimaryTopicOf": {
        "@id": "mgmt:irrigation_surface.html"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Water is applied to the land by allowing it to flow by simple gravity before infiltrating. Under furrow irrigation, small parallel channels carry water to irrigate the crop with the crop usually grown on the ridges between the furrows."
      },
      "skos:inScheme": {
        "@id": "lus:management_practices"
      },
      "skos:notation": "irrigation surface",
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Also flood/furrow irrigation."
      }
