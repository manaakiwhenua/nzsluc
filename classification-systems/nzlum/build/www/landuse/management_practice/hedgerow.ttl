@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:horticulture skos:member mgmt:hedgerow ;
    skos:prefLabel "Horticulture"@en .

mgmt:hedgerow.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:hedgerow.jsonld,
        mgmt:hedgerow.rdf,
        mgmt:hedgerow.ttl .

mgmt:hedgerow.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:hedgerow .

mgmt:hedgerow.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:hedgerow .

mgmt:hedgerow.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:hedgerow .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:hedgerow a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "hedgerow" ;
    foaf:isPrimaryTopicOf mgmt:hedgerow.html .

