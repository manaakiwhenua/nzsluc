@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:crop skos:member mgmt:precision_agriculture ;
    skos:prefLabel "Crop"@en .

mgmt:pasture skos:member mgmt:precision_agriculture ;
    skos:prefLabel "Pasture"@en .

mgmt:precision_agriculture.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:precision_agriculture.jsonld,
        mgmt:precision_agriculture.rdf,
        mgmt:precision_agriculture.ttl .

mgmt:precision_agriculture.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:precision_agriculture .

mgmt:precision_agriculture.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:precision_agriculture .

mgmt:precision_agriculture.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:precision_agriculture .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:precision_agriculture a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "precision agriculture" ;
    foaf:isPrimaryTopicOf mgmt:precision_agriculture.html .

