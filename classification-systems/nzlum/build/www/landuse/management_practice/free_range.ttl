@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:animal skos:member mgmt:free_range ;
    skos:prefLabel "Animal"@en .

mgmt:free_range.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:free_range.jsonld,
        mgmt:free_range.rdf,
        mgmt:free_range.ttl .

mgmt:free_range.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:free_range .

mgmt:free_range.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:free_range .

mgmt:free_range.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:free_range .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:free_range a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "free range" ;
    foaf:isPrimaryTopicOf mgmt:free_range.html .

