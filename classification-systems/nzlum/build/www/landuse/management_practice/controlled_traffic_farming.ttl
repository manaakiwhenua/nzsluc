@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:crop skos:member mgmt:controlled_traffic_farming ;
    skos:prefLabel "Crop"@en .

mgmt:controlled_traffic_farming.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:controlled_traffic_farming.jsonld,
        mgmt:controlled_traffic_farming.rdf,
        mgmt:controlled_traffic_farming.ttl .

mgmt:controlled_traffic_farming.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:controlled_traffic_farming .

mgmt:controlled_traffic_farming.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:controlled_traffic_farming .

mgmt:controlled_traffic_farming.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:controlled_traffic_farming .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:controlled_traffic_farming a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "controlled traffic farming" ;
    foaf:isPrimaryTopicOf mgmt:controlled_traffic_farming.html .

