@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:horticulture skos:member mgmt:mulching_matting ;
    skos:prefLabel "Horticulture"@en .

mgmt:mulching_matting.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:mulching_matting.jsonld,
        mgmt:mulching_matting.rdf,
        mgmt:mulching_matting.ttl .

mgmt:mulching_matting.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:mulching_matting .

mgmt:mulching_matting.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:mulching_matting .

mgmt:mulching_matting.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:mulching_matting .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:mulching_matting a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "mulching/matting" ;
    foaf:isPrimaryTopicOf mgmt:mulching_matting.html .

