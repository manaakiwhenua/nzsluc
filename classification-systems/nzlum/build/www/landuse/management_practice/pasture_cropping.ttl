@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:crop skos:member mgmt:pasture_cropping ;
    skos:prefLabel "Crop"@en .

mgmt:pasture skos:member mgmt:pasture_cropping ;
    skos:prefLabel "Pasture"@en .

mgmt:pasture_cropping.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:pasture_cropping.jsonld,
        mgmt:pasture_cropping.rdf,
        mgmt:pasture_cropping.ttl .

mgmt:pasture_cropping.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:pasture_cropping .

mgmt:pasture_cropping.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:pasture_cropping .

mgmt:pasture_cropping.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:pasture_cropping .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:pasture_cropping a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "pasture cropping" ;
    foaf:isPrimaryTopicOf mgmt:pasture_cropping.html .

