@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:animal skos:member mgmt:barn_laid ;
    skos:prefLabel "Animal"@en .

mgmt:barn_laid.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:barn_laid.jsonld,
        mgmt:barn_laid.rdf,
        mgmt:barn_laid.ttl .

mgmt:barn_laid.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:barn_laid .

mgmt:barn_laid.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:barn_laid .

mgmt:barn_laid.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:barn_laid .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:barn_laid a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "barn laid" ;
    foaf:isPrimaryTopicOf mgmt:barn_laid.html .

