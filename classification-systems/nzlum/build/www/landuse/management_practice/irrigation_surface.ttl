@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:irrigation skos:member mgmt:irrigation_surface ;
    skos:prefLabel "Irrigation"@en .

mgmt:irrigation_surface.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:irrigation_surface.jsonld,
        mgmt:irrigation_surface.rdf,
        mgmt:irrigation_surface.ttl .

mgmt:irrigation_surface.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:irrigation_surface .

mgmt:irrigation_surface.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:irrigation_surface .

mgmt:irrigation_surface.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:irrigation_surface .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:irrigation_surface a skos:Concept ;
    skos:definition "Water is applied to the land by allowing it to flow by simple gravity before infiltrating. Under furrow irrigation, small parallel channels carry water to irrigate the crop with the crop usually grown on the ridges between the furrows."@en ;
    skos:inScheme lus:management_practices ;
    skos:notation "irrigation surface" ;
    skos:scopeNote "Also flood/furrow irrigation."@en ;
    foaf:isPrimaryTopicOf mgmt:irrigation_surface.html .

