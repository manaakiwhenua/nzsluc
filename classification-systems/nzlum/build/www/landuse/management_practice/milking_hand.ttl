@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:animal skos:member mgmt:milking_hand ;
    skos:prefLabel "Animal"@en .

mgmt:milking_hand.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:milking_hand.jsonld,
        mgmt:milking_hand.rdf,
        mgmt:milking_hand.ttl .

mgmt:milking_hand.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:milking_hand .

mgmt:milking_hand.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:milking_hand .

mgmt:milking_hand.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:milking_hand .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:milking_hand a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "milking hand" ;
    foaf:isPrimaryTopicOf mgmt:milking_hand.html .

