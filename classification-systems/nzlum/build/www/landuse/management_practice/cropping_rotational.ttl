@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:crop skos:member mgmt:cropping_rotational ;
    skos:prefLabel "Crop"@en .

mgmt:cropping_rotational.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:cropping_rotational.jsonld,
        mgmt:cropping_rotational.rdf,
        mgmt:cropping_rotational.ttl .

mgmt:cropping_rotational.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:cropping_rotational .

mgmt:cropping_rotational.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:cropping_rotational .

mgmt:cropping_rotational.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:cropping_rotational .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:cropping_rotational a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "cropping rotational" ;
    foaf:isPrimaryTopicOf mgmt:cropping_rotational.html .

