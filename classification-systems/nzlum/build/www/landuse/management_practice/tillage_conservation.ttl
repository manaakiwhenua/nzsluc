@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:crop skos:member mgmt:tillage_conservation ;
    skos:prefLabel "Crop"@en .

mgmt:tillage_conservation.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:tillage_conservation.jsonld,
        mgmt:tillage_conservation.rdf,
        mgmt:tillage_conservation.ttl .

mgmt:tillage_conservation.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:tillage_conservation .

mgmt:tillage_conservation.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:tillage_conservation .

mgmt:tillage_conservation.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:tillage_conservation .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:tillage_conservation a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "tillage conservation" ;
    foaf:isPrimaryTopicOf mgmt:tillage_conservation.html .

