@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:crop skos:member mgmt:cropping_cover ;
    skos:prefLabel "Crop"@en .

mgmt:cropping_cover.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:cropping_cover.jsonld,
        mgmt:cropping_cover.rdf,
        mgmt:cropping_cover.ttl .

mgmt:cropping_cover.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:cropping_cover .

mgmt:cropping_cover.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:cropping_cover .

mgmt:cropping_cover.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:cropping_cover .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:cropping_cover a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "cropping cover" ;
    foaf:isPrimaryTopicOf mgmt:cropping_cover.html .

