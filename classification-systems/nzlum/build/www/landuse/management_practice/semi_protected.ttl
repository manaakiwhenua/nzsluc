@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:horticulture skos:member mgmt:semi_protected ;
    skos:prefLabel "Horticulture"@en .

mgmt:semi_protected.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:semi_protected.jsonld,
        mgmt:semi_protected.rdf,
        mgmt:semi_protected.ttl .

mgmt:semi_protected.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:semi_protected .

mgmt:semi_protected.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:semi_protected .

mgmt:semi_protected.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:semi_protected .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:semi_protected a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "semi-protected" ;
    foaf:isPrimaryTopicOf mgmt:semi_protected.html .

