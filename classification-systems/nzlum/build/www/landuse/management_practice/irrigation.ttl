@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:irrigation.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:irrigation.jsonld,
        mgmt:irrigation.rdf,
        mgmt:irrigation.ttl .

mgmt:irrigation.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:irrigation .

mgmt:irrigation.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:irrigation .

mgmt:irrigation.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:irrigation .

mgmt:irrigation_drip skos:notation "irrigation drip" .

mgmt:irrigation_spray skos:notation "irrigation spray" .

mgmt:irrigation_surface skos:notation "irrigation surface" .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:irrigation a skos:Collection ;
    skos:inScheme lus:management_practices ;
    skos:member mgmt:irrigation_drip,
        mgmt:irrigation_spray,
        mgmt:irrigation_surface ;
    skos:prefLabel "Irrigation"@en ;
    foaf:isPrimaryTopicOf mgmt:irrigation.html .

