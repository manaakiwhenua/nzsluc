@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:crop skos:member mgmt:residues_burnt ;
    skos:prefLabel "Crop"@en .

mgmt:residues_burnt.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:residues_burnt.jsonld,
        mgmt:residues_burnt.rdf,
        mgmt:residues_burnt.ttl .

mgmt:residues_burnt.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:residues_burnt .

mgmt:residues_burnt.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:residues_burnt .

mgmt:residues_burnt.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:residues_burnt .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:residues_burnt a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "residues burnt" ;
    foaf:isPrimaryTopicOf mgmt:residues_burnt.html .

