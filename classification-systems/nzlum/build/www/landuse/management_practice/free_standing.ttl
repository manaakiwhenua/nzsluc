@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:horticulture skos:member mgmt:free_standing ;
    skos:prefLabel "Horticulture"@en .

mgmt:free_standing.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:free_standing.jsonld,
        mgmt:free_standing.rdf,
        mgmt:free_standing.ttl .

mgmt:free_standing.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:free_standing .

mgmt:free_standing.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:free_standing .

mgmt:free_standing.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:free_standing .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:free_standing a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "free standing" ;
    foaf:isPrimaryTopicOf mgmt:free_standing.html .

