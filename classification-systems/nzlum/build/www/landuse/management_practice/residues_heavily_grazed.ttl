@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:crop skos:member mgmt:residues_heavily_grazed ;
    skos:prefLabel "Crop"@en .

mgmt:residues_heavily_grazed.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:residues_heavily_grazed.jsonld,
        mgmt:residues_heavily_grazed.rdf,
        mgmt:residues_heavily_grazed.ttl .

mgmt:residues_heavily_grazed.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:residues_heavily_grazed .

mgmt:residues_heavily_grazed.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:residues_heavily_grazed .

mgmt:residues_heavily_grazed.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:residues_heavily_grazed .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:residues_heavily_grazed a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "residues heavily grazed" ;
    foaf:isPrimaryTopicOf mgmt:residues_heavily_grazed.html .

