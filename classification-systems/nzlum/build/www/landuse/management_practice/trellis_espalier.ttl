@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:horticulture skos:member mgmt:trellis_espalier ;
    skos:prefLabel "Horticulture"@en .

mgmt:trellis_espalier.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:trellis_espalier.jsonld,
        mgmt:trellis_espalier.rdf,
        mgmt:trellis_espalier.ttl .

mgmt:trellis_espalier.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:trellis_espalier .

mgmt:trellis_espalier.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:trellis_espalier .

mgmt:trellis_espalier.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:trellis_espalier .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:trellis_espalier a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "trellis/espalier" ;
    foaf:isPrimaryTopicOf mgmt:trellis_espalier.html .

