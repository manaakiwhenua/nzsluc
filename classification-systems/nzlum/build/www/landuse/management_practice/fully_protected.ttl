@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:horticulture skos:member mgmt:fully_protected ;
    skos:prefLabel "Horticulture"@en .

mgmt:fully_protected.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:fully_protected.jsonld,
        mgmt:fully_protected.rdf,
        mgmt:fully_protected.ttl .

mgmt:fully_protected.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:fully_protected .

mgmt:fully_protected.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:fully_protected .

mgmt:fully_protected.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:fully_protected .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:fully_protected a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "fully protected" ;
    foaf:isPrimaryTopicOf mgmt:fully_protected.html .

