@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix mgmt: <https://nzlum.landcareresearch.co.nz/landuse/management_practice/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mgmt:crop skos:member mgmt:biodynamic ;
    skos:prefLabel "Crop"@en .

mgmt:pasture skos:member mgmt:biodynamic ;
    skos:prefLabel "Pasture"@en .

mgmt:biodynamic.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat mgmt:biodynamic.jsonld,
        mgmt:biodynamic.rdf,
        mgmt:biodynamic.ttl .

mgmt:biodynamic.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic mgmt:biodynamic .

mgmt:biodynamic.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic mgmt:biodynamic .

mgmt:biodynamic.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic mgmt:biodynamic .

lus:management_practices dcterms:title "NZLUM management practices"@en .

mgmt:biodynamic a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "biodynamic" ;
    foaf:isPrimaryTopicOf mgmt:biodynamic.html .

