{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "lu_status": "https://nzlum.landcareresearch.co.nz/landuse/status/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#"
  },
  "@graph": [
    {
      "@id": "lu_status:draft.rdf",
      "@type": "foaf:Document",
      "dcterms:format": "application/rdf+xml",
      "foaf:primaryTopic": {
        "@id": "lu_status:draft"
      }
    },
    {
      "@id": "lu_status:draft",
      "@type": "rdfs:Resource",
      "foaf:isPrimaryTopicOf": {
        "@id": "lu_status:draft.html"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Draft"
      }
    },
    {
      "@id": "lu_status:draft.html",
      "@type": "foaf:Document",
      "dcterms:format": "text/html",
      "dcterms:hasFormat": [
        {
          "@id": "lu_status:draft.ttl"
        },
        {
          "@id": "lu_status:draft.jsonld"
        },
        {
          "@id": "lu_status:draft.rdf"
        }
      ]
    },
    {
      "@id": "lu_status:draft.jsonld",
      "@type": "foaf:Document",
      "dcterms:format": "application/ld+json",
      "foaf:primaryTopic": {
        "@id": "lu_status:draft"
      }
    },
    {
      "@id": "lu_status:draft.ttl",
      "@type": "foaf:Document",
      "dcterms:format": "text/turtle",
      "foaf:primaryTopic": {
        "@id": "lu_status:draft"
      }
    }
  ]
}
