luc:permanent_carbon_forest a skos:Concept ;
    owl:deprecated true ;
    skos:broader luc:plantation_forests ;
    skos:changeNote "Retired at NZLUM v0.3 and replaced with consideration of carbon sequestration and carbon credits in the definitions of exotic and indigenous plantation forestry."@en ;
    skos:definition "An area planted with indigenous or exotic trees for the purpose of gaining carbon credits (carbon farming)."@en ;
    skos:historyNote "Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0."@en ;
    skos:inScheme lus:nzlum0.3.0 ;
    skos:notation "2.1.5" ;
    skos:prefLabel "Permanent carbon forest"@en .

luc:transport_communication a skos:Concept ;
    owl:deprecated true ;
    skos:broader luc:built_environment ;
    skos:definition "Land allocated to infrastructure used for the transportation of goods or people, or navigation and communication equipment."@en ;
    skos:historyNote "Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0."@en ;
    skos:inScheme lus:nzlum0.3.0 ;
    skos:narrower luc:airports_aerodromes,
        luc:navigation_communication,
        luc:ports_water_transport,
        luc:railways,
        luc:roads ;
    skos:notation "3.6.0" ;
    skos:prefLabel "Transport and communication"@en ;
    skos:usageNote "Zoning of land for roading or rail purposes that has not yet been constructed should be captured as attributes."@en ;
    lu:colour "#72737E" .

mgmt:animal a skos:Collection ;
    skos:inScheme lus:management_practices ;
    skos:member mgmt:barn_laid,
        mgmt:caged,
        mgmt:free_range,
        mgmt:milking_hand,
        mgmt:milking_herringbone,
        mgmt:milking_rotary,
        mgmt:milking_walk_through ;
    skos:prefLabel "Animal"@en .

mgmt:crop a skos:Collection ;
    skos:inScheme lus:management_practices ;
    skos:member mgmt:biodynamic,
        mgmt:contour_banks,
        mgmt:controlled_traffic_farming,
        mgmt:crop_pasture_rotation,
        mgmt:cropping_continuous,
        mgmt:cropping_cover,
        mgmt:cropping_multiple,
        mgmt:cropping_opportunistic,
        mgmt:cropping_rotational,
        mgmt:cropping_row_alley,
        mgmt:cropping_strip,
        mgmt:fallow_chemical,
        mgmt:fallow_mechanical,
        mgmt:organic,
        mgmt:pasture_cropping,
        mgmt:precision_agriculture,
        mgmt:residues_baled,
        mgmt:residues_burnt,
        mgmt:residues_heavily_grazed,
        mgmt:residues_incorporated,
        mgmt:residues_intact,
        mgmt:residues_mulched,
        mgmt:tillage_conservation,
        mgmt:tillage_conventional ;
    skos:prefLabel "Crop"@en .

mgmt:grazing a skos:Collection ;
    skos:inScheme lus:management_practices ;
    skos:member mgmt:grazing_rotational,
        mgmt:grazing_set_stocking,
        mgmt:grazing_tactical ;
    skos:prefLabel "Grazing"@en .

mgmt:horticulture a skos:Collection ;
    skos:inScheme lus:management_practices ;
    skos:member mgmt:free_standing,
