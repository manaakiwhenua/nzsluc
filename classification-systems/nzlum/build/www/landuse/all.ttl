luc:abattoirs a skos:Concept ;
    skos:broader luc:manufacturing_industrial ;
    skos:definition "Areas with specialised improvements for the slaughter of stock and the preparation of meat for the wholesale market."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.4.6" ;
    skos:prefLabel "Abattoirs"@en .

luc:aquaculture a skos:Concept ;
    skos:broader luc:intensive_animal_production ;
    skos:definition "Controlled cultivation of aquatic organisms (e.g. fish, molluscs, algae) in natural or artificial environments, typically for food production, but also for stock feeds, pharmaceutical uses, biofuels, etc."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.6.5" ;
    skos:prefLabel "Aquaculture"@en .

luc:arable_cropping a skos:Concept ;
    skos:broader luc:short_rotation_seasonal_cropping ;
    skos:definition "Predominantly grain, seed, or fodder crops (and over time may include vegetable rotations). May be used for dairy support."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.3.1" ;
    skos:prefLabel "Arable cropping"@en ;
    skos:usageNote "The specific commodity or commodities should be noted if known."@en .

luc:arable_mixed_livestock_cropping a skos:Concept ;
    skos:broader luc:short_rotation_seasonal_cropping ;
    skos:definition "Predominantly grain, seed, or fodder crops; over time it may include short-term (c. 1–3 years) pasture and livestock rotations, and/or vegetable rotations. Pasture and livestock rotations may occur less than 50% of the time.."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.3.2" ;
    skos:prefLabel "Arable and mixed livestock cropping"@en ;
    skos:scopeNote "Includes maize, barley, wheat, peas, other grain and seed crops, and fodder crops. May be used for dairy support (which should be recorded as a management practice, if this is known)."@en ;
    skos:usageNote "The specific commodity or commodities should be noted if known."@en .

luc:brownfield_development a skos:Concept ;
    skos:broader luc:vacant_transitioning_land_urban ;
    skos:changeNote "Notation changed from 3.9.3 to 3.9.1 at v0.4.0" ;
    skos:definition "Areas of active redevelopment of previously developed (often industrial) land that may be abandoned, contaminated, or under-utilised, to rehabilitate and repurpose sites for new urban activities."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.9.1" ;
    skos:prefLabel "Brownfield development"@en ;
    skos:scopeNote "May include residential areas undergoing infill development that increase housing density."@en .

luc:carbon_forest_retained a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "Retained (non-planted) indigenous vegetation set aside for carbon credits."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.3.8" ;
    skos:prefLabel "Carbon forest"@en .

luc:community_services a skos:Concept ;
    skos:broader luc:public_recreation_services ;
    skos:definition "Land used for providing essential services and facilities to support the local community."@en ;
    skos:example "Educational institutions, public healthcare facilities, libraries, museums, courts, prisons, civic buildings, emergency services, marae, religious buildings, cemeteries."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.2.3" ;
    skos:prefLabel "Community services"@en ;
    lu:colour "#E09962" .

luc:cultural_heritage a skos:Concept ;
    skos:broader luc:cultural_natural_heritage ;
    skos:definition "Cultural heritage areas (e.g. historical mining sites, selected DOC 'iconic sites', Toru Whenua and other cultural landmarks)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.2.2" ;
    skos:prefLabel "Cultural heritage"@en .

luc:customary_use a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "Natural environments associated with traditional and sustainable Indigenous food-gathering practices (mahinga kai)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.3.5" ;
    skos:prefLabel "Customary use"@en ;
    skos:scopeNote "This may include land zoned for Māori purposes, and should only describe contemporary, not historical, use."@en ;
    skos:usageNote "This is often an ancillary use; assign only if customary use is the prime use of the land."@en .

luc:dairy a skos:Concept ;
    skos:broader luc:grazing_modified_pasture_systems ;
    skos:definition "Land on which milking cows (or other stock, such as goats or sheep) are grazed during the milking season, where dairy is the primary purpose of the land."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.2.1" ;
    skos:prefLabel "Dairy"@en ;
    skos:scopeNote "Dairy production systems can include rotations of grazed forage crops and maize for silage, and dry-stock grazing, but this class should only be used where dairy is the primary purpose of the land."@en,
        "Where the land is permanently used for dry-stock grazing, it should be classified under dry-stock land use."@en ;
    lu:colour "#8D7735" .

luc:defence_land_natural_areas a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "Natural areas allocated to field training, weapons testing, and other field defence uses, predominantly in rural areas."@en ;
    skos:example "Kaipara Air Weapons Range"@en,
        "Waiouru Military Camp"@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.3.6" ;
    skos:prefLabel "Defence land"@en ;
    skos:scopeNote "Areas associated with buildings or more built environments on defence land are captured under an urban class."@en ;
    lu:colour "#FF9E17" .

luc:degraded_land_ag a skos:Concept ;
    skos:broader luc:vacant_and_transitioning_land ;
    skos:changeNote "Changed notation at v0.4.0"@en ;
    skos:definition "Unused land that is degraded through erosion or flood events that is not being rehabilitated."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.8.3" ;
    skos:prefLabel "Degraded land"@en ;
    skos:usageNote "Can include contaminated land."@en .

luc:effluent_pond a skos:Concept ;
    skos:broader luc:water_wastewater_agriculture ;
    skos:definition "Effluent ponds typically associated with dairying."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.7.2" ;
    skos:prefLabel "Effluent pond"@en .

luc:electricity_substations_transmission a skos:Concept ;
    skos:broader luc:utilities ;
    skos:definition "Facilities and infrastructure associated with distribution and transmission of electrical power."@en ;
    skos:example "Substations, transformers, high-voltage transmission towers."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.5.5" ;
    skos:prefLabel "Electricity substations and transmission"@en .

luc:entertainment a skos:Concept ;
    skos:broader luc:commercial ;
    skos:definition "Land areas and facilities offering leisure and recreational activities for public enjoyment."@en ;
    skos:example "Cinemas, theatres, amusement parks, casinos, concert venues."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.3.4" ;
    skos:prefLabel "Entertainment"@en .

luc:environmental_infrastructure_protection a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "Land, usually under vegetative cover, used for non-production or environmental purposes (e.g. prevention of land degradation, windbreaks, shade, shelter). Includes land with a primary purpose of flood management (e.g. stop banks, spillways)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.3.7" ;
    skos:prefLabel "Environmental & infrastructure protection"@en ;
    skos:scopeNote "Land planted for environmental and infrastructure protection should be captured under 2.1.4."@en,
        "This is not limited to indigenous vegetation."@en .

luc:evaporation_basins a skos:Concept ;
    skos:broader luc:mining ;
    skos:definition "Basins and associated facilities used for evaporation of water from irrigation drainage or (predominantly) salt extraction."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.7.4" ;
    skos:prefLabel "Evaporation basins"@en .

luc:exotic_plantation_forestry a skos:Concept ;
    skos:broader luc:plantation_forests ;
    skos:changeNote "Consideration of carbon sequestration and carbon credits were added in NZLUM v0.4.0"@en ;
    skos:definition "An area managed for pulpwood or saw-log production, or for carbon sequestration and carbon credits (exotic species)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.1.1" ;
    skos:prefLabel "Exotic plantation forestry"@en ;
    skos:usageNote "Specific additional attributes that could be captured in comments or supplementary attributes are plantation age, rotation number, and species."@en,
        "The specific commodity or commodities should be noted if known."@en .

luc:extensive_dry_stock a skos:Concept ;
    skos:broader luc:grazing_modified_pasture_systems ;
    skos:definition "Grazing on modified pastures with relatively fewer inputs, lower likelihood of irrigation, and lower stocking rates; more likely on hill, hard-hill, or high-country terrain."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.2.3" ;
    skos:prefLabel "Extensive dry stock"@en ;
    skos:scopeNote "Arable or winter forage crops are unlikely to be common rotations in this land-use category"@en,
        "Grazing livestock other than dairy, sheep or beef should usually be captured in this class (though it does not exclude sheep or beef)"@en,
        "Where there is a high proportion of indigenous vegetation for grazing land, land use should be classified as grazing native vegetation."@en ;
    skos:usageNote "The specific commodity or commodities should be noted if known."@en ;
    lu:colour "#ABA248" .

luc:extractive_industry_not_in_use a skos:Concept ;
    skos:broader luc:mining ;
    skos:definition "Land undergoing rehabilitation after mining activities, and unmined land within a mining permit."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.7.5" ;
    skos:prefLabel "Extractive industry not in use"@en .

luc:farm_buildings_infrastructure a skos:Concept ;
    skos:broader luc:manufacturing_industrial ;
    skos:definition "An area with buildings, sheds, and other infrastructure associated with farm enterprises supporting agricultural operations."@en ;
    skos:example "Barns, silos, storage sheds, and irrigation systems."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.4.5" ;
    skos:prefLabel "Farm buildings/infrastructure"@en ;
    skos:scopeNote "If it is possible to discriminate a domestic area from a farm, the house and adjoining non-productive land should be classified as 3.1.4 Rural residential."@en .

luc:food_processing_factory a skos:Concept ;
    skos:broader luc:manufacturing_industrial ;
    skos:definition "An area where the principal use is food processing, packaging, and preservation. The building is most likely to be purpose built and may have extensive plant and equipment included."@en ;
    skos:example "Cannery; milk production plant." ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.4.2" ;
    skos:prefLabel "Food processing factory"@en .

luc:fuel_powered_electricity_generation a skos:Concept ;
    skos:broader luc:utilities ;
    skos:definition "Facilities that produce electricity by burning fossil fuels such as coal, oil, and natural gas."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.5.1" ;
    skos:prefLabel "Fuel powered electricity generation"@en .

luc:gas_treatment_storage_transmission a skos:Concept ;
    skos:broader luc:utilities ;
    skos:definition "Facilities and infrastructure for processing, storage, and transport of natural gas."@en ;
    skos:example "Treatment plants, storage facilities, pipelines."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.5.6" ;
    skos:prefLabel "Gas treatment, storage, and transmission"@en .

luc:general_purpose_factory a skos:Concept ;
    skos:broader luc:manufacturing_industrial ;
    skos:definition "An area used for manufacturing, assembly, or repairs of various products."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.4.1" ;
    skos:prefLabel "General purpose factory"@en ;
    skos:scopeNote "Includes some specialised or purpose-built machinery and equipment for mass production across multiple industries."@en .

luc:glasshouses_shadehouses a skos:Concept ;
    skos:broader luc:intensive_horticulture ;
    skos:definition "Controlled-environment structures for protected cultivation of plants, including vegetable and floriculture production."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.5.2" ;
    skos:prefLabel "Glasshouses/shadehouses"@en ;
    skos:scopeNote "Glasshouses provide a transparent enclosure, typically made of glass or plastic, allowing natural sunlight to penetrate while shielding plants from adverse weather conditions. Shadehouses utilise shade cloth or netting to regulate light exposure and temperature levels. These structures enable year-round production of a wide variety of crops, including vegetables, herbs, flowers, and ornamental plants."@en .

luc:grazing_native_vegetation a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "Land uses based on grazing by domestic stock on native vegetation where there has been limited or no deliberate attempt at pasture modification (e.g. native tussock grazing). Some change in species composition may have occurred."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.3.3" ;
    skos:prefLabel "Grazing native vegetation"@en ;
    skos:usageNote "This is probably limited to South Island high-country farms. Verification (e.g. assessment of vegetation on grazed land) to assess the extent of modification is required. ALUM specifies this class when there is greater than 50% dominant native species, although this criterion needs to be confirmed as being appropriate in a New Zealand context."@en .

luc:greenfield_development a skos:Concept ;
    skos:broader luc:vacant_transitioning_land_urban ;
    skos:definition "Previously undeveloped or agricultural land zoned for or undergoing new construction projects or urban expansion, involving conversion of rural or natural areas into built uses."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.9.2" ;
    skos:prefLabel "Greenfield development"@en .

luc:ground_water a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "An area managed as an aquifer recharge zone."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.3.2" ;
    skos:prefLabel "Ground water"@en .

luc:habitat_or_species_management a skos:Concept ;
    dcterms:source "IUCN (2008) Protected Areas Management Categories, Category IV: Habitat/Species Management Area."@en ;
    skos:broader luc:nature_cons ;
    skos:definition "Protected area managed mainly for conservation through management intervention. An area of land or sea subject to active intervention for management purposes to ensure the maintenance of habitats or to meet the requirements of specific species. This may include areas on private land."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.1.5" ;
    skos:prefLabel "Habitat or species management area"@en ;
    lu:colour "#C9CAE3" .

luc:healthcare a skos:Concept ;
    skos:broader luc:commercial ;
    skos:definition "Land dedicated to providing private medical services aimed at diagnosis, treatment, and prevention of illness or injury."@en ;
    skos:example "Hospitals, specialist clinics, physiotherapists, medical offices, laboratories"@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.3.5" ;
    skos:prefLabel "Healthcare"@en .

luc:high_density_residential a skos:Concept ;
    skos:broader luc:residential ;
    skos:definition "Areas characterised by a high concentration of housing units per unit of land area, typically in multi-storey buildings or high-rise developments, often found in urban centres supporting high population density."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.1.1" ;
    skos:prefLabel "High-density residential"@en ;
    lu:colour "#4C3B39" .

luc:horse_studs a skos:Concept ;
    skos:broader luc:intensive_animal_production ;
    skos:definition "Establishments focused on the breeding and raising of horses."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.6.4" ;
    skos:prefLabel "Horse studs"@en ;
    skos:usageNote "Applies to the intensive part of horse studs; relatively more extensive and pastoral aspects are not included."@en .

luc:hospitality a skos:Concept ;
    skos:broader luc:commercial ;
    skos:definition "Land and buildings providing accommodation, food, and beverage services to the public."@en ;
    skos:example "Hotels, motels, resorts, bed and breakfast establishments, restaurants, bars, nightclubs."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.3.3" ;
    skos:prefLabel "Hospitality"@en .

luc:hydroelectricity_generation a skos:Concept ;
    skos:broader luc:utilities ;
    skos:definition "Facilities that use the energy of flowing or falling water (typically hydroelectric dams) to generate electricity."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.5.2" ;
    skos:prefLabel "Hydroelectricity generation"@en ;
    skos:scopeNote "Includes canals and other water conveyance infrastructure associated with hydroelectricity generation."@en .

luc:indigenous_cultural_heritage a skos:Concept ;
    skos:broader luc:cultural_natural_heritage ;
    skos:definition "Indigenous cultural heritage sites and areas (e.g. historical pā sites, New Zealand land wars sites, and other indigenous heritage sites)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.2.1" ;
    skos:prefLabel "Indigenous cultural heritage"@en .

luc:indigenous_plantation_forestry a skos:Concept ;
    skos:broader luc:plantation_forests ;
    skos:changeNote "Consideration of carbon sequestration and carbon credits were added in NZLUM v0.4.0"@en ;
    skos:definition "An area managed for pulpwood or saw-log production, or for carbon sequestration and carbon credits (native species)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.1.2" ;
    skos:prefLabel "Indigenous plantation forestry"@en ;
    skos:usageNote "Specific additional attributes that could be captured in comments or supplementary attributes are plantation age, rotation number, and species."@en,
        "The specific commodity or commodities should be noted if known."@en .

luc:indoor_recreation a skos:Concept ;
    skos:broader luc:public_recreation_services ;
    skos:definition "Facilities designed for recreational activities conducted within enclosed or semi-enclosed structures."@en ;
    skos:example "Sports centres, gyms, swimming pools, indoor arenas."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.2.2" ;
    skos:prefLabel "Indoor recreation"@en ;
    lu:colour "#958273" .

luc:intensive_animal_containment a skos:Concept ;
    skos:broader luc:intensive_animal_production ;
    skos:definition "Facilities or systems designed to confine and manage animals, including feed lots, pens, dairy sheds and yards, and herd homes, where animals are raised intensively for meat production or other purposes."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.6.1" ;
    skos:prefLabel "Intensive animal containment"@en .

luc:intensive_dry_stock a skos:Concept ;
    skos:broader luc:grazing_modified_pasture_systems ;
    skos:changeNote <https://github.com/manaakiwhenua/nzsluc/issues/66>,
        "A prior definition of this classes treated deer, goats, and horses as extensive by definition; it is now recogised that such systems can also be intensive."@en ;
    skos:definition "Non-milking platform grazing land with higher inputs (e.g. fertiliser), higher likelihood of irrigation, and higher stocking rates; typically on flat or rolling terrain."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.2.2" ;
    skos:prefLabel "Intensive dry stock"@en ;
    skos:scopeNote "Land used for high-intensity dry-stock grazing may include rotations for arable or winter forage crops, as well as grazing of non-lactating (dry) dairy cattle, beef cattle, sheep, and cattle breeding."@en ;
    skos:usageNote "Stock density is an ideal attribute to assist in classification of intensive vs extensive dry stock; physiography (i.e. flat/hill/high country) can be used as a proxy where stock density data is absent."@en ;
    lu:colour "#357735" .

luc:irrigation_reservoirs_canals a skos:Concept ;
    skos:broader luc:water_wastewater_agriculture ;
    skos:definition "Land used for water storage, management, or distribution intended for agricultural purposes; areas allocated for irrigation for agricultural purposes."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.7.5" ;
    skos:prefLabel "Irrigation reservoirs and canals"@en .

luc:land_undergoing_rehabilitation_ag a skos:Concept ;
    owl:deprecated true ;
    skos:broader luc:land_in_transition_agriculture ;
    skos:definition "Land in the process of rehabilitation for agricultural production (e.g. after significant flooding), and which is actively being recovered."@en ;
    skos:historyNote "Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0."@en ;
    skos:inScheme lus:nzlum0.3.0 ;
    skos:notation "2.8.3" ;
    skos:prefLabel "Land undergoing rehabilitation"@en .

luc:land_undergoing_rehabilitation_natural a skos:Concept ;
    owl:deprecated true ;
    skos:broader luc:unused_land_transition ;
    skos:definition "Degraded land (e.g. due to erosion or flood damage) that is being actively rehabilitated through planting with indigenous or exotic species to return land to a natural state (including riparian plantings)."@en ;
    skos:historyNote "Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0."@en ;
    skos:inScheme lus:nzlum0.3.0 ;
    skos:notation "1.4.2" ;
    skos:prefLabel "Land undergoing rehabilitation"@en .

luc:landfills a skos:Concept ;
    skos:broader luc:waste_treatment_disposal ;
    skos:definition "Designated areas for disposal of solid waste, where waste materials are deposited, compacted, and covered to reduce contamination and control emissions."@en ;
    skos:example "Landfills designed to receive inert construction materials." ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.8.1" ;
    skos:prefLabel "Landfills"@en ;
    skos:scopeNote "Includes all class 1 to 5 landfills"@en,
        "Landfill gas recovery systems are classified as part of a landfill land use."@en .

luc:low_density_residential a skos:Concept ;
    skos:broader luc:residential ;
    skos:definition "Residential properties within urban boundaries that fall within large-lot or low-density residential zones and are often single-family, one- to two- storey houses with yards and landscaping and lower population density."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.1.3" ;
    skos:prefLabel "Low-density residential"@en ;
    lu:colour "#815E5B" .

luc:major_industrial_complex a skos:Concept ;
    skos:broader luc:manufacturing_industrial ;
    skos:definition "An area with large-scale industrial use and significant infrastructure ."@en ;
    skos:example "Car plant, paper mill."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.4.3" ;
    skos:prefLabel "Major industrial complex"@en .

luc:medium_density_residential a skos:Concept ;
    skos:broader luc:residential ;
    skos:definition "Areas featuring a moderate concentration of housing units per unit of land area, often in suburban or semi-urban settings."@en ;
    skos:example "Townhouses, terraced housing, low-rise apartments."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.1.2" ;
    skos:prefLabel "Medium-density residential"@en ;
    skos:scopeNote "Alignment to the Medium Density Residential Standards (MfE 2022) should be considered."@en ;
    lu:colour "#644E4C" .

luc:mines a skos:Concept ;
    skos:broader luc:mining ;
    skos:definition "Land from which minerals, precious stones or coal is being extracted, including open-cut and deep-shaft mines."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.7.1" ;
    skos:prefLabel "Mines"@en .

luc:municipal_wastewater a skos:Concept ;
    skos:broader luc:waste_treatment_disposal ;
    skos:definition "Wastewater generated from residential, commercial, and industrial activities within urban areas requiring treatment before discharge or reuse; includes municipal wastewater ponds and sewerage pipelines."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.8.3" ;
    skos:prefLabel "Municipal wastewater"@en .

luc:national_park a skos:Concept ;
    dcterms:source "IUCN (2008) Protected Areas Management Categories, Category Ib: national park."@en ;
    skos:broader luc:nature_cons ;
    skos:definition """Protected area managed mainly for ecosystem conservation and recreation. A natural area of land, designated to:

  a) protect the ecological integrity of one or more ecosystems for the current and future generations;

  b) exclude exploitation or occupation detrimental to the purposes of designation of the area; and

  c) provide a foundation for spiritual, scientific, educational, recreational and visitor opportunities, all of which must be environmentally and culturally compatible."""@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.1.3" ;
    skos:prefLabel "National Park"@en ;
    lu:colour "#7C76B6" .

luc:natural_feature_protection a skos:Concept ;
    dcterms:source "IUCN (2008) Protected Areas Management Categories, Category III: Natural Monument or Feature."@en ;
    skos:broader luc:nature_cons ;
    skos:definition "Protected area managed for conservation of specific natural features. An area containing one or more specific natural or cultural features that are of outstanding value because of their inherent rarity, representative or aesthetic qualities, or cultural significance."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.1.4" ;
    skos:prefLabel "Natural feature protection"@en ;
    lu:colour "#A39FCB" .

luc:natural_heritage a skos:Concept ;
    skos:broader luc:cultural_natural_heritage ;
    skos:definition "Protected areas for the conservation of specific natural features and landscapes (e.g. UNESCO Global Geoparks)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.2.3" ;
    skos:prefLabel "Natural heritage"@en .

luc:office a skos:Concept ;
    skos:broader luc:commercial ;
    skos:definition "Land and buildings primarily used for administrative, professional, or managerial activities."@en ;
    skos:example "Corporate offices, professional services, banks, government buildings, business parks, coworking spaces."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.3.2" ;
    skos:prefLabel "Office"@en .

luc:other_conserved_area a skos:Concept ;
    skos:broader luc:nature_cons ;
    skos:definition "Land under forms of nature conservation protection that fall outside the scope of the CAPAD classification. This includes heritage agreements, voluntary conservation arrangements, registered property agreements, and recreation areas with primarily native cover ."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.1.7" ;
    skos:prefLabel "Other conserved area"@en ;
    skos:scopeNote "If the recreation area is primarily cleared or non-native cover assign to 3.2.1 ‘Outdoor recreation’" ;
    lu:colour "#FCFBFD" .

luc:other_perennial_horticulture a skos:Concept ;
    skos:broader luc:perennial_horticulture ;
    skos:definition "Perennial plants beyond tree crops and vine fruits, such as berries (e.g. strawberries, blueberries), perennial herbs (e.g. lavender, rosemary), and ornamental perennials (e.g. roses, lilies)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.4.3" ;
    skos:prefLabel "Other perennial horticulture"@en .

luc:other_production_plantations a skos:Concept ;
    skos:broader luc:plantation_forests ;
    skos:definition "An area managed for non-pulpwood production, including oil, wildflowers, and honey plantations."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.1.3" ;
    skos:prefLabel "Other production uses"@en ;
    skos:usageNote "The specific commodity or commodities should be noted if known."@en .

luc:outdoor_recreation a skos:Concept ;
    skos:broader luc:public_recreation_services ;
    skos:definition "Land areas dedicated to leisure activities conducted in natural or semi-natural settings, typically with considerable unsealed vegetated areas."@en ;
    skos:example "Parks, trails, sportsgrounds, camping grounds, zoos, botanic gardens, recreational reserves."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.2.1" ;
    skos:prefLabel "Outdoor recreation"@en ;
    skos:scopeNote "Parks or reserves with a high level of native bush or that are protected areas should be classified under class 1."@en,
        "The specific identification of this land is intended to enable more ready identification of urban green space. However, this category may also be used to identify developed recreational areas that fall outside urban boundaries, such as mountain-bike parks."@en ;
    lu:colour "#C19878" .

luc:piggeries a skos:Concept ;
    skos:broader luc:intensive_animal_production ;
    skos:definition "Facilities designed for the intensive rearing of pigs."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.6.3" ;
    skos:prefLabel "Piggeries"@en .

luc:planted_environmental_infrastructure_protection a skos:Concept ;
    skos:broader luc:plantation_forests ;
    skos:definition "An area managed for environmental and indirect production uses (e.g. prevention of land degradation, windbreaks, shade, and shelter) where trees or shrubs have been planted."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.1.4" ;
    skos:prefLabel "Planted environmental & infrastructure protection"@en .

luc:poultry_farms a skos:Concept ;
    skos:broader luc:intensive_animal_production ;
    skos:definition "Specialised dacilities dedicated to the intensive production of domestic fowl (e.g. chickens, turkeys, ducks, geese) for meat or egg production."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.6.2" ;
    skos:prefLabel "Poultry farms"@en .

luc:production_from_indigenous_vegetation a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:changeNote "The definition of this class was clarified in NZLUM v0.4.0 by explicitly referring to non-plantation native forests."@en ;
    skos:definition "Commercial production from retained (non-plantation) native forests and related activities on public and private land (e.g. selective native timber production without clearfelling, and other non-sawlong, non-pulpwood, native forest products including oil, wildflowers, firewood, fenceposts, and mānuka/kānuka honey)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.3.4" ;
    skos:prefLabel "Production from indigenous vegetation"@en .

luc:production_nurseries a skos:Concept ;
    skos:broader luc:intensive_horticulture ;
    skos:definition "Specialised intensive horticultural facilities dedicated to propagating and growing plants for commercial purposes (outdoor or under cover)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.5.1" ;
    skos:prefLabel "Production nurseries"@en ;
    skos:scopeNote "Nurseries may be outdoor (exposed) or under cover. Production nurseries may employ advanced techniques such as grafting, tissue culture, and controlled environment systems to optimise plant growth and quality."@en,
        "These nurseries focus on cultivating a wide range of plant species, including ornamentals, fruit trees, and shrubs, typically for landscaping, reforestation, or ornamental purposes."@en .

luc:protected_landscape a skos:Concept ;
    dcterms:source "IUCN (2008) Protected Areas Management Categories, Category V: Protected Landscape/Seascape."@en ;
    skos:broader luc:nature_cons ;
    skos:definition "Protected area managed mainly for landscape conservation and recreation. An area of land where the interaction of people and nature over time has produced a distinct character with significant aesthetic, cultural or ecological value, and often high biodiversity."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.1.6" ;
    skos:prefLabel "Protected landscape"@en ;
    lu:colour "#E9E8F2" .

luc:quarries a skos:Concept ;
    skos:broader luc:mining ;
    skos:definition "Land from which stone, gravel, clay, slate, sand, soil, rock, or other construction materials are being extracted."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.7.2" ;
    skos:prefLabel "Quarries"@en .

luc:rehabilitating_land a skos:Concept ;
    skos:broader luc:unused_and_transitioning ;
    skos:changeNote <https://github.com/manaakiwhenua/nzsluc/issues/36> ;
    skos:definition "Degraded land (e.g. due to erosion or flood damage) that is being actively rehabilitated through planting with indigenous or exotic species to return land to a natural state."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.4.1" ;
    skos:prefLabel "Rehabilitating land"@en ;
    skos:scopeNote "This may include riparian plantings."@en .

luc:rehabilitating_land_ag a skos:Concept ;
    skos:broader luc:vacant_and_transitioning_land ;
    skos:changeNote "Changed notation at v0.4.0" ;
    skos:definition "Land in the process of rehabilitation for agricultural production (e.g. after significant flooding), and which is actively being recovered."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.8.1" ;
    skos:prefLabel "Rehabilitating land"@en .

luc:retail a skos:Concept ;
    skos:broader luc:commercial ;
    skos:definition "Areas used for the sale of goods and services directly to consumers."@en ;
    skos:example "Shops, supermarkets, shopping malls, convenience stores, suburban dairies, and other retail outlets."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.3.1" ;
    skos:prefLabel "Retail"@en .

luc:rural_residential a skos:Concept ;
    skos:broader luc:residential ;
    skos:definition "Residential properties with low-intensity (non-commercial) land management practices on land in rural or peri-urban areas."@en ;
    skos:historyNote "In land fragmentation analyses, parcels greater than 2 ha in size (with or without a dwelling) have been considered non-residential. The term lifestyle is disfavoured in this context, as it is not a landuse but rather it indicates that some form of primary production does occur but that it is not the resident's primary source of income. Thus the term 'lifestyle' reflects a motivation for a particular land use, but is not itself a useful land use."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.1.4" ;
    skos:prefLabel "Rural residential"@en ;
    skos:scopeNote "Typically featuring larger parcel sizes amidst agricultural or natural surroundings. Concordant with the ‘Rural lifestyle zone’ from the Zone Framework Standard."@en ;
    skos:usageNote "As a general guideline, properties with a dwelling, and between 0.4 ha and 2 ha in size, should be considered rural residential. Larger properties should be considered under class 2, especially if the zone context is non-residential, and even if they are declared residential or lifestyle in the District Valuation Roll."@en,
        "Properties in this size interval and without a dwelling could be in transition to residential."@en ;
    lu:colour "#A87A76" .

luc:sawmill a skos:Concept ;
    skos:broader luc:manufacturing_industrial ;
    skos:definition "An area with special improvements for the processing (milling and curing) of raw timber, wood products, and by-products."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.4.4" ;
    skos:prefLabel "Sawmill"@en .

luc:seasonal_flowers_bulbs_turf a skos:Concept ;
    skos:broader luc:short_rotation_seasonal_cropping ;
    skos:definition "Cultivation of seasonal ornamental flowers, bulbs, and turf grass for commercial purposes."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.3.4" ;
    skos:prefLabel "Seasonal flowers and bulbs, and turf farming"@en ;
    skos:scopeNote "This class encompasses activities such as the cultivation of flowers and bulbs for seasonal markets, landscaping, and turf-farming for sports fields, lawns, and recreational areas."@en .

luc:short_rotation_horticulture a skos:Concept ;
    skos:broader luc:short_rotation_seasonal_cropping ;
    skos:definition "Crop plants living for less than 2 years that are intensively cultivated; predominantly rotations of vegetable crops or seasonal fruits grown for human consumption."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.3.3" ;
    skos:prefLabel "Short-rotation horticulture"@en ;
    skos:scopeNote "May include livestock rotations, but this is considered less likely"@en ;
    skos:usageNote "The specific commodity or commodities should be noted if known."@en .

luc:smallholder_farm a skos:Concept ;
    skos:broader luc:production_agriculture_plantations ;
    skos:changeNote "Added at v0.4.0 to capture the gap between 3.1.4 Rural residential (0.4–2 ha) and commercial pastoral classes (2.2.0)."@en ;
    skos:definition "A rural property larger than a rural residential property (> 2 ha) but where the primary motivation is still residential rather than commercial agricultural production, and where any land management is low-intensity and incidental to the residential occupation."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.9.0" ;
    skos:prefLabel "Smallholder farm"@en ;
    skos:scopeNote "Extends 3.1.4 Rural residential to properties that exceed the lifestyle block size threshold but retain distinctive residential/lifestyle character. Distinguishable from 2.2.0 Grazing modified pasture systems by the absence of commercial pastoral intent and the relatively low level of active land management."@en,
        "Properties classified here may carry small numbers of stock or maintain informal pasture, but these activities are subsidiary to the residential use of the land."@en ;
    skos:usageNote "As a subclass of 2.0.0, commodities and management practices may still be recorded."@en,
        "Typical evidence: NDVR lifestyle codes (property uses 21 single-unit lifestyle, 22 multi-unit lifestyle) or possibly category L with land area in the range 2–40 ha. Properties substantially exceeding 40 ha with lifestyle NDVR codes should typically be excluded, in favour of classification under 2.2.2 or 2.2.3."@en ;
    lu:colour "#E5D64F" .

luc:solar_electricity_generation a skos:Concept ;
    skos:broader luc:utilities ;
    skos:definition "Facilities that harness sunlight using photovoltaic cells or solar thermal systems to generate electricity."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.5.4" ;
    skos:prefLabel "Solar electricity generation"@en .

luc:stock_water a skos:Concept ;
    skos:broader luc:water_wastewater_agriculture ;
    skos:definition "Reservoirs or farm dams on agricultural land for the purpose of supplying drinking-water for stock."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.7.1" ;
    skos:prefLabel "Stock water"@en .

luc:stormwater_management a skos:Concept ;
    skos:broader luc:waste_treatment_disposal ;
    skos:definition "Infrastructure aimed at controlling and mitigating stormwater runoff to prevent flooding, erosion, and pollution."@en ;
    skos:example "Detention basins, drainage systems, retention ponds, rain gardens, wetlands."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.8.5" ;
    skos:prefLabel "Stormwater management"@en .

luc:strict_nature_res a skos:Concept ;
    dcterms:source "IUCN (2008) Protected Areas Management Categories, Category Ia: strict nature reserve."@en ;
    skos:broader luc:nature_cons ;
    skos:definition "Protected area managed mainly for science. An area of land possessing outstanding or representative ecosystems, geological or physiological features or species, which is available primarily for scientific research and/or environmental monitoring."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.1.1" ;
    skos:prefLabel "Strict nature reserve"@en ;
    lu:colour "#5E3A98" .

luc:surface_water_supply a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "An area managed as a catchment for water supply."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.3.1" ;
    skos:prefLabel "Surface water supply"@en .

luc:tailings a skos:Concept ;
    skos:broader luc:mining ;
    skos:definition "Tailings dumps and dams for storage or treatment of waste material left over after extraction, often stored in containment facilities or ponds (including quarrying output)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.7.3" ;
    skos:prefLabel "Tailings"@en .

luc:transfer_stations_recycling a skos:Concept ;
    skos:broader luc:waste_treatment_disposal ;
    skos:definition "Facilities where solid waste is collected, sorted, processed, and prepared for recycling or transfer to landfills or other disposal sites."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.8.2" ;
    skos:prefLabel "Transfer stations and recycling facilities"@en .

luc:transportation_warehousing_commercial a skos:Concept ;
    skos:broader luc:commercial ;
    skos:definition "Privately owned land associated with the movement and storage of goods, including distribution centres, warehouses, logistics facilities, car dealerships, and commercial parking lots."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.3.6" ;
    skos:prefLabel "Transportation & warehousing"@en ;
    skos:scopeNote "Excludes airports, ports, roads, and train stations (captured under 3.6.0)"@en .

luc:tree_crops a skos:Concept ;
    skos:broader luc:perennial_horticulture ;
    skos:definition "Long-term cultivated plants, typically trees or woody shrubs, grown for fruits, nuts, or other edible parts. These crops require intensive management practices aimed at ensuring optimal growth, productivity, and quality over multiple years."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.4.1" ;
    skos:prefLabel "Tree crops"@en ;
    skos:usageNote "Examples include orchard fruits such as olives, apples, oranges, and apricots, as well as tree nuts such as hazelnuts, macadamias, and chestnuts, which should be recorded in the commodity attribute, if known."@en,
        "Management practices may include pruning, pest and disease control, irrigation, and harvesting techniques specific to tree crops."@en .

luc:unused_degraded_land_ag a skos:Concept ;
    owl:deprecated true ;
    skos:broader luc:land_in_transition_agriculture ;
    skos:definition "Unused land that is degraded through erosion or flood events that is not being rehabilitated."@en ;
    skos:historyNote "Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0."@en ;
    skos:inScheme lus:nzlum0.3.0 ;
    skos:notation "2.8.1" ;
    skos:prefLabel "Unused degraded land"@en ;
    skos:usageNote "Can include contaminated land."@en .

luc:unused_land_transition a skos:Concept ;
    owl:deprecated true ;
    skos:broader luc:conservation ;
    skos:definition "Corridors and roadside areas may fit under this class, along with unused land (in the sense of productive, conservation or urban use), such as cliffs, rock faces, boulders, and tors, where there are relatively low levels of disturbance. It does not include land undergoing natural succession in the context of changing plant species."@en ;
    skos:historyNote "Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0."@en ;
    skos:inScheme lus:nzlum0.3.0 ;
    skos:narrower luc:land_undergoing_rehabilitation_natural,
        luc:unused_land ;
    skos:notation "1.4.0" ;
    skos:prefLabel "Unused land and land in transition"@en ;
    skos:usageNote "Delineation between indigenous and exotic vegetation for the minimal use and unused land and land in transition classes can be made by reference to land-cover information."@en ;
    lu:colour "#C8C69F" .

luc:vacant_land a skos:Concept ;
    skos:broader luc:vacant_transitioning_land_urban ;
    skos:changeNote "Notation changed from 3.9.1 to 3.9.3 at v0.4.0" ;
    skos:definition "Derelict land and developed land that is idle."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.9.3" ;
    skos:prefLabel "Idle and derelict land"@en .

luc:vine_fruits a skos:Concept ;
    skos:broader luc:perennial_horticulture ;
    skos:definition "Fruit-bearing plants that grow on vines or trailing stems, often requiring support structures (e.g. trellises, arbours). These plants produce fruits that typically hang from vines and may include grapes, kiwifruit, and passionfruit. Vine fruit cultivation involves specific management practices such as pruning, training, trellising, and pest and disease control specific to vine plants."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.4.2" ;
    skos:prefLabel "Vine fruits"@en .

luc:wastewater_treatment_land_application a skos:Concept ;
    skos:broader luc:waste_treatment_disposal ;
    skos:definition "Areas where treated municipal wastewater is applied onto land for beneficial reuse, following appropriate treatment processes to ensure environmental safety."@en ;
    skos:example "Irrigation, groundwater recharge, soil fertility enhancement."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.8.4" ;
    skos:prefLabel "Wastewater treatment – land application"@en ;
    skos:usageNote " This is often likely to be an ancillary use."@en .

luc:water_extraction_transmission a skos:Concept ;
    skos:broader luc:utilities ;
    skos:definition "Facilities and infrastructure for extracting, purifying, treating, and transporting water from natural sources to meet human needs."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.5.7" ;
    skos:prefLabel "Water extraction and transmission"@en ;
    skos:scopeNote "Includes drinking water reservoirs."@en .

luc:water_treatment_land_application a skos:Concept ;
    skos:broader luc:water_wastewater_agriculture ;
    skos:definition "Land used for effluent disposal"@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.7.3" ;
    skos:prefLabel "Water treatment – land application"@en ;
    skos:scopeNote "probably an ancillary use where some form of grazing is the primary use."@en .

luc:water_treatment_wetland a skos:Concept ;
    skos:broader luc:water_wastewater_agriculture ;
    skos:definition "Constructed or natural wetlands used to improve water quality prior to discharge."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.7.4" ;
    skos:prefLabel "Water treatment – wetland"@en .

luc:wilderness a skos:Concept ;
    dcterms:source "IUCN (2008) Protected Areas Management Categories, Category Ib: wilderness area."@en ;
    skos:broader luc:nature_cons ;
    skos:definition "Protected area managed mainly for wilderness protection. A large area of unmodified or slightly modified land, retaining its natural character and influence, without permanent or significant habitation, which is protected and managed so as to preserve its natural condition."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.1.2" ;
    skos:prefLabel "Wilderness area"@en ;
    lu:colour "#3F007D" .

luc:wind_electricity_generation a skos:Concept ;
    skos:broader luc:utilities ;
    skos:definition "Power generation from wind, including wind farms."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.5.3" ;
    skos:prefLabel "Wind electricity generation"@en .

lu_person:kingi_tawhiao a foaf:Person ;
    foaf:name "Kīngi Tāwhiao"@mi,
        "Tūkaroto Matutaera Pōtatau Te Wherowhero Tāwhiao"@mi .

lu_proverb:kotahi_te_aho a dcterms:BibliographicResource ;
    dcterms:creator lu_person:kingi_tawhiao ;
    dcterms:description "One strand of flax is easy to break, but many strands together will stand strong."@en,
        "Kotahi te aho ka whati, ki te kāpuia e kore e whati."@mi .

