    skos:inScheme lus:management_practices ;
    skos:notation "trellis/espalier" .

lus:nzlum0.4.1 a skos:ConceptScheme ;
    dcterms:created "2026-10-29"^^xsd:date ;
    dcterms:isVersionOf lus:nzlum ;
    owl:versionInfo "0.4.1" ;
    skos:changeNote "Draft. Assigns an lu:colour to every class (80 classes had none in 0.4.0) and revises 20 existing colours so that each secondary owns one hue, tertiaries form a lightness ladder within it, and true blue is left free for the water attribute. No codes, labels or definitions change."@en ;
    skos:hasTopConcept luc:built_environment,
        luc:conservation,
        luc:production_agriculture_plantations ;
    adms:status lu_status:draft .

lu_status:draft a rdfs:Resource ;
    rdfs:label "Draft"@en .

lu_status:published a rdfs:Resource ;
    rdfs:label "Published"@en .

lu_status:superseded a rdfs:Resource ;
    rdfs:label "Superseded"@en .

ns1:nzsluc a doap:GitRepository ;
    doap:browse ns1:nzsluc .

com:pears a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "pears" .

luc:abandoned_land_ag a skos:Concept ;
    skos:broader luc:vacant_and_transitioning_land ;
    skos:changeNote "Changed notation at v0.4.0"@en ;
    skos:definition "Land where a previous pattern of agriculture may be observed but that is not currently under production, but not due to physical land degradation."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.8.2" ;
    skos:prefLabel "Abandoned land"@en .

luc:airports_aerodromes a skos:Concept ;
    skos:broader luc:transport ;
    skos:definition "Locations from which aircraft flight operations take place, including areas used for the accommodation of aircraft and coordination of air cargo or passengers (including heliports)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.6.1" ;
    skos:prefLabel "Airports/aerodromes"@en .

luc:land_in_transition_agriculture a skos:Concept ;
    owl:deprecated true ;
    skos:broader luc:production_agriculture_plantations ;
    skos:definition "As a subclass of Production agriculture and plantations, land must recently have been used for agriculture or plantations."@en ;
    skos:historyNote "Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0."@en ;
    skos:inScheme lus:nzlum0.3.0 ;
    skos:narrower luc:abandoned_land_ag,
        luc:land_undergoing_rehabilitation_ag,
        luc:no_defined_use_ag,
        luc:unused_degraded_land_ag ;
    skos:notation "2.8.0" ;
    skos:prefLabel "Land in transition"@en ;
    skos:scopeNote "In the case of greenfield development where land use is transitioning to a built-environment category, classify under 3.9.0 Vacant and transitioning land (or a subclass) rather than 2.8.0."@en ;
    lu:colour "#BCBFE1" .

luc:navigation_communication a skos:Concept ;
    skos:broader luc:utilities ;
    skos:changeNote <https://github.com/manaakiwhenua/nzsluc/issues/69>,
        "Notation changed from 3.6.5 to 3.5.8 at v0.4.0 when class 3.6.0 redefined to exclude navigation and communication infrastructure."@en ;
    skos:definition "Navigation and communication infrastructure."@en ;
    skos:example "Radar stations, beacons, lighthouses, TV and radio transmission towers."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.5.8" ;
    skos:prefLabel "Navigation and communication"@en .

luc:no_defined_use_ag a skos:Concept ;
    skos:broader luc:vacant_and_transitioning_land ;
    skos:changeNote "Changed notation at v0.4.0"@en ;
    skos:definition "Land cleared of vegetation where the current proposed land use is unknown."@en ;
    skos:example "Land being prepared for new primary production use (farms, mines, etc.) but where the precise nature of the proposed land use is unknown."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.8.4" ;
    skos:prefLabel "No defined use"@en .

luc:ports_water_transport a skos:Concept ;
    skos:broader luc:transport ;
    skos:definition "Harbour locations where ships dock to transfer people or cargo, including terrestrial parts and designated marine areas that are specifically designated and controlled for activities associated with the port."@en ;
    skos:example "Harbours, navigational channels."@en,
        "Ports, docks, and wharves."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.6.4" ;
    skos:prefLabel "Ports and water transport"@en ;
    skos:usageNote "The water attribute can be used to differentiate the terrestrial and marine parts of the same facility."@en .

luc:railways a skos:Concept ;
    skos:broader luc:transport ;
    skos:definition "Permanent rail transport tracks and associated infrastructure, including stations and terminals; includes the full rail corridor required for safety clearance."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.6.3" ;
    skos:prefLabel "Railways"@en .

luc:roads a skos:Concept ;
    skos:broader luc:transport ;
    skos:definition "The full roading corridor, including sealed road areas and unsealed roadside strips."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.6.2" ;
    skos:prefLabel "Roads"@en .

luc:unused_land a skos:Concept ;
    skos:broader luc:unused_and_transitioning ;
    skos:changeNote <https://github.com/manaakiwhenua/nzsluc/issues/36> ;
    skos:definition "Land that is unused or unusable for productive agriculture or urban uses, such as cliffs, rock faces, boulders, and tors, where there are relatively low levels of disturbance."@en ;
    skos:example "A vacant farm, apparently undergoing natural succession."@en,
        "CERA Red Zone land in Christchurch, abandoned after the 2011 Canterbury earthquake and presently pending use."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.4.2" ;
    skos:prefLabel "Unused land"@en .

mgmt:biodynamic a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "biodynamic" .

mgmt:crop_pasture_rotation a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "crop pasture rotation" .

mgmt:organic a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "organic" .

mgmt:pasture_cropping a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "pasture cropping" .

mgmt:precision_agriculture a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "precision agriculture" .

com:chickens a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "chickens" ;
    skos:usageNote "Poultry farms. Specify whether for eggs or meat where possible."@en .

luc:intensive_horticulture a skos:Concept ;
    skos:broader luc:production_agriculture_plantations ;
    skos:definition "Intensive forms of plant production, often with special-purpose improvements used for horticultural production."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:glasshouses_shadehouses,
        luc:production_nurseries ;
    skos:notation "2.5.0" ;
    skos:prefLabel "Intensive horticulture"@en ;
    skos:usageNote "Record management practices such as hydroponic systems, irrigation, and netting, if known."@en,
        "The specific commodity or commodities should be noted if known."@en ;
    lu:colour "#4A4C39" .

luc:unused_and_transitioning a skos:Concept ;
    skos:broader luc:conservation ;
    skos:changeNote <https://github.com/manaakiwhenua/nzsluc/issues/36> ;
    skos:definition "Land unused for rural production and urban development, without particular conservation instruments, and without any apparent built structure; or land that is transitioning towards a vacant and considerably natural state."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:rehabilitating_land,
        luc:unused_land ;
    skos:notation "1.4.0" ;
    skos:prefLabel "Unused and transitioning land"@en ;
    skos:scopeNote "Corridors and roadside areas may fit under this class."@en,
        "Does not per se include land undergoing natural succession in the context of changing plant species."@en,
        "Unused land (in the sense of non-productive, non-conservation or non-built uses), such as cliffs, rock faces, boulders, and tors, and where there are relatively low levels of disturbance, may be included."@en ;
    lu:colour "#C8C69F" .

lus:nzlum a skos:ConceptScheme ;
    dcterms:hasVersion lus:nzlum0.3.0,
        lus:nzlum0.4.0,
        lus:nzlum0.4.1 ;
    dcterms:relation lu_proverb:kotahi_te_aho ;
    dcterms:title "New Zealand Land Use and Management classification system"@en ;
    doap:repository ns1:nzsluc ;
    foaf:homepage <https://nzlum.landcareresearch.co.nz/> .

com:cattle a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "cattle" .

com:grapes a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "grapes" .

luc:cultural_natural_heritage a skos:Concept ;
    skos:broader luc:conservation ;
    skos:definition "Conservation classes are for purposes other than biodiversity protecton."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:cultural_heritage,
        luc:indigenous_cultural_heritage,
        luc:natural_heritage ;
    skos:notation "1.2.0" ;
    skos:prefLabel "Cultural and natural heritage"@en ;
    lu:colour "#A00019" .

luc:grazing_modified_pasture_systems a skos:Concept ;
    skos:broader luc:production_agriculture_plantations ;
    skos:definition "Grazing pasture and/or forage systems based on significant active modification or replacement of the natural vegetation."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:dairy,
        luc:extensive_dry_stock,
        luc:intensive_dry_stock ;
    skos:notation "2.2.0" ;
    skos:prefLabel "Grazing modified pasture systems"@en ;
    skos:scopeNote "Dairy support is land that is used to support non-lactating dairy stock (dry cows, heifers and calves). It will include any feed required, and will often include winter crops and potentially summer crops (location/irrigation dependent), along with cereal crops, such as maize, barley, and wheat. It can also include feed that is cut and carried to the milking platform. Dairy support land that is not actively used for grazing should be classified as an arable use."@en,
        "Land under pasture at the time of mapping may be in a rotation system, so that at another time the same area may be, for example, under cropping."@en ;
    skos:usageNote "The ability to distinguish between dairy and dry-stock production is provided by including the relevant commodity information, such as `cattle dairy`, `cattle beef`, `sheep wool`, `sheep meat`, etc. Multiple commodities should be recorded if appropriate. Crops used in rotation should also be recorded as commodities, if known."@en ;
    lu:colour "#357735" .

luc:perennial_horticulture a skos:Concept ;
    skos:broader luc:production_agriculture_plantations ;
    skos:definition "Crop plants living for more than 2 years that are intensively cultivated, usually involving a relatively high degree of nutrient, weed, and moisture control."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:other_perennial_horticulture,
        luc:tree_crops,
        luc:vine_fruits ;
    skos:notation "2.4.0" ;
    skos:prefLabel "Perennial horticulture"@en ;
    skos:usageNote "Crop type can be recorded as the commodity and used to identify key crops (e.g. kiwifruit, avocados, and grapes)."@en,
        "Management practices such as irrigation or netting can be recorded as management practices."@en ;
    lu:colour "#A4A898" .

luc:public_recreation_services a skos:Concept ;
    skos:broader luc:built_environment ;
    skos:definition "Land designated for recreational facilities and community amenities, serving recreational needs and essential functions of the local population."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:community_services,
        luc:indoor_recreation,
        luc:outdoor_recreation ;
    skos:notation "3.2.0" ;
    skos:prefLabel "Public recreation and services"@en ;
    lu:colour "#C19878" .

luc:vacant_transitioning_land_urban a skos:Concept ;
    skos:broader luc:built_environment ;
    skos:definition "This land-use type includes areas that are currently unused or undergoing a transition from one land use to another, but in this case with a clear transition towards or within other concepts under the built environment."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:brownfield_development,
        luc:greenfield_development,
        luc:vacant_land ;
    skos:notation "3.9.0" ;
    skos:prefLabel "Vacant and transitioning land"@en ;
    lu:colour "#D69B97" .

com:goats a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "goats" ;
    skos:usageNote "Specify meat, dairy, stud, or wool where appropriate."@en .

com:sheep a skos:Concept ;
    skos:inScheme lus:commodities ;
    skos:notation "sheep" ;
    skos:usageNote "Specify meat, dairy, stud or wool where appropriate."@en .

luc:residential a skos:Concept ;
    skos:broader luc:built_environment ;
    skos:definition "Land uses primarily designated for private, long-term human habitation, encompassing a variety of housing types and densities."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:high_density_residential,
        luc:low_density_residential,
        luc:medium_density_residential,
        luc:rural_residential ;
    skos:notation "3.1.0" ;
    skos:prefLabel "Residential"@en ;
    skos:scopeNote "The class includes holidays homes, retirement villages, student hostels and other forms of low-turnover or longer-term accommodation, even if these are run commercially. Shorter- term forms of accommodation (motels, hotels, holiday parks, etc.) are captured under ‘3.3.0 Commercial’ or ‘3.3.3 Hospitality’"@en ;
    skos:usageNote "Some alignment with the National Planning Standards (Zone Framework Standard) (MfE 2019) has been considered in the development of the subclasses. This information (as at time of classification) should be captured in the zone attribute to allow for some reclassification and specification."@en ;
    lu:colour "#815E5B" .

luc:short_rotation_seasonal_cropping a skos:Concept ;
    skos:broader luc:production_agriculture_plantations ;
    skos:changeNote <https://github.com/manaakiwhenua/nzsluc/issues/65>,
        "The explicit five year periodicity was added in v0.4.0."@en ;
    skos:definition "This class includes agricultural practices characterised by the cultivation of crops with rapid turnover cycles and seasonal planting patterns, typically optimised for efficient land use and high-yield production."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:arable_cropping,
        luc:arable_mixed_livestock_cropping,
        luc:seasonal_flowers_bulbs_turf,
        luc:short_rotation_horticulture ;
    skos:notation "2.3.0" ;
    skos:prefLabel "Short-rotation and seasonal cropping"@en ;
    skos:scopeNote "Arable, and mixed livestock cropping, integrating both crop cultivation and animal husbandry, are also included in this class."@en,
        "The period of rotation to be considered (e.g. in the listing of commodities, or when deciding whether there is any rotation at all) is five years."@en,
        "This class encompasses agricultural activities such as the cultivation of fast-growing crops such as maize, barley, and certain vegetables, often rotated on short-term cycles to maintain soil health and maximise productivity."@en ;
    skos:usageNote "If the type of crop is known, record this in the commodity field. For mixed arable and livestock operations, both commodities should be captured as the primary commodity (neither is ancillary)."@en ;
    lu:colour "#7F7F54" .

luc:transport a skos:Concept ;
    skos:broader luc:built_environment ;
    skos:changeNote <https://github.com/manaakiwhenua/nzsluc/issues/69>,
        "Redefinition of class 3.6.0 to exclude navigation and communication infrastructure, which is now captured under 3.5.8. Renamed from 'Transport and communication'."@en ;
    skos:definition "Land allocated to infrastructure used for the transportation of goods or people."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:airports_aerodromes,
        luc:ports_water_transport,
        luc:railways,
        luc:roads ;
    skos:notation "3.6.0" ;
    skos:prefLabel "Transportation"@en ;
    skos:usageNote "Zoning of land for roading or rail purposes that has not yet been constructed should be captured as attributes."@en ;
    lu:colour "#72737E" .

luc:vacant_and_transitioning_land a skos:Concept ;
    skos:broader luc:production_agriculture_plantations ;
    skos:changeNote <https://github.com/manaakiwhenua/nzsluc/issues/36>,
        "Preferred label changed from 'Land in transition' at v0.4.0"@en ;
    skos:definition "As a subclass of Production agriculture and plantations, land must recently have been used for agriculture or plantations."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:abandoned_land_ag,
        luc:degraded_land_ag,
        luc:no_defined_use_ag,
        luc:rehabilitating_land_ag ;
    skos:notation "2.8.0" ;
    skos:prefLabel "Vacant and transitioning land"@en ;
    skos:scopeNote "In the case of greenfield development where land use is transitioning to a built-environment category, classify under 3.9.0 Vacant and transitioning land (or a subclass) rather than 2.8.0."@en ;
    lu:colour "#BCBFE1" .

luc:intensive_animal_production a skos:Concept ;
    skos:broader luc:production_agriculture_plantations ;
    skos:definition "Intensive forms of non-pastoral animal production, livestock production facilities, or animal-holding yards."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:aquaculture,
        luc:horse_studs,
        luc:intensive_animal_containment,
        luc:piggeries,
        luc:poultry_farms ;
    skos:notation "2.6.0" ;
    skos:prefLabel "Intensive animal production"@en ;
    skos:usageNote "Record animal types as commodities, if known."@en,
        "The management field can be used to record practices such as free range or organic."@en ;
    lu:colour "#BFA798" .

luc:mining a skos:Concept ;
    skos:broader luc:built_environment ;
    skos:definition "Mining and extractive industries (including salt extraction from evaporation basins)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:evaporation_basins,
        luc:extractive_industry_not_in_use,
        luc:mines,
        luc:quarries,
        luc:tailings ;
    skos:notation "3.7.0" ;
    skos:prefLabel "Mining"@en ;
    skos:usageNote "Record the specific type of mining activitiy in the commodity attribute, if known."@en ;
    lu:colour "#E1CEA7" .

luc:plantation_forests a skos:Concept ;
    skos:broader luc:production_agriculture_plantations ;
    skos:definition "Land on which plantations of trees or shrubs (native or exotic species) have been established (i.e. planted) for production, or environmental and resource protection purposes, including carbon forestry."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:exotic_plantation_forestry,
        luc:indigenous_plantation_forestry,
        luc:other_production_plantations,
        luc:planted_environmental_infrastructure_protection ;
    skos:notation "2.1.0" ;
    skos:prefLabel "Plantation forests"@en ;
    skos:scopeNote "This includes farm forestry and may consist of monocultures or mixed species."@en ;
    lu:colour "#122112" .

luc:waste_treatment_disposal a skos:Concept ;
    skos:broader luc:built_environment ;
    skos:definition "Land uses dedicated to managing and processing waste materials (solid waste, wastewater, stormwater), primarily associated with industrial and urban activities, to mitigate environmental impacts and protect public health."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:landfills,
        luc:municipal_wastewater,
        luc:stormwater_management,
        luc:transfer_stations_recycling,
        luc:wastewater_treatment_land_application ;
    skos:notation "3.8.0" ;
    skos:prefLabel "Waste treatment and disposal"@en ;
    lu:colour "#E77148" .

luc:water_wastewater_agriculture a skos:Concept ;
    skos:broader luc:production_agriculture_plantations ;
    skos:definition "Built water features associated with agricultural use."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:effluent_pond,
        luc:irrigation_reservoirs_canals,
        luc:stock_water,
        luc:water_treatment_land_application,
        luc:water_treatment_wetland ;
    skos:notation "2.7.0" ;
    skos:prefLabel "Water and wastewater"@en ;
    lu:colour "#3B505B" .

luc:commercial a skos:Concept ;
    skos:broader luc:built_environment ;
    skos:definition "Land in a built environment context used for private-sector economic activities, including retail, office, hospitality, entertainment, healthcare, transportation, and warehousing."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:entertainment,
        luc:healthcare,
        luc:hospitality,
        luc:office,
        luc:retail,
        luc:transportation_warehousing_commercial ;
    skos:notation "3.3.0" ;
    skos:prefLabel "Commercial"@en ;
    skos:usageNote "Central government offices when these are privately rented should be captured in this category, even if they are public-facing."@en ;
    lu:colour "#B8C2CE" .

luc:manufacturing_industrial a skos:Concept ;
    skos:broader luc:built_environment ;
    skos:definition "Land uses dedicated to production, processing, and industrial activities, contributing to the production of goods and materials for commercial purposes."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:abattoirs,
        luc:farm_buildings_infrastructure,
        luc:food_processing_factory,
        luc:general_purpose_factory,
        luc:major_industrial_complex,
        luc:sawmill ;
    skos:notation "3.4.0" ;
    skos:prefLabel "Manufacturing and industrial"@en ;
    lu:colour "#D0D2DF" .

luc:conservation a skos:Concept ;
    skos:definition "Land that has a relatively low level of human intervention. The land may be formally reserved by government for conservation purposes, or conserved through other legal or administrative arrangements. Areas may have multiple uses but nature conservation is a central consideration. (Some land may be unused because of a deliberate decision of the government or landowner, or due to circumstances)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:cultural_natural_heritage,
        luc:minimal_use_relatively_natural,
        luc:nature_cons,
        luc:unused_and_transitioning ;
    skos:notation "1.0.0" ;
    skos:prefLabel "Conservation and Minimal Use"@en ;
    skos:scopeNote "Areas with lower levels of biodiversity protection are anticipated to have other primary uses, but biodiversity protection ranking could be captured as an ancillary use with class 1.1.4 and 1.1.5."@en ;
    skos:topConceptOf lus:nzlum0.4.0 ;
    skos:usageNote "Where a classification is based on information about legal protection, the relevant information (e.g. the Act) should be mentioned in the `comment` field."@en .

luc:nature_cons a skos:Concept ;
    skos:broader luc:conservation ;
    skos:definition "Nature conservation classes are determined by the classification scheme adopted for the Protected Areas Network of New Zealand (PAN-NZ)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:habitat_or_species_management,
        luc:national_park,
        luc:natural_feature_protection,
        luc:other_conserved_area,
        luc:protected_landscape,
        luc:strict_nature_res,
        luc:wilderness ;
    skos:notation "1.1.0" ;
    skos:prefLabel "Nature conservation"@en .

luc:minimal_use_relatively_natural a skos:Concept ;
    skos:broader luc:conservation ;
    skos:definition "This class includes land that is subject to relatively low levels of intervention or that is largely unused in the context of prime use or use for resource protection. This land may be covered with indigenous or exotic plant species. It includes land where the structure of the native vegetation generally remains intact despite deliberate use, although the floristics of the vegetation may have changed markedly (e.g. grazing on native tussock land)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:carbon_forest_retained,
        luc:customary_use,
        luc:defence_land_natural_areas,
        luc:environmental_infrastructure_protection,
        luc:grazing_native_vegetation,
        luc:ground_water,
        luc:production_from_indigenous_vegetation,
        luc:surface_water_supply ;
    skos:notation "1.3.0" ;
    skos:prefLabel "Minimal use from relatively natural environments"@en ;
    skos:scopeNote "Where native grasses have been deliberately and extensively replaced with other species, the land use should not be classified under class 1."@en ;
    lu:colour "#FFC77A" .

luc:utilities a skos:Concept ;
    skos:broader luc:built_environment ;
    skos:changeNote <https://github.com/manaakiwhenua/nzsluc/issues/69>,
        "Class 3.5.0 redefined at v0.4.0 to include naviation and communciation infrastructure, which was formerly captured under class 3.6.0."@en ;
    skos:definition "Land allocated to providing electricity, gas, or water; or for navigation and communication infrastructure."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:electricity_substations_transmission,
        luc:fuel_powered_electricity_generation,
        luc:gas_treatment_storage_transmission,
        luc:hydroelectricity_generation,
        luc:navigation_communication,
        luc:solar_electricity_generation,
        luc:water_extraction_transmission,
        luc:wind_electricity_generation ;
    skos:notation "3.5.0" ;
    skos:prefLabel "Utilities"@en ;
    lu:colour "#F8ADFA" .

lus:nzlum0.3.0 a skos:ConceptScheme ;
    dcterms:isReplacedBy lus:nzlum0.4.0 ;
    dcterms:isVersionOf lus:nzlum ;
    dcterms:issued "2025-06-30"^^xsd:date ;
    owl:versionInfo "0.3.0" ;
    skos:hasTopConcept luc:built_environment,
        luc:conservation,
        luc:production_agriculture_plantations ;
    adms:status lu_status:superseded .

lus:water_features a skos:ConceptScheme ;
    dcterms:issued "2026-07-09"^^xsd:date ;
    dcterms:title "NZLUM water features"@en .

luc:built_environment a skos:Concept ;
    skos:definition "Land uses that involve high levels of interference with natural processes, generally in association with the built environment of closer settlement and supporting infrastructure. The level of intervention may be high enough to completely remodel the natural landscape – the vegetation, surface and groundwater systems, and land surface."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:commercial,
        luc:manufacturing_industrial,
        luc:mining,
        luc:public_recreation_services,
        luc:residential,
        luc:transport,
        luc:utilities,
        luc:vacant_transitioning_land_urban,
        luc:waste_treatment_disposal ;
    skos:notation "3.0.0" ;
    skos:prefLabel "Built environment"@en ;
    skos:scopeNote "Active outdoor recreation and/or tourism outside of urban areas that is not captured in other land-use categories may be captured under 3.2.1 Outdoor recreation, though may still retain much natural character."@en ;
    skos:topConceptOf lus:nzlum0.4.0 .

luc:production_agriculture_plantations a skos:Concept ;
    skos:definition "Land used principally for primary production, where native vegetation has largely been replaced by introduced species through clearing, the sowing of new species, the application of fertilisers, or the dominance of volunteer species. Includes plantation forests, pasture production for stock, cropping and fodder production, and horticultural production."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:grazing_modified_pasture_systems,
        luc:intensive_animal_production,
        luc:intensive_horticulture,
        luc:perennial_horticulture,
        luc:plantation_forests,
        luc:short_rotation_seasonal_cropping,
        luc:smallholder_farm,
        luc:vacant_and_transitioning_land,
        luc:water_wastewater_agriculture ;
    skos:notation "2.0.0" ;
    skos:prefLabel "Production agriculture and plantations"@en ;
    skos:scopeNote "If there is evidence of irrigation infrastructure or water-take consents, record irrigation as a management practice, even if irrigation water has not been recently applied."@en ;
    skos:topConceptOf lus:nzlum0.4.0 ;
    skos:usageNote "Fallow or ploughed land should be assigned to the most likely land use based on the dominant activity conducted in comparable nearby areas or other available evidence. Fallow or ploughed land should be allocated to the relevant pasture, cropping or horticultural class (rather than using land in transition). The fallow or ploughed status should be recorded in the management field."@en .

lus:management_practices a skos:ConceptScheme ;
    dcterms:issued "2026-02-19"^^xsd:date ;
    dcterms:title "NZLUM management practices"@en .

lus:nzlum0.4.0 a skos:ConceptScheme ;
    dcterms:isVersionOf lus:nzlum ;
    dcterms:issued "2026-02-13"^^xsd:date ;
    dcterms:replaces lus:nzlum0.3.0 ;
    owl:versionInfo "0.4.0" ;
    skos:hasTopConcept luc:built_environment,
        luc:conservation,
        luc:production_agriculture_plantations ;
    adms:status lu_status:published .

lus:commodities a skos:ConceptScheme ;
    dcterms:issued "2026-02-19"^^xsd:date ;
    dcterms:title "NZLUM commodities"@en .

