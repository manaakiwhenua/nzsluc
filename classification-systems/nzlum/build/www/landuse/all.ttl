    skos:inScheme lus:management_practices ;
    skos:notation "fully protected" .

mgmt:grazing_rotational a skos:Concept ;
    skos:definition "Moving livestock between paddocks in regular sequence to permit the recovery and growth of the pasture plants after grazing."@en ;
    skos:inScheme lus:management_practices ;
    skos:notation "grazing rotational" ;
    skos:scopeNote "Also cell grazing."@en ;
    skos:usageNote "Stocking rates per paddock are higher than under set stocking."@en .

mgmt:grazing_set_stocking a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "grazing set stocking" .

mgmt:grazing_tactical a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "grazing tactical" .

mgmt:hedgerow a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "hedgerow" .

mgmt:irrigation_drip a skos:Concept ;
    skos:definition "Irrigation system that applies water to the soil very slowly through tubes/tapes either above or below the soil surface."@en ;
    skos:inScheme lus:management_practices ;
    skos:notation "irrigation drip" ;
    skos:scopeNote "Also trickle irrigation."@en .

mgmt:irrigation_spray a skos:Concept ;
    skos:definition "Irrigation system that sprays water into the air allowing it to fall on the plants and soil much like natural rainfall."@en ;
    skos:inScheme lus:management_practices ;
    skos:notation "irrigation spray" ;
    skos:scopeNote "Sprinklers including set systems, permanent (solid set/fixed), continuous/travelling systems and micro-sprinklers."@en .

mgmt:irrigation_surface a skos:Concept ;
    skos:definition "Water is applied to the land by allowing it to flow by simple gravity before infiltrating. Under furrow irrigation, small parallel channels carry water to irrigate the crop with the crop usually grown on the ridges between the furrows."@en ;
    skos:inScheme lus:management_practices ;
    skos:notation "irrigation surface" ;
    skos:scopeNote "Also flood/furrow irrigation."@en .

mgmt:milking_hand a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "milking hand" .

mgmt:milking_herringbone a skos:Concept ;
