    skos:notation "milking rotary" .

mgmt:milking_walk_through a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "milking walk through " .

mgmt:mulching_matting a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "mulching/matting" .

mgmt:open_growing a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "open growing" .

mgmt:residues_baled a skos:Concept ;
    skos:inScheme lus:management_practices ;
    skos:notation "residues baled" .

mgmt:residues_burnt a skos:Concept ;
    skos:inScheme lus:management_practices ;
