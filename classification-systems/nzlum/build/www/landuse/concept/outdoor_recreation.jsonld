    {
      "@id": "luc:outdoor_recreation",
      "@type": "skos:Concept",
      "foaf:isPrimaryTopicOf": {
        "@id": "luc:outdoor_recreation.html"
      },
      "lu:colour": "#C19878",
      "skos:broader": {
        "@id": "luc:public_recreation_services"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land areas dedicated to leisure activities conducted in natural or semi-natural settings, typically with considerable unsealed vegetated areas."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Parks, trails, sportsgrounds, camping grounds, zoos, botanic gardens, recreational reserves."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "3.2.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Outdoor recreation"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "Parks or reserves with a high level of native bush or that are protected areas should be classified under class 1."
        },
        {
          "@language": "en",
          "@value": "The specific identification of this land is intended to enable more ready identification of urban green space. However, this category may also be used to identify developed recreational areas that fall outside urban boundaries, such as mountain-bike parks."
        }
      ]
    },
