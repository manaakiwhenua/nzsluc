        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/perennial_horticulture.rdf"/>
      </foaf:Document>
    </foaf:isPrimaryTopicOf>
  </skos:Concept>
