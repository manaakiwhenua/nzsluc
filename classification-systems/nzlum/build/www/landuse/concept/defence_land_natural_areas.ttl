@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:defence_land_natural_areas.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:defence_land_natural_areas.jsonld,
        luc:defence_land_natural_areas.rdf,
        luc:defence_land_natural_areas.ttl .

luc:defence_land_natural_areas.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:defence_land_natural_areas .

luc:defence_land_natural_areas.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:defence_land_natural_areas .

luc:defence_land_natural_areas.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:defence_land_natural_areas .

luc:minimal_use_relatively_natural skos:notation "1.3.0" ;
    skos:prefLabel "Minimal use from relatively natural environments"@en .

luc:defence_land_natural_areas a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "Natural areas allocated to field training, weapons testing, and other field defence uses, predominantly in rural areas."@en ;
    skos:example "Kaipara Air Weapons Range"@en,
        "Waiouru Military Camp"@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "1.3.6" ;
    skos:prefLabel "Defence land"@en ;
    skos:scopeNote "Areas associated with buildings or more built environments on defence land are captured under an urban class."@en ;
    foaf:isPrimaryTopicOf luc:defence_land_natural_areas.html ;
    lu:colour "#FF9E17" .

