@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:natural_feature_protection.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:natural_feature_protection.jsonld,
        luc:natural_feature_protection.rdf,
        luc:natural_feature_protection.ttl .

luc:natural_feature_protection.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:natural_feature_protection .

luc:natural_feature_protection.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:natural_feature_protection .

luc:natural_feature_protection.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:natural_feature_protection .

luc:nature_cons skos:notation "1.1.0" ;
    skos:prefLabel "Nature conservation"@en .

luc:natural_feature_protection a skos:Concept ;
    dcterms:source "IUCN (2008) Protected Areas Management Categories, Category III: Natural Monument or Feature."@en ;
    skos:broader luc:nature_cons ;
    skos:definition "Protected area managed for conservation of specific natural features. An area containing one or more specific natural or cultural features that are of outstanding value because of their inherent rarity, representative or aesthetic qualities, or cultural significance."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.1.4" ;
    skos:prefLabel "Natural feature protection"@en ;
    foaf:isPrimaryTopicOf luc:natural_feature_protection.html ;
    lu:colour "#A39FCB" .

