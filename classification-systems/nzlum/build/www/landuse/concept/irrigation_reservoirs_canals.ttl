@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:irrigation_reservoirs_canals.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:irrigation_reservoirs_canals.jsonld,
        luc:irrigation_reservoirs_canals.rdf,
        luc:irrigation_reservoirs_canals.ttl .

luc:irrigation_reservoirs_canals.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:irrigation_reservoirs_canals .

luc:irrigation_reservoirs_canals.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:irrigation_reservoirs_canals .

luc:irrigation_reservoirs_canals.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:irrigation_reservoirs_canals .

luc:water_wastewater_agriculture skos:notation "2.7.0" ;
    skos:prefLabel "Water and wastewater"@en .

luc:irrigation_reservoirs_canals a skos:Concept ;
    skos:broader luc:water_wastewater_agriculture ;
    skos:definition "Land used for water storage, management, or distribution intended for agricultural purposes; areas allocated for irrigation for agricultural purposes."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.7.5" ;
    skos:prefLabel "Irrigation reservoirs and canals"@en ;
    foaf:isPrimaryTopicOf luc:irrigation_reservoirs_canals.html .

