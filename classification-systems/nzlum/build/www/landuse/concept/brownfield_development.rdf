<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:dcterms="http://purl.org/dc/terms/"
>
  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/brownfield_development">
    <skos:definition xml:lang="en">Areas of active redevelopment of previously developed (often industrial) land that may be abandoned, contaminated, or under-utilised, to rehabilitate and repurpose sites for new urban activities.</skos:definition>
    <skos:prefLabel xml:lang="en">Brownfield development</skos:prefLabel>
    <skos:scopeNote xml:lang="en">May include residential areas undergoing infill development that increase housing density.</skos:scopeNote>
    <skos:changeNote>Notation changed from 3.9.3 to 3.9.1 at v0.4.0</skos:changeNote>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/vacant_transitioning_land_urban">
        <skos:prefLabel xml:lang="en">Vacant and transitioning land</skos:prefLabel>
        <skos:notation>3.9.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <skos:notation>3.9.1</skos:notation>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
    <foaf:isPrimaryTopicOf>
      <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/brownfield_development.html">
        <dcterms:format>text/html</dcterms:format>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/brownfield_development.ttl"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/brownfield_development.jsonld"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/brownfield_development.rdf"/>
      </foaf:Document>
    </foaf:isPrimaryTopicOf>
  </skos:Concept>
