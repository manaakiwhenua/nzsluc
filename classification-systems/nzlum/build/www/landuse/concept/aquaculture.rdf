  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/aquaculture">
    <skos:prefLabel xml:lang="en">Aquaculture</skos:prefLabel>
    <skos:broader rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/intensive_animal_production"/>
    <skos:definition xml:lang="en">Controlled cultivation of aquatic organisms (e.g. fish, molluscs, algae) in natural or artificial environments, typically for food production, but also for stock feeds, pharmaceutical uses, biofuels, etc.</skos:definition>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
