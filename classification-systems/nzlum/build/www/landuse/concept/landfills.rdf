    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/landfills"/>
    <dcterms:format>application/rdf+xml</dcterms:format>
  </foaf:Document>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/landfills.ttl">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/landfills"/>
