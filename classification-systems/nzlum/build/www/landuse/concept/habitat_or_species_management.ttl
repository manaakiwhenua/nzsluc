@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:habitat_or_species_management.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:habitat_or_species_management.jsonld,
        luc:habitat_or_species_management.rdf,
        luc:habitat_or_species_management.ttl .

luc:habitat_or_species_management.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:habitat_or_species_management .

luc:habitat_or_species_management.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:habitat_or_species_management .

luc:habitat_or_species_management.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:habitat_or_species_management .

luc:nature_cons skos:notation "1.1.0" ;
    skos:prefLabel "Nature conservation"@en .

luc:habitat_or_species_management a skos:Concept ;
    dcterms:source "IUCN (2008) Protected Areas Management Categories, Category IV: Habitat/Species Management Area."@en ;
    skos:broader luc:nature_cons ;
    skos:definition "Protected area managed mainly for conservation through management intervention. An area of land or sea subject to active intervention for management purposes to ensure the maintenance of habitats or to meet the requirements of specific species. This may include areas on private land."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "1.1.5" ;
    skos:prefLabel "Habitat or species management area"@en ;
    foaf:isPrimaryTopicOf luc:habitat_or_species_management.html ;
    lu:colour "#C9CAE3" .

