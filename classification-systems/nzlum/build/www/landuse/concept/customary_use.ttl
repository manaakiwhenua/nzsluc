@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:customary_use.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:customary_use.jsonld,
        luc:customary_use.rdf,
        luc:customary_use.ttl .

luc:customary_use.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:customary_use .

luc:customary_use.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:customary_use .

luc:customary_use.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:customary_use .

luc:minimal_use_relatively_natural skos:notation "1.3.0" ;
    skos:prefLabel "Minimal use from relatively natural environments"@en .

luc:customary_use a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "Natural environments associated with traditional and sustainable Indigenous food-gathering practices (mahinga kai)."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "1.3.5" ;
    skos:prefLabel "Customary use"@en ;
    skos:scopeNote "This may include land zoned for Māori purposes, and should only describe contemporary, not historical, use."@en ;
    skos:usageNote "This is often an ancillary use; assign only if customary use is the prime use of the land."@en ;
    foaf:isPrimaryTopicOf luc:customary_use.html .

