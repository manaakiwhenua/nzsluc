@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:mining skos:notation "3.7.0" ;
    skos:prefLabel "Mining"@en .

luc:quarries.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:quarries.jsonld,
        luc:quarries.rdf,
        luc:quarries.ttl .

luc:quarries.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:quarries .

luc:quarries.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:quarries .

luc:quarries.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:quarries .

luc:quarries a skos:Concept ;
    skos:broader luc:mining ;
    skos:definition "Land from which stone, gravel, clay, slate, sand, soil, rock, or other construction materials are being extracted."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.7.2" ;
    skos:prefLabel "Quarries"@en ;
    foaf:isPrimaryTopicOf luc:quarries.html .

