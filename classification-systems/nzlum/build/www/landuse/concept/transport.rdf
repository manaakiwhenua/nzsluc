    <skos:prefLabel xml:lang="en">Transportation</skos:prefLabel>
    <skos:usageNote xml:lang="en">Zoning of land for roading or rail purposes that has not yet been constructed should be captured as attributes.</skos:usageNote>
    <skos:changeNote xml:lang="en">Redefinition of class 3.6.0 to exclude navigation and communication infrastructure, which is now captured under 3.5.8. Renamed from 'Transport and communication'.</skos:changeNote>
    <skos:changeNote rdf:resource="https://github.com/manaakiwhenua/nzsluc/issues/69"/>
    <skos:broader>
