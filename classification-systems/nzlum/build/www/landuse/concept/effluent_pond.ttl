@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:effluent_pond.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:effluent_pond.jsonld,
        luc:effluent_pond.rdf,
        luc:effluent_pond.ttl .

luc:effluent_pond.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:effluent_pond .

luc:effluent_pond.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:effluent_pond .

luc:effluent_pond.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:effluent_pond .

luc:water_wastewater_agriculture skos:notation "2.7.0" ;
    skos:prefLabel "Water and wastewater"@en .

luc:effluent_pond a skos:Concept ;
    skos:broader luc:water_wastewater_agriculture ;
    skos:definition "Effluent ponds typically associated with dairying."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.7.2" ;
    skos:prefLabel "Effluent pond"@en ;
    foaf:isPrimaryTopicOf luc:effluent_pond.html .

