        }
      ],
      "skos:notation": "2.1.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Plantation forests"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "This includes farm forestry and may consist of monocultures or mixed species."
