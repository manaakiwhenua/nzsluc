  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/intensive_animal_containment">
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/intensive_animal_production">
        <skos:prefLabel xml:lang="en">Intensive animal production</skos:prefLabel>
        <skos:notation>2.6.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <skos:notation>2.6.1</skos:notation>
    <skos:definition xml:lang="en">Facilities or systems designed to confine and manage animals, including feed lots, pens, dairy sheds and yards, and herd homes, where animals are raised intensively for meat production or other purposes.</skos:definition>
    <skos:prefLabel xml:lang="en">Intensive animal containment</skos:prefLabel>
    <foaf:isPrimaryTopicOf>
      <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/intensive_animal_containment.html">
        <dcterms:format>text/html</dcterms:format>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/intensive_animal_containment.ttl"/>
