<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:dcterms="http://purl.org/dc/terms/"
>
  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/exotic_plantation_forestry">
    <skos:usageNote xml:lang="en">The specific commodity or commodities should be noted if known.</skos:usageNote>
    <skos:usageNote xml:lang="en">Specific additional attributes that could be captured in comments or supplementary attributes are plantation age, rotation number, and species.</skos:usageNote>
    <skos:definition xml:lang="en">An area managed for pulpwood or saw-log production, or for carbon sequestration and carbon credits (exotic species).</skos:definition>
    <skos:notation>2.1.1</skos:notation>
    <skos:prefLabel xml:lang="en">Exotic plantation forestry</skos:prefLabel>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/plantation_forests">
        <skos:prefLabel xml:lang="en">Plantation forests</skos:prefLabel>
        <skos:notation>2.1.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
    <skos:changeNote xml:lang="en">Consideration of carbon sequestration and carbon credits were added in NZLUM v0.4.0</skos:changeNote>
    <foaf:isPrimaryTopicOf>
      <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/exotic_plantation_forestry.html">
        <dcterms:format>text/html</dcterms:format>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/exotic_plantation_forestry.ttl"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/exotic_plantation_forestry.jsonld"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/exotic_plantation_forestry.rdf"/>
      </foaf:Document>
    </foaf:isPrimaryTopicOf>
  </skos:Concept>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/exotic_plantation_forestry.rdf">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/exotic_plantation_forestry"/>
    <dcterms:format>application/rdf+xml</dcterms:format>
  </foaf:Document>
