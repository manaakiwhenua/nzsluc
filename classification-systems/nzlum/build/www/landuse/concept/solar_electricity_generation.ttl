@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:solar_electricity_generation.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:solar_electricity_generation.jsonld,
        luc:solar_electricity_generation.rdf,
        luc:solar_electricity_generation.ttl .

luc:solar_electricity_generation.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:solar_electricity_generation .

luc:solar_electricity_generation.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:solar_electricity_generation .

luc:solar_electricity_generation.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:solar_electricity_generation .

luc:utilities skos:notation "3.5.0" ;
    skos:prefLabel "Utilities"@en .

luc:solar_electricity_generation a skos:Concept ;
    skos:broader luc:utilities ;
    skos:definition "Facilities that harness sunlight using photovoltaic cells or solar thermal systems to generate electricity."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.5.4" ;
    skos:prefLabel "Solar electricity generation"@en ;
    foaf:isPrimaryTopicOf luc:solar_electricity_generation.html .

