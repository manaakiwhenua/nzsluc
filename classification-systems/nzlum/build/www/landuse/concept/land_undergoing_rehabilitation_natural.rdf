  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/land_undergoing_rehabilitation_natural.ttl">
    <foaf:primaryTopic>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/land_undergoing_rehabilitation_natural">
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
        <skos:broader rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_land_transition"/>
        <skos:notation>1.4.2</skos:notation>
        <skos:prefLabel xml:lang="en">Land undergoing rehabilitation</skos:prefLabel>
        <skos:definition xml:lang="en">Degraded land (e.g. due to erosion or flood damage) that is being actively rehabilitated through planting with indigenous or exotic species to return land to a natural state (including riparian plantings).</skos:definition>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:historyNote xml:lang="en">Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0.</skos:historyNote>
        <foaf:isPrimaryTopicOf rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/land_undergoing_rehabilitation_natural.html"/>
      </skos:Concept>
    </foaf:primaryTopic>
    <dcterms:format>text/turtle</dcterms:format>
  </foaf:Document>
