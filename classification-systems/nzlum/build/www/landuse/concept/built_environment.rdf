        <skos:narrower rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/mining"/>
        <skos:notation>3.0.0</skos:notation>
        <skos:topConceptOf rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
        <skos:scopeNote xml:lang="en">Active outdoor recreation and/or tourism outside of urban areas that is not captured in other land-use categories may be captured under 3.2.1 Outdoor recreation, though may still retain much natural character.</skos:scopeNote>
        <skos:prefLabel xml:lang="en">Built environment</skos:prefLabel>
        <skos:definition xml:lang="en">Land uses that involve high levels of interference with natural processes, generally in association with the built environment of closer settlement and supporting infrastructure. The level of intervention may be high enough to completely remodel the natural landscape – the vegetation, surface and groundwater systems, and land surface.</skos:definition>
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
        <foaf:isPrimaryTopicOf rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/built_environment.html"/>
      </skos:Concept>
    </foaf:primaryTopic>
    <dcterms:format>application/rdf+xml</dcterms:format>
  </foaf:Document>
