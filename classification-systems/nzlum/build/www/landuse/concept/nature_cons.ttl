@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:conservation skos:notation "1.0.0" ;
    skos:prefLabel "Conservation and Minimal Use"@en .

luc:habitat_or_species_management skos:notation "1.1.5" ;
    skos:prefLabel "Habitat or species management area"@en .

luc:national_park skos:notation "1.1.3" ;
    skos:prefLabel "National Park"@en .

luc:natural_feature_protection skos:notation "1.1.4" ;
    skos:prefLabel "Natural feature protection"@en .

luc:nature_cons.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:nature_cons.jsonld,
        luc:nature_cons.rdf,
        luc:nature_cons.ttl .

luc:nature_cons.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:nature_cons .

luc:nature_cons.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:nature_cons .

luc:nature_cons.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:nature_cons .

luc:other_conserved_area skos:notation "1.1.7" ;
    skos:prefLabel "Other conserved area"@en .

luc:protected_landscape skos:notation "1.1.6" ;
    skos:prefLabel "Protected landscape"@en .

luc:strict_nature_res skos:notation "1.1.1" ;
    skos:prefLabel "Strict nature reserve"@en .

luc:wilderness skos:notation "1.1.2" ;
    skos:prefLabel "Wilderness area"@en .

luc:nature_cons a skos:Concept ;
    skos:broader luc:conservation ;
    skos:definition "Nature conservation classes are determined by the classification scheme adopted for the Protected Areas Network of New Zealand (PAN-NZ)."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:narrower luc:habitat_or_species_management,
        luc:national_park,
        luc:natural_feature_protection,
        luc:other_conserved_area,
        luc:protected_landscape,
        luc:strict_nature_res,
        luc:wilderness ;
    skos:notation "1.1.0" ;
    skos:prefLabel "Nature conservation"@en ;
    foaf:isPrimaryTopicOf luc:nature_cons.html .

