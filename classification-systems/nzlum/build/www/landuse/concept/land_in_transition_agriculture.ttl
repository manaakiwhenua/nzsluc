@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

luc:abandoned_land_ag skos:notation "2.8.2" ;
    skos:prefLabel "Abandoned land"@en .

luc:land_in_transition_agriculture.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:land_in_transition_agriculture.jsonld,
        luc:land_in_transition_agriculture.rdf,
        luc:land_in_transition_agriculture.ttl .

luc:land_in_transition_agriculture.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:land_in_transition_agriculture .

luc:land_in_transition_agriculture.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:land_in_transition_agriculture .

luc:land_in_transition_agriculture.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:land_in_transition_agriculture .

luc:land_undergoing_rehabilitation_ag skos:notation "2.8.3" ;
    skos:prefLabel "Land undergoing rehabilitation"@en .

luc:no_defined_use_ag skos:notation "2.8.4" ;
    skos:prefLabel "No defined use"@en .

luc:production_agriculture_plantations skos:notation "2.0.0" ;
    skos:prefLabel "Production agriculture and plantations"@en .

luc:unused_degraded_land_ag skos:notation "2.8.1" ;
    skos:prefLabel "Unused degraded land"@en .

luc:land_in_transition_agriculture a skos:Concept ;
    owl:deprecated true ;
    skos:broader luc:production_agriculture_plantations ;
    skos:definition "As a subclass of Production agriculture and plantations, land must recently have been used for agriculture or plantations."@en ;
    skos:historyNote "Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0."@en ;
    skos:inScheme lus:nzlum0.3.0 ;
    skos:narrower luc:abandoned_land_ag,
        luc:land_undergoing_rehabilitation_ag,
        luc:no_defined_use_ag,
        luc:unused_degraded_land_ag ;
    skos:notation "2.8.0" ;
    skos:prefLabel "Land in transition"@en ;
    skos:scopeNote "In the case of greenfield development where land use is transitioning to a built-environment category, classify under 3.9.0 Vacant and transitioning land (or a subclass) rather than 2.8.0."@en ;
    foaf:isPrimaryTopicOf luc:land_in_transition_agriculture.html ;
    lu:colour "#BCBFE1" .

