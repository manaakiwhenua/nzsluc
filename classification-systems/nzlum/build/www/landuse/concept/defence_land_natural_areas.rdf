  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/defence_land_natural_areas.ttl">
    <foaf:primaryTopic>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/defence_land_natural_areas">
        <skos:example xml:lang="en">Kaipara Air Weapons Range</skos:example>
        <skos:example xml:lang="en">Waiouru Military Camp</skos:example>
        <skos:scopeNote xml:lang="en">Areas associated with buildings or more built environments on defence land are captured under an urban class.</skos:scopeNote>
        <skos:definition xml:lang="en">Natural areas allocated to field training, weapons testing, and other field defence uses, predominantly in rural areas.</skos:definition>
        <skos:prefLabel xml:lang="en">Defence land</skos:prefLabel>
        <skos:notation>1.3.6</skos:notation>
        <lu:colour>#FF9E17</lu:colour>
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
        <skos:broader rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/minimal_use_relatively_natural"/>
        <foaf:isPrimaryTopicOf rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/defence_land_natural_areas.html"/>
      </skos:Concept>
    </foaf:primaryTopic>
    <dcterms:format>text/turtle</dcterms:format>
  </foaf:Document>
