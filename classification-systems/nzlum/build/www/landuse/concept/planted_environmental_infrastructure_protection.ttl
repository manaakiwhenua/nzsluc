@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:plantation_forests skos:notation "2.1.0" ;
    skos:prefLabel "Plantation forests"@en .

luc:planted_environmental_infrastructure_protection.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:planted_environmental_infrastructure_protection.jsonld,
        luc:planted_environmental_infrastructure_protection.rdf,
        luc:planted_environmental_infrastructure_protection.ttl .

luc:planted_environmental_infrastructure_protection.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:planted_environmental_infrastructure_protection .

luc:planted_environmental_infrastructure_protection.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:planted_environmental_infrastructure_protection .

luc:planted_environmental_infrastructure_protection.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:planted_environmental_infrastructure_protection .

luc:planted_environmental_infrastructure_protection a skos:Concept ;
    skos:broader luc:plantation_forests ;
    skos:definition "An area managed for environmental and indirect production uses (e.g. prevention of land degradation, windbreaks, shade, and shelter) where trees or shrubs have been planted."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.1.4" ;
    skos:prefLabel "Planted environmental & infrastructure protection"@en ;
    foaf:isPrimaryTopicOf luc:planted_environmental_infrastructure_protection.html .

