  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/municipal_wastewater">
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/waste_treatment_disposal">
