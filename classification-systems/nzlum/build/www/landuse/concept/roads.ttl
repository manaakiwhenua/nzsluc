@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:roads.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:roads.jsonld,
        luc:roads.rdf,
        luc:roads.ttl .

luc:roads.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:roads .

luc:roads.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:roads .

luc:roads.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:roads .

luc:transport skos:notation "3.6.0" ;
    skos:prefLabel "Transportation"@en .

luc:roads a skos:Concept ;
    skos:broader luc:transport ;
    skos:definition "The full roading corridor, including sealed road areas and unsealed roadside strips."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.6.2" ;
    skos:prefLabel "Roads"@en ;
    foaf:isPrimaryTopicOf luc:roads.html .

