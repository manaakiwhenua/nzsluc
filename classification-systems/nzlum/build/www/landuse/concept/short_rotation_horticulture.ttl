@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:short_rotation_horticulture.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:short_rotation_horticulture.jsonld,
        luc:short_rotation_horticulture.rdf,
        luc:short_rotation_horticulture.ttl .

luc:short_rotation_horticulture.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:short_rotation_horticulture .

luc:short_rotation_horticulture.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:short_rotation_horticulture .

luc:short_rotation_horticulture.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:short_rotation_horticulture .

luc:short_rotation_seasonal_cropping skos:notation "2.3.0" ;
    skos:prefLabel "Short-rotation and seasonal cropping"@en .

luc:short_rotation_horticulture a skos:Concept ;
    skos:broader luc:short_rotation_seasonal_cropping ;
    skos:definition "Crop plants living for less than 2 years that are intensively cultivated; predominantly rotations of vegetable crops or seasonal fruits grown for human consumption."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.3.3" ;
    skos:prefLabel "Short-rotation horticulture"@en ;
    skos:scopeNote "May include livestock rotations, but this is considered less likely"@en ;
    skos:usageNote "The specific commodity or commodities should be noted if known."@en ;
    foaf:isPrimaryTopicOf luc:short_rotation_horticulture.html .

