@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:abandoned_land_ag skos:notation "2.8.2" ;
    skos:prefLabel "Abandoned land"@en .

luc:degraded_land_ag skos:notation "2.8.3" ;
    skos:prefLabel "Degraded land"@en .

luc:no_defined_use_ag skos:notation "2.8.4" ;
    skos:prefLabel "No defined use"@en .

luc:production_agriculture_plantations skos:notation "2.0.0" ;
    skos:prefLabel "Production agriculture and plantations"@en .

luc:rehabilitating_land_ag skos:notation "2.8.1" ;
    skos:prefLabel "Rehabilitating land"@en .

luc:vacant_and_transitioning_land.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:vacant_and_transitioning_land.jsonld,
        luc:vacant_and_transitioning_land.rdf,
        luc:vacant_and_transitioning_land.ttl .

luc:vacant_and_transitioning_land.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:vacant_and_transitioning_land .

luc:vacant_and_transitioning_land.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:vacant_and_transitioning_land .

luc:vacant_and_transitioning_land.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:vacant_and_transitioning_land .

luc:vacant_and_transitioning_land a skos:Concept ;
    skos:broader luc:production_agriculture_plantations ;
    skos:changeNote <https://github.com/manaakiwhenua/nzsluc/issues/36>,
        "Preferred label changed from 'Land in transition' at v0.4.0"@en ;
    skos:definition "As a subclass of Production agriculture and plantations, land must recently have been used for agriculture or plantations."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:abandoned_land_ag,
        luc:degraded_land_ag,
        luc:no_defined_use_ag,
        luc:rehabilitating_land_ag ;
    skos:notation "2.8.0" ;
    skos:prefLabel "Vacant and transitioning land"@en ;
    skos:scopeNote "In the case of greenfield development where land use is transitioning to a built-environment category, classify under 3.9.0 Vacant and transitioning land (or a subclass) rather than 2.8.0."@en ;
    foaf:isPrimaryTopicOf luc:vacant_and_transitioning_land.html ;
    lu:colour "#BCBFE1" .

