      "skos:definition": {
        "@language": "en",
        "@value": "Harbour locations where ships dock to transfer people or cargo, including terrestrial parts and designated marine areas that are specifically designated and controlled for activities associated with the port."
      },
      "skos:example": [
        {
          "@language": "en",
          "@value": "Harbours, navigational channels."
        },
        {
          "@language": "en",
          "@value": "Ports, docks, and wharves."
        }
      ],
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.0"
      },
      "skos:notation": "3.6.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ports and water transport"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "The water attribute can be used to differentiate the terrestrial and marine parts of the same facility."
      }
