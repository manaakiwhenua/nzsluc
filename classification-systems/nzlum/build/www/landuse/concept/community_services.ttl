@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:community_services.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:community_services.jsonld,
        luc:community_services.rdf,
        luc:community_services.ttl .

luc:community_services.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:community_services .

luc:community_services.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:community_services .

luc:community_services.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:community_services .

luc:public_recreation_services skos:notation "3.2.0" ;
    skos:prefLabel "Public recreation and services"@en .

luc:community_services a skos:Concept ;
    skos:broader luc:public_recreation_services ;
    skos:definition "Land used for providing essential services and facilities to support the local community."@en ;
    skos:example "Educational institutions, public healthcare facilities, libraries, museums, courts, prisons, civic buildings, emergency services, marae, religious buildings, cemeteries."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.2.3" ;
    skos:prefLabel "Community services"@en ;
    foaf:isPrimaryTopicOf luc:community_services.html ;
    lu:colour "#E09962" .

