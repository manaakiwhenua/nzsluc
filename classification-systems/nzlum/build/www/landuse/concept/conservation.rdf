  <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0">
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/conservation">
        <skos:notation>1.0.0</skos:notation>
        <skos:topConceptOf rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
        <skos:usageNote xml:lang="en">Where a classification is based on information about legal protection, the relevant information (e.g. the Act) should be mentioned in the `comment` field.</skos:usageNote>
        <skos:scopeNote xml:lang="en">Areas with lower levels of biodiversity protection are anticipated to have other primary uses, but biodiversity protection ranking could be captured as an ancillary use with class 1.1.4 and 1.1.5.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
        <skos:narrower rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/nature_cons"/>
        <skos:narrower rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/cultural_natural_heritage"/>
        <skos:narrower rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/minimal_use_relatively_natural"/>
        <skos:narrower rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_and_transitioning"/>
        <skos:definition xml:lang="en">Land that has a relatively low level of human intervention. The land may be formally reserved by government for conservation purposes, or conserved through other legal or administrative arrangements. Areas may have multiple uses but nature conservation is a central consideration. (Some land may be unused because of a deliberate decision of the government or landowner, or due to circumstances).</skos:definition>
        <skos:prefLabel xml:lang="en">Conservation and Minimal Use</skos:prefLabel>
        <foaf:isPrimaryTopicOf rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/conservation.html"/>
      </skos:Concept>
    </skos:hasTopConcept>
  </rdf:Description>
