    {
      "@id": "luc:built_environment",
      "@type": "skos:Concept",
      "foaf:isPrimaryTopicOf": {
        "@id": "luc:built_environment.html"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land uses that involve high levels of interference with natural processes, generally in association with the built environment of closer settlement and supporting infrastructure. The level of intervention may be high enough to completely remodel the natural landscape – the vegetation, surface and groundwater systems, and land surface."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
