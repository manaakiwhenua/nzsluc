<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:lu="https://nzlum.landcareresearch.co.nz/landuse/"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:dcterms="http://purl.org/dc/terms/"
>
  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/residential">
    <skos:narrower>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/high_density_residential">
        <skos:prefLabel xml:lang="en">High-density residential</skos:prefLabel>
        <skos:notation>3.1.1</skos:notation>
      </rdf:Description>
    </skos:narrower>
    <skos:narrower>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/medium_density_residential">
        <skos:prefLabel xml:lang="en">Medium-density residential</skos:prefLabel>
        <skos:notation>3.1.2</skos:notation>
      </rdf:Description>
    </skos:narrower>
    <skos:narrower>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/rural_residential">
        <skos:prefLabel xml:lang="en">Rural residential</skos:prefLabel>
        <skos:notation>3.1.4</skos:notation>
      </rdf:Description>
    </skos:narrower>
    <skos:narrower>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/low_density_residential">
        <skos:prefLabel xml:lang="en">Low-density residential</skos:prefLabel>
        <skos:notation>3.1.3</skos:notation>
      </rdf:Description>
    </skos:narrower>
    <skos:definition xml:lang="en">Land uses primarily designated for private, long-term human habitation, encompassing a variety of housing types and densities.</skos:definition>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/built_environment">
        <skos:prefLabel xml:lang="en">Built environment</skos:prefLabel>
        <skos:notation>3.0.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <lu:colour>#815E5B</lu:colour>
    <skos:prefLabel xml:lang="en">Residential</skos:prefLabel>
    <skos:notation>3.1.0</skos:notation>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
    <skos:usageNote xml:lang="en">Some alignment with the National Planning Standards (Zone Framework Standard) (MfE 2019) has been considered in the development of the subclasses. This information (as at time of classification) should be captured in the zone attribute to allow for some reclassification and specification.</skos:usageNote>
    <skos:scopeNote xml:lang="en">The class includes holidays homes, retirement villages, student hostels and other forms of low-turnover or longer-term accommodation, even if these are run commercially. Shorter- term forms of accommodation (motels, hotels, holiday parks, etc.) are captured under ‘3.3.0 Commercial’ or ‘3.3.3 Hospitality’</skos:scopeNote>
    <foaf:isPrimaryTopicOf>
      <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/residential.html">
        <dcterms:format>text/html</dcterms:format>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/residential.ttl"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/residential.jsonld"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/residential.rdf"/>
      </foaf:Document>
    </foaf:isPrimaryTopicOf>
  </skos:Concept>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/residential.ttl">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/residential"/>
    <dcterms:format>text/turtle</dcterms:format>
  </foaf:Document>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/residential.rdf">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/residential"/>
    <dcterms:format>application/rdf+xml</dcterms:format>
  </foaf:Document>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/residential.jsonld">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/residential"/>
    <dcterms:format>application/ld+json</dcterms:format>
  </foaf:Document>
</rdf:RDF>
