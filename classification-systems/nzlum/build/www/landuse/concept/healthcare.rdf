  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/healthcare">
    <skos:notation>3.3.5</skos:notation>
    <skos:example xml:lang="en">Hospitals, specialist clinics, physiotherapists, medical offices, laboratories</skos:example>
    <skos:prefLabel xml:lang="en">Healthcare</skos:prefLabel>
    <skos:definition xml:lang="en">Land dedicated to providing private medical services aimed at diagnosis, treatment, and prevention of illness or injury.</skos:definition>
