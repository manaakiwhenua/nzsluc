@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:commercial skos:notation "3.3.0" ;
    skos:prefLabel "Commercial"@en .

luc:entertainment.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:entertainment.jsonld,
        luc:entertainment.rdf,
        luc:entertainment.ttl .

luc:entertainment.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:entertainment .

luc:entertainment.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:entertainment .

luc:entertainment.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:entertainment .

luc:entertainment a skos:Concept ;
    skos:broader luc:commercial ;
    skos:definition "Land areas and facilities offering leisure and recreational activities for public enjoyment."@en ;
    skos:example "Cinemas, theatres, amusement parks, casinos, concert venues."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.3.4" ;
    skos:prefLabel "Entertainment"@en ;
    foaf:isPrimaryTopicOf luc:entertainment.html .

