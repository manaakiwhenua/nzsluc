@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:low_density_residential.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:low_density_residential.jsonld,
        luc:low_density_residential.rdf,
        luc:low_density_residential.ttl .

luc:low_density_residential.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:low_density_residential .

luc:low_density_residential.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:low_density_residential .

luc:low_density_residential.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:low_density_residential .

luc:residential skos:notation "3.1.0" ;
    skos:prefLabel "Residential"@en .

luc:low_density_residential a skos:Concept ;
    skos:broader luc:residential ;
    skos:definition "Residential properties within urban boundaries that fall within large-lot or low-density residential zones and are often single-family, one- to two- storey houses with yards and landscaping and lower population density."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "3.1.3" ;
    skos:prefLabel "Low-density residential"@en ;
    foaf:isPrimaryTopicOf luc:low_density_residential.html ;
    lu:colour "#815E5B" .

