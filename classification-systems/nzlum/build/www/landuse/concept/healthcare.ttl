@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:commercial skos:notation "3.3.0" ;
    skos:prefLabel "Commercial"@en .

luc:healthcare.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:healthcare.jsonld,
        luc:healthcare.rdf,
        luc:healthcare.ttl .

luc:healthcare.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:healthcare .

luc:healthcare.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:healthcare .

luc:healthcare.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:healthcare .

luc:healthcare a skos:Concept ;
    skos:broader luc:commercial ;
    skos:definition "Land dedicated to providing private medical services aimed at diagnosis, treatment, and prevention of illness or injury."@en ;
    skos:example "Hospitals, specialist clinics, physiotherapists, medical offices, laboratories"@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "3.3.5" ;
    skos:prefLabel "Healthcare"@en ;
    foaf:isPrimaryTopicOf luc:healthcare.html .

