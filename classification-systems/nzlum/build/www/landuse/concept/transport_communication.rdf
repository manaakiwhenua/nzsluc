        <skos:narrower rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/navigation_communication"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:historyNote xml:lang="en">Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0.</skos:historyNote>
        <foaf:isPrimaryTopicOf rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/transport_communication.html"/>
      </skos:Concept>
    </foaf:primaryTopic>
    <dcterms:format>text/turtle</dcterms:format>
