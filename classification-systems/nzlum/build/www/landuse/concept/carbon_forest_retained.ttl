@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:carbon_forest_retained.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:carbon_forest_retained.jsonld,
        luc:carbon_forest_retained.rdf,
        luc:carbon_forest_retained.ttl .

luc:carbon_forest_retained.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:carbon_forest_retained .

luc:carbon_forest_retained.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:carbon_forest_retained .

luc:carbon_forest_retained.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:carbon_forest_retained .

luc:minimal_use_relatively_natural skos:notation "1.3.0" ;
    skos:prefLabel "Minimal use from relatively natural environments"@en .

luc:carbon_forest_retained a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "Retained (non-planted) indigenous vegetation set aside for carbon credits."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "1.3.8" ;
    skos:prefLabel "Carbon forest"@en ;
    foaf:isPrimaryTopicOf luc:carbon_forest_retained.html .

