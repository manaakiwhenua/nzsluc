  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/community_services.ttl">
    <foaf:primaryTopic>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/community_services">
        <skos:definition xml:lang="en">Land used for providing essential services and facilities to support the local community.</skos:definition>
        <skos:broader rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/public_recreation_services"/>
        <skos:prefLabel xml:lang="en">Community services</skos:prefLabel>
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
        <skos:notation>3.2.3</skos:notation>
        <skos:example xml:lang="en">Educational institutions, public healthcare facilities, libraries, museums, courts, prisons, civic buildings, emergency services, marae, religious buildings, cemeteries.</skos:example>
        <lu:colour>#E09962</lu:colour>
        <foaf:isPrimaryTopicOf rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/community_services.html"/>
      </skos:Concept>
    </foaf:primaryTopic>
    <dcterms:format>text/turtle</dcterms:format>
  </foaf:Document>
