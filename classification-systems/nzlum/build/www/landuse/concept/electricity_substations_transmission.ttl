@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:electricity_substations_transmission.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:electricity_substations_transmission.jsonld,
        luc:electricity_substations_transmission.rdf,
        luc:electricity_substations_transmission.ttl .

luc:electricity_substations_transmission.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:electricity_substations_transmission .

luc:electricity_substations_transmission.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:electricity_substations_transmission .

luc:electricity_substations_transmission.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:electricity_substations_transmission .

luc:utilities skos:notation "3.5.0" ;
    skos:prefLabel "Utilities"@en .

luc:electricity_substations_transmission a skos:Concept ;
    skos:broader luc:utilities ;
    skos:definition "Facilities and infrastructure associated with distribution and transmission of electrical power."@en ;
    skos:example "Substations, transformers, high-voltage transmission towers."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "3.5.5" ;
    skos:prefLabel "Electricity substations and transmission"@en ;
    foaf:isPrimaryTopicOf luc:electricity_substations_transmission.html .

