  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/water_extraction_transmission">
    <skos:notation>3.5.7</skos:notation>
    <skos:prefLabel xml:lang="en">Water extraction and transmission</skos:prefLabel>
    <skos:definition xml:lang="en">Facilities and infrastructure for extracting, purifying, treating, and transporting water from natural sources to meet human needs.</skos:definition>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
    <skos:scopeNote xml:lang="en">Includes drinking water reservoirs.</skos:scopeNote>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/utilities">
        <skos:prefLabel xml:lang="en">Utilities</skos:prefLabel>
