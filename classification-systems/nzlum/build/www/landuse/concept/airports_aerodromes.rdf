  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/airports_aerodromes">
    <skos:notation>3.6.1</skos:notation>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/transport">
