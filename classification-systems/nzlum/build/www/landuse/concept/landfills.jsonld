        "@value": "Landfills"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "Includes all class 1 to 5 landfills"
        },
        {
          "@language": "en",
          "@value": "Landfill gas recovery systems are classified as part of a landfill land use."
