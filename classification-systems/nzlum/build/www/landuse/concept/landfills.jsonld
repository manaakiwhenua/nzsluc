      "skos:definition": {
        "@language": "en",
        "@value": "Designated areas for disposal of solid waste, where waste materials are deposited, compacted, and covered to reduce contamination and control emissions."
      },
      "skos:example": "Landfills designed to receive inert construction materials.",
