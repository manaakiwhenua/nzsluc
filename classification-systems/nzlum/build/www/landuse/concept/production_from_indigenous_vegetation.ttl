@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:minimal_use_relatively_natural skos:notation "1.3.0" ;
    skos:prefLabel "Minimal use from relatively natural environments"@en .

luc:production_from_indigenous_vegetation.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:production_from_indigenous_vegetation.jsonld,
        luc:production_from_indigenous_vegetation.rdf,
        luc:production_from_indigenous_vegetation.ttl .

luc:production_from_indigenous_vegetation.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:production_from_indigenous_vegetation .

luc:production_from_indigenous_vegetation.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:production_from_indigenous_vegetation .

luc:production_from_indigenous_vegetation.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:production_from_indigenous_vegetation .

luc:production_from_indigenous_vegetation a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:changeNote "The definition of this class was clarified in NZLUM v0.4.0 by explicitly referring to non-plantation native forests."@en ;
    skos:definition "Commercial production from retained (non-plantation) native forests and related activities on public and private land (e.g. selective native timber production without clearfelling, and other non-sawlong, non-pulpwood, native forest products including oil, wildflowers, firewood, fenceposts, and mānuka/kānuka honey)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.3.4" ;
    skos:prefLabel "Production from indigenous vegetation"@en ;
    foaf:isPrimaryTopicOf luc:production_from_indigenous_vegetation.html .

