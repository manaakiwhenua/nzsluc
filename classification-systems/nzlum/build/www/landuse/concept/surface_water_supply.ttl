@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:minimal_use_relatively_natural skos:notation "1.3.0" ;
    skos:prefLabel "Minimal use from relatively natural environments"@en .

luc:surface_water_supply.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:surface_water_supply.jsonld,
        luc:surface_water_supply.rdf,
        luc:surface_water_supply.ttl .

luc:surface_water_supply.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:surface_water_supply .

luc:surface_water_supply.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:surface_water_supply .

luc:surface_water_supply.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:surface_water_supply .

luc:surface_water_supply a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "An area managed as a catchment for water supply."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.3.1" ;
    skos:prefLabel "Surface water supply"@en ;
    foaf:isPrimaryTopicOf luc:surface_water_supply.html .

