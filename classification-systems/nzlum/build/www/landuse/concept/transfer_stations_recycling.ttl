@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:transfer_stations_recycling.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:transfer_stations_recycling.jsonld,
        luc:transfer_stations_recycling.rdf,
        luc:transfer_stations_recycling.ttl .

luc:transfer_stations_recycling.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:transfer_stations_recycling .

luc:transfer_stations_recycling.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:transfer_stations_recycling .

luc:transfer_stations_recycling.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:transfer_stations_recycling .

luc:waste_treatment_disposal skos:notation "3.8.0" ;
    skos:prefLabel "Waste treatment and disposal"@en .

luc:transfer_stations_recycling a skos:Concept ;
    skos:broader luc:waste_treatment_disposal ;
    skos:definition "Facilities where solid waste is collected, sorted, processed, and prepared for recycling or transfer to landfills or other disposal sites."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "3.8.2" ;
    skos:prefLabel "Transfer stations and recycling facilities"@en ;
    foaf:isPrimaryTopicOf luc:transfer_stations_recycling.html .

