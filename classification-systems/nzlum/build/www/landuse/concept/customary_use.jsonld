      "skos:definition": {
        "@language": "en",
        "@value": "Natural environments associated with traditional and sustainable Indigenous food-gathering practices (mahinga kai)."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.0"
      },
      "skos:notation": "1.3.5",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Customary use"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "This may include land zoned for Māori purposes, and should only describe contemporary, not historical, use."
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "This is often an ancillary use; assign only if customary use is the prime use of the land."
      }
