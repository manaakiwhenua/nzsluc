@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:ground_water.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:ground_water.jsonld,
        luc:ground_water.rdf,
        luc:ground_water.ttl .

luc:ground_water.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:ground_water .

luc:ground_water.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:ground_water .

luc:ground_water.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:ground_water .

luc:minimal_use_relatively_natural skos:notation "1.3.0" ;
    skos:prefLabel "Minimal use from relatively natural environments"@en .

luc:ground_water a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "An area managed as an aquifer recharge zone."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.3.2" ;
    skos:prefLabel "Ground water"@en ;
    foaf:isPrimaryTopicOf luc:ground_water.html .

