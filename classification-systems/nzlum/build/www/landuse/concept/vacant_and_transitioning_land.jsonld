          "@id": "https://github.com/manaakiwhenua/nzsluc/issues/36"
        },
        {
          "@language": "en",
          "@value": "Preferred label changed from 'Land in transition' at v0.4.0"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "As a subclass of Production agriculture and plantations, land must recently have been used for agriculture or plantations."
