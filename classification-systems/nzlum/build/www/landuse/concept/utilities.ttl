@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:built_environment skos:notation "3.0.0" ;
    skos:prefLabel "Built environment"@en .

luc:electricity_substations_transmission skos:notation "3.5.5" ;
    skos:prefLabel "Electricity substations and transmission"@en .

luc:fuel_powered_electricity_generation skos:notation "3.5.1" ;
    skos:prefLabel "Fuel powered electricity generation"@en .

luc:gas_treatment_storage_transmission skos:notation "3.5.6" ;
    skos:prefLabel "Gas treatment, storage, and transmission"@en .

luc:hydroelectricity_generation skos:notation "3.5.2" ;
    skos:prefLabel "Hydroelectricity generation"@en .

luc:navigation_communication skos:notation "3.5.8" ;
    skos:prefLabel "Navigation and communication"@en .

luc:solar_electricity_generation skos:notation "3.5.4" ;
    skos:prefLabel "Solar electricity generation"@en .

luc:utilities.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:utilities.jsonld,
        luc:utilities.rdf,
        luc:utilities.ttl .

luc:utilities.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:utilities .

luc:utilities.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:utilities .

luc:utilities.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:utilities .

luc:water_extraction_transmission skos:notation "3.5.7" ;
    skos:prefLabel "Water extraction and transmission"@en .

luc:wind_electricity_generation skos:notation "3.5.3" ;
    skos:prefLabel "Wind electricity generation"@en .

luc:utilities a skos:Concept ;
    skos:broader luc:built_environment ;
    skos:changeNote <https://github.com/manaakiwhenua/nzsluc/issues/69>,
        "Class 3.5.0 redefined at v0.4.0 to include naviation and communciation infrastructure, which was formerly captured under class 3.6.0."@en ;
    skos:definition "Land allocated to providing electricity, gas, or water; or for navigation and communication infrastructure."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:narrower luc:electricity_substations_transmission,
        luc:fuel_powered_electricity_generation,
        luc:gas_treatment_storage_transmission,
        luc:hydroelectricity_generation,
        luc:navigation_communication,
        luc:solar_electricity_generation,
        luc:water_extraction_transmission,
        luc:wind_electricity_generation ;
    skos:notation "3.5.0" ;
    skos:prefLabel "Utilities"@en ;
    foaf:isPrimaryTopicOf luc:utilities.html ;
    lu:colour "#F8ADFA" .

