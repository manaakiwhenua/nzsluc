  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/indoor_recreation">
    <skos:definition xml:lang="en">Facilities designed for recreational activities conducted within enclosed or semi-enclosed structures.</skos:definition>
    <skos:notation>3.2.2</skos:notation>
    <skos:broader rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/public_recreation_services"/>
    <skos:example xml:lang="en">Sports centres, gyms, swimming pools, indoor arenas.</skos:example>
    <skos:prefLabel xml:lang="en">Indoor recreation</skos:prefLabel>
