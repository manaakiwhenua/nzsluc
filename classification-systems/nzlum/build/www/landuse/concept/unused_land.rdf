<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_land">
    <skos:notation>1.4.2</skos:notation>
    <skos:changeNote rdf:resource="https://github.com/manaakiwhenua/nzsluc/issues/36"/>
    <skos:example xml:lang="en">CERA Red Zone land in Christchurch, abandoned after the 2011 Canterbury earthquake and presently pending use.</skos:example>
    <skos:example xml:lang="en">A vacant farm, apparently undergoing natural succession.</skos:example>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_and_transitioning">
        <skos:prefLabel xml:lang="en">Unused and transitioning land</skos:prefLabel>
        <skos:notation>1.4.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <skos:definition xml:lang="en">Land that is unused or unusable for productive agriculture or urban uses, such as cliffs, rock faces, boulders, and tors, where there are relatively low levels of disturbance.</skos:definition>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:prefLabel xml:lang="en">Unused land</skos:prefLabel>
    <foaf:isPrimaryTopicOf>
      <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_land.html">
        <dcterms:format>text/html</dcterms:format>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_land.ttl"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_land.jsonld"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_land.rdf"/>
      </foaf:Document>
    </foaf:isPrimaryTopicOf>
  </skos:Concept>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_land.ttl">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_land"/>
    <dcterms:format>text/turtle</dcterms:format>
  </foaf:Document>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_land.rdf">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_land"/>
    <dcterms:format>application/rdf+xml</dcterms:format>
  </foaf:Document>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_land.jsonld">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_land"/>
    <dcterms:format>application/ld+json</dcterms:format>
  </foaf:Document>
</rdf:RDF>
