    "lus": "https://nzlum.landcareresearch.co.nz/landuse/scheme/",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@graph": [
    {
      "@id": "luc:unused_land",
      "@type": "skos:Concept",
      "foaf:isPrimaryTopicOf": {
        "@id": "luc:unused_land.html"
      },
      "skos:broader": {
        "@id": "luc:unused_and_transitioning"
      },
      "skos:changeNote": {
        "@id": "https://github.com/manaakiwhenua/nzsluc/issues/36"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land that is unused or unusable for productive agriculture or urban uses, such as cliffs, rock faces, boulders, and tors, where there are relatively low levels of disturbance."
      },
      "skos:example": [
        {
          "@language": "en",
          "@value": "CERA Red Zone land in Christchurch, abandoned after the 2011 Canterbury earthquake and presently pending use."
        },
        {
          "@language": "en",
          "@value": "A vacant farm, apparently undergoing natural succession."
        }
      ],
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "1.4.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unused land"
      }
    },
    {
      "@id": "luc:unused_land.ttl",
