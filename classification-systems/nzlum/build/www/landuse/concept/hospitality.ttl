@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:commercial skos:notation "3.3.0" ;
    skos:prefLabel "Commercial"@en .

luc:hospitality.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:hospitality.jsonld,
        luc:hospitality.rdf,
        luc:hospitality.ttl .

luc:hospitality.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:hospitality .

luc:hospitality.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:hospitality .

luc:hospitality.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:hospitality .

luc:hospitality a skos:Concept ;
    skos:broader luc:commercial ;
    skos:definition "Land and buildings providing accommodation, food, and beverage services to the public."@en ;
    skos:example "Hotels, motels, resorts, bed and breakfast establishments, restaurants, bars, nightclubs."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "3.3.3" ;
    skos:prefLabel "Hospitality"@en ;
    foaf:isPrimaryTopicOf luc:hospitality.html .

