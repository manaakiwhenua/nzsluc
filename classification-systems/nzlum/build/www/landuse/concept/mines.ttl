@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:mines.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:mines.jsonld,
        luc:mines.rdf,
        luc:mines.ttl .

luc:mines.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:mines .

luc:mines.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:mines .

luc:mines.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:mines .

luc:mining skos:notation "3.7.0" ;
    skos:prefLabel "Mining"@en .

luc:mines a skos:Concept ;
    skos:broader luc:mining ;
    skos:definition "Land from which minerals, precious stones or coal is being extracted, including open-cut and deep-shaft mines."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.7.1" ;
    skos:prefLabel "Mines"@en ;
    foaf:isPrimaryTopicOf luc:mines.html .

