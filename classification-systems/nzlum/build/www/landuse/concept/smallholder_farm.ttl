@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:production_agriculture_plantations skos:notation "2.0.0" ;
    skos:prefLabel "Production agriculture and plantations"@en .

luc:smallholder_farm.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:smallholder_farm.jsonld,
        luc:smallholder_farm.rdf,
        luc:smallholder_farm.ttl .

luc:smallholder_farm.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:smallholder_farm .

luc:smallholder_farm.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:smallholder_farm .

luc:smallholder_farm.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:smallholder_farm .

luc:smallholder_farm a skos:Concept ;
    skos:broader luc:production_agriculture_plantations ;
    skos:changeNote "Added at v0.4.0 to capture the gap between 3.1.4 Rural residential (0.4–2 ha) and commercial pastoral classes (2.2.0)."@en ;
    skos:definition "A rural property larger than a rural residential property (> 2 ha) but where the primary motivation is still residential rather than commercial agricultural production, and where any land management is low-intensity and incidental to the residential occupation."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.9.0" ;
    skos:prefLabel "Smallholder farm"@en ;
    skos:scopeNote "Extends 3.1.4 Rural residential to properties that exceed the lifestyle block size threshold but retain distinctive residential/lifestyle character. Distinguishable from 2.2.0 Grazing modified pasture systems by the absence of commercial pastoral intent and the relatively low level of active land management."@en,
        "Properties classified here may carry small numbers of stock or maintain informal pasture, but these activities are subsidiary to the residential use of the land."@en ;
    skos:usageNote "As a subclass of 2.0.0, commodities and management practices may still be recorded."@en,
        "Typical evidence: NDVR lifestyle codes (property uses 21 single-unit lifestyle, 22 multi-unit lifestyle) or possibly category L with land area in the range 2–40 ha. Properties substantially exceeding 40 ha with lifestyle NDVR codes should typically be excluded, in favour of classification under 2.2.2 or 2.2.3."@en ;
    foaf:isPrimaryTopicOf luc:smallholder_farm.html ;
    lu:colour "#E5D64F" .

