  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/office">
    <skos:definition xml:lang="en">Land and buildings primarily used for administrative, professional, or managerial activities.</skos:definition>
    <skos:example xml:lang="en">Corporate offices, professional services, banks, government buildings, business parks, coworking spaces.</skos:example>
    <skos:prefLabel xml:lang="en">Office</skos:prefLabel>
    <skos:notation>3.3.2</skos:notation>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/commercial">
        <skos:prefLabel xml:lang="en">Commercial</skos:prefLabel>
        <skos:notation>3.3.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <foaf:isPrimaryTopicOf>
