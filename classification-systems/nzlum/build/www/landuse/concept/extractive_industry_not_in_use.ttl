@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:extractive_industry_not_in_use.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:extractive_industry_not_in_use.jsonld,
        luc:extractive_industry_not_in_use.rdf,
        luc:extractive_industry_not_in_use.ttl .

luc:extractive_industry_not_in_use.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:extractive_industry_not_in_use .

luc:extractive_industry_not_in_use.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:extractive_industry_not_in_use .

luc:extractive_industry_not_in_use.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:extractive_industry_not_in_use .

luc:mining skos:notation "3.7.0" ;
    skos:prefLabel "Mining"@en .

luc:extractive_industry_not_in_use a skos:Concept ;
    skos:broader luc:mining ;
    skos:definition "Land undergoing rehabilitation after mining activities, and unmined land within a mining permit."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "3.7.5" ;
    skos:prefLabel "Extractive industry not in use"@en ;
    foaf:isPrimaryTopicOf luc:extractive_industry_not_in_use.html .

