@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:horse_studs.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:horse_studs.jsonld,
        luc:horse_studs.rdf,
        luc:horse_studs.ttl .

luc:horse_studs.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:horse_studs .

luc:horse_studs.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:horse_studs .

luc:horse_studs.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:horse_studs .

luc:intensive_animal_production skos:notation "2.6.0" ;
    skos:prefLabel "Intensive animal production"@en .

luc:horse_studs a skos:Concept ;
    skos:broader luc:intensive_animal_production ;
    skos:definition "Establishments focused on the breeding and raising of horses."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "2.6.4" ;
    skos:prefLabel "Horse studs"@en ;
    skos:usageNote "Applies to the intensive part of horse studs; relatively more extensive and pastoral aspects are not included."@en ;
    foaf:isPrimaryTopicOf luc:horse_studs.html .

