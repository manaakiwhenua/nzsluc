<rdf:RDF
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:dcterms="http://purl.org/dc/terms/"
>
  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/no_defined_use_ag">
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/vacant_and_transitioning_land">
        <skos:prefLabel xml:lang="en">Vacant and transitioning land</skos:prefLabel>
        <skos:notation>2.8.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <skos:notation>2.8.4</skos:notation>
    <skos:changeNote xml:lang="en">Changed notation at v0.4.0</skos:changeNote>
    <skos:definition xml:lang="en">Land cleared of vegetation where the current proposed land use is unknown.</skos:definition>
    <skos:example xml:lang="en">Land being prepared for new primary production use (farms, mines, etc.) but where the precise nature of the proposed land use is unknown.</skos:example>
    <skos:prefLabel xml:lang="en">No defined use</skos:prefLabel>
    <foaf:isPrimaryTopicOf>
      <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/no_defined_use_ag.html">
        <dcterms:format>text/html</dcterms:format>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/no_defined_use_ag.ttl"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/no_defined_use_ag.jsonld"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/no_defined_use_ag.rdf"/>
      </foaf:Document>
    </foaf:isPrimaryTopicOf>
  </skos:Concept>
