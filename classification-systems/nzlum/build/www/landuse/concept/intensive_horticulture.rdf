  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/intensive_horticulture">
    <skos:narrower>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/glasshouses_shadehouses">
        <skos:prefLabel xml:lang="en">Glasshouses/shadehouses</skos:prefLabel>
        <skos:notation>2.5.2</skos:notation>
      </rdf:Description>
    </skos:narrower>
    <skos:narrower rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/production_nurseries"/>
    <skos:definition xml:lang="en">Intensive forms of plant production, often with special-purpose improvements used for horticultural production.</skos:definition>
    <skos:usageNote xml:lang="en">Record management practices such as hydroponic systems, irrigation, and netting, if known.</skos:usageNote>
    <skos:usageNote xml:lang="en">The specific commodity or commodities should be noted if known.</skos:usageNote>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/production_agriculture_plantations">
        <skos:prefLabel xml:lang="en">Production agriculture and plantations</skos:prefLabel>
        <skos:notation>2.0.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <lu:colour>#4A4C39</lu:colour>
    <skos:notation>2.5.0</skos:notation>
    <skos:prefLabel xml:lang="en">Intensive horticulture</skos:prefLabel>
