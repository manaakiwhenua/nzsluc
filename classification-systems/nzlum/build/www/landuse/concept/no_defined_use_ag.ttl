@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:no_defined_use_ag.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:no_defined_use_ag.jsonld,
        luc:no_defined_use_ag.rdf,
        luc:no_defined_use_ag.ttl .

luc:no_defined_use_ag.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:no_defined_use_ag .

luc:no_defined_use_ag.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:no_defined_use_ag .

luc:no_defined_use_ag.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:no_defined_use_ag .

luc:vacant_and_transitioning_land skos:notation "2.8.0" ;
    skos:prefLabel "Vacant and transitioning land"@en .

luc:no_defined_use_ag a skos:Concept ;
    skos:broader luc:vacant_and_transitioning_land ;
    skos:changeNote "Changed notation at v0.4.0"@en ;
    skos:definition "Land cleared of vegetation where the current proposed land use is unknown."@en ;
    skos:example "Land being prepared for new primary production use (farms, mines, etc.) but where the precise nature of the proposed land use is unknown."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.8.4" ;
    skos:prefLabel "No defined use"@en ;
    foaf:isPrimaryTopicOf luc:no_defined_use_ag.html .

