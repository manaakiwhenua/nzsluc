      "lu:colour": "#7C76B6",
      "skos:broader": {
        "@id": "luc:nature_cons"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Protected area managed mainly for ecosystem conservation and recreation. A natural area of land, designated to:\n\n  a) protect the ecological integrity of one or more ecosystems for the current and future generations;\n\n  b) exclude exploitation or occupation detrimental to the purposes of designation of the area; and\n\n  c) provide a foundation for spiritual, scientific, educational, recreational and visitor opportunities, all of which must be environmentally and culturally compatible."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.0"
      },
      "skos:notation": "1.1.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "National Park"
      }
    },
