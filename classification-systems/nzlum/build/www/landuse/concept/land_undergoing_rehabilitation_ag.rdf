  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/land_undergoing_rehabilitation_ag">
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
    <skos:broader rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/land_in_transition_agriculture"/>
    <skos:notation>2.8.3</skos:notation>
    <skos:prefLabel xml:lang="en">Land undergoing rehabilitation</skos:prefLabel>
    <skos:definition xml:lang="en">Land in the process of rehabilitation for agricultural production (e.g. after significant flooding), and which is actively being recovered.</skos:definition>
