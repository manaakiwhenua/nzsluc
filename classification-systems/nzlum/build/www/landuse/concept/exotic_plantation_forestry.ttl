@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:exotic_plantation_forestry.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:exotic_plantation_forestry.jsonld,
        luc:exotic_plantation_forestry.rdf,
        luc:exotic_plantation_forestry.ttl .

luc:exotic_plantation_forestry.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:exotic_plantation_forestry .

luc:exotic_plantation_forestry.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:exotic_plantation_forestry .

luc:exotic_plantation_forestry.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:exotic_plantation_forestry .

luc:plantation_forests skos:notation "2.1.0" ;
    skos:prefLabel "Plantation forests"@en .

luc:exotic_plantation_forestry a skos:Concept ;
    skos:broader luc:plantation_forests ;
    skos:changeNote "Consideration of carbon sequestration and carbon credits were added in NZLUM v0.4.0"@en ;
    skos:definition "An area managed for pulpwood or saw-log production, or for carbon sequestration and carbon credits (exotic species)."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "2.1.1" ;
    skos:prefLabel "Exotic plantation forestry"@en ;
    skos:usageNote "Specific additional attributes that could be captured in comments or supplementary attributes are plantation age, rotation number, and species."@en,
        "The specific commodity or commodities should be noted if known."@en ;
    foaf:isPrimaryTopicOf luc:exotic_plantation_forestry.html .

