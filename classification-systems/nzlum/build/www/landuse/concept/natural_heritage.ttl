@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:cultural_natural_heritage skos:notation "1.2.0" ;
    skos:prefLabel "Cultural and natural heritage"@en .

luc:natural_heritage.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:natural_heritage.jsonld,
        luc:natural_heritage.rdf,
        luc:natural_heritage.ttl .

luc:natural_heritage.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:natural_heritage .

luc:natural_heritage.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:natural_heritage .

luc:natural_heritage.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:natural_heritage .

luc:natural_heritage a skos:Concept ;
    skos:broader luc:cultural_natural_heritage ;
    skos:definition "Protected areas for the conservation of specific natural features and landscapes (e.g. UNESCO Global Geoparks)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.2.3" ;
    skos:prefLabel "Natural heritage"@en ;
    foaf:isPrimaryTopicOf luc:natural_heritage.html .

