@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:seasonal_flowers_bulbs_turf.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:seasonal_flowers_bulbs_turf.jsonld,
        luc:seasonal_flowers_bulbs_turf.rdf,
        luc:seasonal_flowers_bulbs_turf.ttl .

luc:seasonal_flowers_bulbs_turf.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:seasonal_flowers_bulbs_turf .

luc:seasonal_flowers_bulbs_turf.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:seasonal_flowers_bulbs_turf .

luc:seasonal_flowers_bulbs_turf.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:seasonal_flowers_bulbs_turf .

luc:short_rotation_seasonal_cropping skos:notation "2.3.0" ;
    skos:prefLabel "Short-rotation and seasonal cropping"@en .

luc:seasonal_flowers_bulbs_turf a skos:Concept ;
    skos:broader luc:short_rotation_seasonal_cropping ;
    skos:definition "Cultivation of seasonal ornamental flowers, bulbs, and turf grass for commercial purposes."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "2.3.4" ;
    skos:prefLabel "Seasonal flowers and bulbs, and turf farming"@en ;
    skos:scopeNote "This class encompasses activities such as the cultivation of flowers and bulbs for seasonal markets, landscaping, and turf-farming for sports fields, lawns, and recreational areas."@en ;
    foaf:isPrimaryTopicOf luc:seasonal_flowers_bulbs_turf.html .

