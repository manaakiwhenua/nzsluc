@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:brownfield_development.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:brownfield_development.jsonld,
        luc:brownfield_development.rdf,
        luc:brownfield_development.ttl .

luc:brownfield_development.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:brownfield_development .

luc:brownfield_development.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:brownfield_development .

luc:brownfield_development.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:brownfield_development .

luc:vacant_transitioning_land_urban skos:notation "3.9.0" ;
    skos:prefLabel "Vacant and transitioning land"@en .

luc:brownfield_development a skos:Concept ;
    skos:broader luc:vacant_transitioning_land_urban ;
    skos:changeNote "Notation changed from 3.9.3 to 3.9.1 at v0.4.0" ;
    skos:definition "Areas of active redevelopment of previously developed (often industrial) land that may be abandoned, contaminated, or under-utilised, to rehabilitate and repurpose sites for new urban activities."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.9.1" ;
    skos:prefLabel "Brownfield development"@en ;
    skos:scopeNote "May include residential areas undergoing infill development that increase housing density."@en ;
    foaf:isPrimaryTopicOf luc:brownfield_development.html .

