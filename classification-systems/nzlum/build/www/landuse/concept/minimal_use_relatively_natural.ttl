@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:carbon_forest_retained skos:notation "1.3.8" ;
    skos:prefLabel "Carbon forest"@en .

luc:conservation skos:notation "1.0.0" ;
    skos:prefLabel "Conservation and Minimal Use"@en .

luc:customary_use skos:notation "1.3.5" ;
    skos:prefLabel "Customary use"@en .

luc:defence_land_natural_areas skos:notation "1.3.6" ;
    skos:prefLabel "Defence land"@en .

luc:environmental_infrastructure_protection skos:notation "1.3.7" ;
    skos:prefLabel "Environmental & infrastructure protection"@en .

luc:grazing_native_vegetation skos:notation "1.3.3" ;
    skos:prefLabel "Grazing native vegetation"@en .

luc:ground_water skos:notation "1.3.2" ;
    skos:prefLabel "Ground water"@en .

luc:minimal_use_relatively_natural.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:minimal_use_relatively_natural.jsonld,
        luc:minimal_use_relatively_natural.rdf,
        luc:minimal_use_relatively_natural.ttl .

luc:minimal_use_relatively_natural.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:minimal_use_relatively_natural .

luc:minimal_use_relatively_natural.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:minimal_use_relatively_natural .

luc:minimal_use_relatively_natural.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:minimal_use_relatively_natural .

luc:production_from_indigenous_vegetation skos:notation "1.3.4" ;
    skos:prefLabel "Production from indigenous vegetation"@en .

luc:surface_water_supply skos:notation "1.3.1" ;
    skos:prefLabel "Surface water supply"@en .

luc:minimal_use_relatively_natural a skos:Concept ;
    skos:broader luc:conservation ;
    skos:definition "This class includes land that is subject to relatively low levels of intervention or that is largely unused in the context of prime use or use for resource protection. This land may be covered with indigenous or exotic plant species. It includes land where the structure of the native vegetation generally remains intact despite deliberate use, although the floristics of the vegetation may have changed markedly (e.g. grazing on native tussock land)."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:narrower luc:carbon_forest_retained,
        luc:customary_use,
        luc:defence_land_natural_areas,
        luc:environmental_infrastructure_protection,
        luc:grazing_native_vegetation,
        luc:ground_water,
        luc:production_from_indigenous_vegetation,
        luc:surface_water_supply ;
    skos:notation "1.3.0" ;
    skos:prefLabel "Minimal use from relatively natural environments"@en ;
    skos:scopeNote "Where native grasses have been deliberately and extensively replaced with other species, the land use should not be classified under class 1."@en ;
    foaf:isPrimaryTopicOf luc:minimal_use_relatively_natural.html ;
    lu:colour "#FFC77A" .

