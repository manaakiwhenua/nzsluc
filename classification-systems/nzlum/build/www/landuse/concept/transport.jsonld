      },
      "lu:colour": "#72737E",
      "skos:broader": {
        "@id": "luc:built_environment"
      },
      "skos:changeNote": [
        {
          "@id": "https://github.com/manaakiwhenua/nzsluc/issues/69"
        },
        {
          "@language": "en",
          "@value": "Redefinition of class 3.6.0 to exclude navigation and communication infrastructure, which is now captured under 3.5.8. Renamed from 'Transport and communication'."
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Land allocated to infrastructure used for the transportation of goods or people."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.0"
      },
      "skos:narrower": [
        {
          "@id": "luc:airports_aerodromes"
        },
        {
          "@id": "luc:ports_water_transport"
        },
        {
          "@id": "luc:railways"
        },
        {
          "@id": "luc:roads"
        }
      ],
      "skos:notation": "3.6.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Transportation"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Zoning of land for roading or rail purposes that has not yet been constructed should be captured as attributes."
      }
    },
