<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:dcterms="http://purl.org/dc/terms/"
>
  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/environmental_infrastructure_protection">
    <skos:scopeNote xml:lang="en">Land planted for environmental and infrastructure protection should be captured under 2.1.4.</skos:scopeNote>
    <skos:scopeNote xml:lang="en">This is not limited to indigenous vegetation.</skos:scopeNote>
    <skos:prefLabel xml:lang="en">Environmental &amp; infrastructure protection</skos:prefLabel>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/minimal_use_relatively_natural">
        <skos:prefLabel xml:lang="en">Minimal use from relatively natural environments</skos:prefLabel>
        <skos:notation>1.3.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
    <skos:definition xml:lang="en">Land, usually under vegetative cover, used for non-production or environmental purposes (e.g. prevention of land degradation, windbreaks, shade, shelter). Includes land with a primary purpose of flood management (e.g. stop banks, spillways).</skos:definition>
    <skos:notation>1.3.7</skos:notation>
    <foaf:isPrimaryTopicOf>
      <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/environmental_infrastructure_protection.html">
        <dcterms:format>text/html</dcterms:format>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/environmental_infrastructure_protection.ttl"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/environmental_infrastructure_protection.jsonld"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/environmental_infrastructure_protection.rdf"/>
      </foaf:Document>
    </foaf:isPrimaryTopicOf>
  </skos:Concept>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/environmental_infrastructure_protection.jsonld">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/environmental_infrastructure_protection"/>
    <dcterms:format>application/ld+json</dcterms:format>
  </foaf:Document>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/environmental_infrastructure_protection.ttl">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/environmental_infrastructure_protection"/>
    <dcterms:format>text/turtle</dcterms:format>
  </foaf:Document>
