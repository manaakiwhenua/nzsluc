>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/environmental_infrastructure_protection.jsonld">
    <foaf:primaryTopic>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/environmental_infrastructure_protection">
        <skos:definition xml:lang="en">Land, usually under vegetative cover, used for non-production or environmental purposes (e.g. prevention of land degradation, windbreaks, shade, shelter). Includes land with a primary purpose of flood management (e.g. stop banks, spillways).</skos:definition>
        <skos:scopeNote xml:lang="en">This is not limited to indigenous vegetation.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Land planted for environmental and infrastructure protection should be captured under 2.1.4.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
        <skos:notation>1.3.7</skos:notation>
        <skos:broader rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/minimal_use_relatively_natural"/>
        <skos:prefLabel xml:lang="en">Environmental &amp; infrastructure protection</skos:prefLabel>
        <foaf:isPrimaryTopicOf rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/environmental_infrastructure_protection.html"/>
      </skos:Concept>
    </foaf:primaryTopic>
    <dcterms:format>application/ld+json</dcterms:format>
  </foaf:Document>
