@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:stock_water.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:stock_water.jsonld,
        luc:stock_water.rdf,
        luc:stock_water.ttl .

luc:stock_water.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:stock_water .

luc:stock_water.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:stock_water .

luc:stock_water.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:stock_water .

luc:water_wastewater_agriculture skos:notation "2.7.0" ;
    skos:prefLabel "Water and wastewater"@en .

luc:stock_water a skos:Concept ;
    skos:broader luc:water_wastewater_agriculture ;
    skos:definition "Reservoirs or farm dams on agricultural land for the purpose of supplying drinking-water for stock."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.7.1" ;
    skos:prefLabel "Stock water"@en ;
    foaf:isPrimaryTopicOf luc:stock_water.html .

