@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:commercial skos:notation "3.3.0" ;
    skos:prefLabel "Commercial"@en .

luc:office.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:office.jsonld,
        luc:office.rdf,
        luc:office.ttl .

luc:office.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:office .

luc:office.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:office .

luc:office.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:office .

luc:office a skos:Concept ;
    skos:broader luc:commercial ;
    skos:definition "Land and buildings primarily used for administrative, professional, or managerial activities."@en ;
    skos:example "Corporate offices, professional services, banks, government buildings, business parks, coworking spaces."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "3.3.2" ;
    skos:prefLabel "Office"@en ;
    foaf:isPrimaryTopicOf luc:office.html .

