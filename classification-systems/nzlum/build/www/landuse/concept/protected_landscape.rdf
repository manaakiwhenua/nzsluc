>
  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/protected_landscape">
    <skos:notation>1.1.6</skos:notation>
    <lu:colour>#E9E8F2</lu:colour>
    <skos:definition xml:lang="en">Protected area managed mainly for landscape conservation and recreation. An area of land where the interaction of people and nature over time has produced a distinct character with significant aesthetic, cultural or ecological value, and often high biodiversity.</skos:definition>
    <dcterms:source xml:lang="en">IUCN (2008) Protected Areas Management Categories, Category V: Protected Landscape/Seascape.</dcterms:source>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/nature_cons">
        <skos:prefLabel xml:lang="en">Nature conservation</skos:prefLabel>
        <skos:notation>1.1.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <skos:prefLabel xml:lang="en">Protected landscape</skos:prefLabel>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <foaf:isPrimaryTopicOf>
      <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/protected_landscape.html">
        <dcterms:format>text/html</dcterms:format>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/protected_landscape.ttl"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/protected_landscape.jsonld"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/protected_landscape.rdf"/>
      </foaf:Document>
    </foaf:isPrimaryTopicOf>
  </skos:Concept>
