        <skos:prefLabel xml:lang="en">Unused degraded land</skos:prefLabel>
        <skos:definition xml:lang="en">Unused land that is degraded through erosion or flood events that is not being rehabilitated.</skos:definition>
        <skos:usageNote xml:lang="en">Can include contaminated land.</skos:usageNote>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:historyNote xml:lang="en">Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0.</skos:historyNote>
