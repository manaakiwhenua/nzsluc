@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:nature_cons skos:notation "1.1.0" ;
    skos:prefLabel "Nature conservation"@en .

luc:protected_landscape.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:protected_landscape.jsonld,
        luc:protected_landscape.rdf,
        luc:protected_landscape.ttl .

luc:protected_landscape.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:protected_landscape .

luc:protected_landscape.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:protected_landscape .

luc:protected_landscape.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:protected_landscape .

luc:protected_landscape a skos:Concept ;
    dcterms:source "IUCN (2008) Protected Areas Management Categories, Category V: Protected Landscape/Seascape."@en ;
    skos:broader luc:nature_cons ;
    skos:definition "Protected area managed mainly for landscape conservation and recreation. An area of land where the interaction of people and nature over time has produced a distinct character with significant aesthetic, cultural or ecological value, and often high biodiversity."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.1.6" ;
    skos:prefLabel "Protected landscape"@en ;
    foaf:isPrimaryTopicOf luc:protected_landscape.html ;
    lu:colour "#E9E8F2" .

