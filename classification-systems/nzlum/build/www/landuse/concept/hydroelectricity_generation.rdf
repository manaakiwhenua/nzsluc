  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/hydroelectricity_generation">
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:definition xml:lang="en">Facilities that use the energy of flowing or falling water (typically hydroelectric dams) to generate electricity.</skos:definition>
    <skos:scopeNote xml:lang="en">Includes canals and other water conveyance infrastructure associated with hydroelectricity generation.</skos:scopeNote>
    <skos:prefLabel xml:lang="en">Hydroelectricity generation</skos:prefLabel>
    <skos:notation>3.5.2</skos:notation>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/utilities">
        <skos:prefLabel xml:lang="en">Utilities</skos:prefLabel>
        <skos:notation>3.5.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <foaf:isPrimaryTopicOf>
