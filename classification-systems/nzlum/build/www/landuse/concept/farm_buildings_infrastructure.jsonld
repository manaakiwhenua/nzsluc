        "@value": "Farm buildings/infrastructure"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "If it is possible to discriminate a domestic area from a farm, the house and adjoining non-productive land should be classified as 3.1.4 Rural residential."
