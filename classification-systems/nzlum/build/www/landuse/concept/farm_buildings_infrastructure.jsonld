      "skos:definition": {
        "@language": "en",
        "@value": "An area with buildings, sheds, and other infrastructure associated with farm enterprises supporting agricultural operations."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Barns, silos, storage sheds, and irrigation systems."
