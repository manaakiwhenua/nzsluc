@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:gas_treatment_storage_transmission.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:gas_treatment_storage_transmission.jsonld,
        luc:gas_treatment_storage_transmission.rdf,
        luc:gas_treatment_storage_transmission.ttl .

luc:gas_treatment_storage_transmission.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:gas_treatment_storage_transmission .

luc:gas_treatment_storage_transmission.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:gas_treatment_storage_transmission .

luc:gas_treatment_storage_transmission.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:gas_treatment_storage_transmission .

luc:utilities skos:notation "3.5.0" ;
    skos:prefLabel "Utilities"@en .

luc:gas_treatment_storage_transmission a skos:Concept ;
    skos:broader luc:utilities ;
    skos:definition "Facilities and infrastructure for processing, storage, and transport of natural gas."@en ;
    skos:example "Treatment plants, storage facilities, pipelines."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.5.6" ;
    skos:prefLabel "Gas treatment, storage, and transmission"@en ;
    foaf:isPrimaryTopicOf luc:gas_treatment_storage_transmission.html .

