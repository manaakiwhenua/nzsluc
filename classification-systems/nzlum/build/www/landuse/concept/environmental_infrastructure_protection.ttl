@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:environmental_infrastructure_protection.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:environmental_infrastructure_protection.jsonld,
        luc:environmental_infrastructure_protection.rdf,
        luc:environmental_infrastructure_protection.ttl .

luc:environmental_infrastructure_protection.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:environmental_infrastructure_protection .

luc:environmental_infrastructure_protection.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:environmental_infrastructure_protection .

luc:environmental_infrastructure_protection.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:environmental_infrastructure_protection .

luc:minimal_use_relatively_natural skos:notation "1.3.0" ;
    skos:prefLabel "Minimal use from relatively natural environments"@en .

luc:environmental_infrastructure_protection a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "Land, usually under vegetative cover, used for non-production or environmental purposes (e.g. prevention of land degradation, windbreaks, shade, shelter). Includes land with a primary purpose of flood management (e.g. stop banks, spillways)."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.3.7" ;
    skos:prefLabel "Environmental & infrastructure protection"@en ;
    skos:scopeNote "Land planted for environmental and infrastructure protection should be captured under 2.1.4."@en,
        "This is not limited to indigenous vegetation."@en ;
    foaf:isPrimaryTopicOf luc:environmental_infrastructure_protection.html .

