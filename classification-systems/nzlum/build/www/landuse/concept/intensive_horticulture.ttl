@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:glasshouses_shadehouses skos:notation "2.5.2" ;
    skos:prefLabel "Glasshouses/shadehouses"@en .

luc:intensive_horticulture.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:intensive_horticulture.jsonld,
        luc:intensive_horticulture.rdf,
        luc:intensive_horticulture.ttl .

luc:intensive_horticulture.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:intensive_horticulture .

luc:intensive_horticulture.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:intensive_horticulture .

luc:intensive_horticulture.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:intensive_horticulture .

luc:production_agriculture_plantations skos:notation "2.0.0" ;
    skos:prefLabel "Production agriculture and plantations"@en .

luc:production_nurseries skos:notation "2.5.1" ;
    skos:prefLabel "Production nurseries"@en .

luc:intensive_horticulture a skos:Concept ;
    skos:broader luc:production_agriculture_plantations ;
    skos:definition "Intensive forms of plant production, often with special-purpose improvements used for horticultural production."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:narrower luc:glasshouses_shadehouses,
        luc:production_nurseries ;
    skos:notation "2.5.0" ;
    skos:prefLabel "Intensive horticulture"@en ;
    skos:usageNote "Record management practices such as hydroponic systems, irrigation, and netting, if known."@en,
        "The specific commodity or commodities should be noted if known."@en ;
    foaf:isPrimaryTopicOf luc:intensive_horticulture.html ;
    lu:colour "#4A4C39" .

