  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/transportation_warehousing_commercial">
    <skos:prefLabel xml:lang="en">Transportation &amp; warehousing</skos:prefLabel>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/commercial">
        <skos:prefLabel xml:lang="en">Commercial</skos:prefLabel>
        <skos:notation>3.3.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <skos:notation>3.3.6</skos:notation>
    <skos:scopeNote xml:lang="en">Excludes airports, ports, roads, and train stations (captured under 3.6.0)</skos:scopeNote>
    <skos:definition xml:lang="en">Privately owned land associated with the movement and storage of goods, including distribution centres, warehouses, logistics facilities, car dealerships, and commercial parking lots.</skos:definition>
