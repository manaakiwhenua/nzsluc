@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:grazing_native_vegetation.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:grazing_native_vegetation.jsonld,
        luc:grazing_native_vegetation.rdf,
        luc:grazing_native_vegetation.ttl .

luc:grazing_native_vegetation.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:grazing_native_vegetation .

luc:grazing_native_vegetation.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:grazing_native_vegetation .

luc:grazing_native_vegetation.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:grazing_native_vegetation .

luc:minimal_use_relatively_natural skos:notation "1.3.0" ;
    skos:prefLabel "Minimal use from relatively natural environments"@en .

luc:grazing_native_vegetation a skos:Concept ;
    skos:broader luc:minimal_use_relatively_natural ;
    skos:definition "Land uses based on grazing by domestic stock on native vegetation where there has been limited or no deliberate attempt at pasture modification (e.g. native tussock grazing). Some change in species composition may have occurred."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "1.3.3" ;
    skos:prefLabel "Grazing native vegetation"@en ;
    skos:usageNote "This is probably limited to South Island high-country farms. Verification (e.g. assessment of vegetation on grazed land) to assess the extent of modification is required. ALUM specifies this class when there is greater than 50% dominant native species, although this criterion needs to be confirmed as being appropriate in a New Zealand context."@en ;
    foaf:isPrimaryTopicOf luc:grazing_native_vegetation.html .

