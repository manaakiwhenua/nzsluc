@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:waste_treatment_disposal skos:notation "3.8.0" ;
    skos:prefLabel "Waste treatment and disposal"@en .

luc:wastewater_treatment_land_application.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:wastewater_treatment_land_application.jsonld,
        luc:wastewater_treatment_land_application.rdf,
        luc:wastewater_treatment_land_application.ttl .

luc:wastewater_treatment_land_application.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:wastewater_treatment_land_application .

luc:wastewater_treatment_land_application.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:wastewater_treatment_land_application .

luc:wastewater_treatment_land_application.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:wastewater_treatment_land_application .

luc:wastewater_treatment_land_application a skos:Concept ;
    skos:broader luc:waste_treatment_disposal ;
    skos:definition "Areas where treated municipal wastewater is applied onto land for beneficial reuse, following appropriate treatment processes to ensure environmental safety."@en ;
    skos:example "Irrigation, groundwater recharge, soil fertility enhancement."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "3.8.4" ;
    skos:prefLabel "Wastewater treatment – land application"@en ;
    skos:usageNote " This is often likely to be an ancillary use."@en ;
    foaf:isPrimaryTopicOf luc:wastewater_treatment_land_application.html .

