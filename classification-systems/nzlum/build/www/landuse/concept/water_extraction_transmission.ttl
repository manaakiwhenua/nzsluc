@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:utilities skos:notation "3.5.0" ;
    skos:prefLabel "Utilities"@en .

luc:water_extraction_transmission.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:water_extraction_transmission.jsonld,
        luc:water_extraction_transmission.rdf,
        luc:water_extraction_transmission.ttl .

luc:water_extraction_transmission.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:water_extraction_transmission .

luc:water_extraction_transmission.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:water_extraction_transmission .

luc:water_extraction_transmission.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:water_extraction_transmission .

luc:water_extraction_transmission a skos:Concept ;
    skos:broader luc:utilities ;
    skos:definition "Facilities and infrastructure for extracting, purifying, treating, and transporting water from natural sources to meet human needs."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "3.5.7" ;
    skos:prefLabel "Water extraction and transmission"@en ;
    skos:scopeNote "Includes drinking water reservoirs."@en ;
    foaf:isPrimaryTopicOf luc:water_extraction_transmission.html .

