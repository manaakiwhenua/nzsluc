@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:national_park.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:national_park.jsonld,
        luc:national_park.rdf,
        luc:national_park.ttl .

luc:national_park.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:national_park .

luc:national_park.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:national_park .

luc:national_park.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:national_park .

luc:nature_cons skos:notation "1.1.0" ;
    skos:prefLabel "Nature conservation"@en .

luc:national_park a skos:Concept ;
    dcterms:source "IUCN (2008) Protected Areas Management Categories, Category Ib: national park."@en ;
    skos:broader luc:nature_cons ;
    skos:definition """Protected area managed mainly for ecosystem conservation and recreation. A natural area of land, designated to:

  a) protect the ecological integrity of one or more ecosystems for the current and future generations;

  b) exclude exploitation or occupation detrimental to the purposes of designation of the area; and

  c) provide a foundation for spiritual, scientific, educational, recreational and visitor opportunities, all of which must be environmentally and culturally compatible."""@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "1.1.3" ;
    skos:prefLabel "National Park"@en ;
    foaf:isPrimaryTopicOf luc:national_park.html ;
    lu:colour "#7C76B6" .

