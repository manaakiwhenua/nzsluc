  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/short_rotation_horticulture">
    <skos:scopeNote xml:lang="en">May include livestock rotations, but this is considered less likely</skos:scopeNote>
    <skos:notation>2.3.3</skos:notation>
    <skos:prefLabel xml:lang="en">Short-rotation horticulture</skos:prefLabel>
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/short_rotation_seasonal_cropping">
        <skos:prefLabel xml:lang="en">Short-rotation and seasonal cropping</skos:prefLabel>
        <skos:notation>2.3.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <skos:usageNote xml:lang="en">The specific commodity or commodities should be noted if known.</skos:usageNote>
    <skos:definition xml:lang="en">Crop plants living for less than 2 years that are intensively cultivated; predominantly rotations of vegetable crops or seasonal fruits grown for human consumption.</skos:definition>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.3.0"/>
