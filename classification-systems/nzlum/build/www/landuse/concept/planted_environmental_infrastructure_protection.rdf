        <skos:broader rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/plantation_forests"/>
        <skos:definition xml:lang="en">An area managed for environmental and indirect production uses (e.g. prevention of land degradation, windbreaks, shade, and shelter) where trees or shrubs have been planted.</skos:definition>
