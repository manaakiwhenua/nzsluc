  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/vacant_and_transitioning_land.rdf">
    <foaf:primaryTopic>
      <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/vacant_and_transitioning_land">
        <skos:notation>2.8.0</skos:notation>
        <skos:narrower rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/abandoned_land_ag"/>
        <skos:narrower rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/rehabilitating_land_ag"/>
        <skos:narrower rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/no_defined_use_ag"/>
        <skos:narrower rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/degraded_land_ag"/>
        <skos:prefLabel xml:lang="en">Vacant and transitioning land</skos:prefLabel>
        <skos:changeNote rdf:resource="https://github.com/manaakiwhenua/nzsluc/issues/36"/>
        <skos:changeNote xml:lang="en">Preferred label changed from 'Land in transition' at v0.4.0</skos:changeNote>
        <lu:colour>#BCBFE1</lu:colour>
        <skos:broader rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/production_agriculture_plantations"/>
        <skos:scopeNote xml:lang="en">In the case of greenfield development where land use is transitioning to a built-environment category, classify under 3.9.0 Vacant and transitioning land (or a subclass) rather than 2.8.0.</skos:scopeNote>
        <skos:definition xml:lang="en">As a subclass of Production agriculture and plantations, land must recently have been used for agriculture or plantations.</skos:definition>
        <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
        <foaf:isPrimaryTopicOf rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/vacant_and_transitioning_land.html"/>
      </skos:Concept>
    </foaf:primaryTopic>
    <dcterms:format>application/rdf+xml</dcterms:format>
  </foaf:Document>
