@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:stormwater_management.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:stormwater_management.jsonld,
        luc:stormwater_management.rdf,
        luc:stormwater_management.ttl .

luc:stormwater_management.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:stormwater_management .

luc:stormwater_management.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:stormwater_management .

luc:stormwater_management.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:stormwater_management .

luc:waste_treatment_disposal skos:notation "3.8.0" ;
    skos:prefLabel "Waste treatment and disposal"@en .

luc:stormwater_management a skos:Concept ;
    skos:broader luc:waste_treatment_disposal ;
    skos:definition "Infrastructure aimed at controlling and mitigating stormwater runoff to prevent flooding, erosion, and pollution."@en ;
    skos:example "Detention basins, drainage systems, retention ponds, rain gardens, wetlands."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "3.8.5" ;
    skos:prefLabel "Stormwater management"@en ;
    foaf:isPrimaryTopicOf luc:stormwater_management.html .

