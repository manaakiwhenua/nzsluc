@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:water_treatment_wetland.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:water_treatment_wetland.jsonld,
        luc:water_treatment_wetland.rdf,
        luc:water_treatment_wetland.ttl .

luc:water_treatment_wetland.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:water_treatment_wetland .

luc:water_treatment_wetland.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:water_treatment_wetland .

luc:water_treatment_wetland.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:water_treatment_wetland .

luc:water_wastewater_agriculture skos:notation "2.7.0" ;
    skos:prefLabel "Water and wastewater"@en .

luc:water_treatment_wetland a skos:Concept ;
    skos:broader luc:water_wastewater_agriculture ;
    skos:definition "Constructed or natural wetlands used to improve water quality prior to discharge."@en ;
    skos:inScheme lus:nzlum0.4.0 ;
    skos:notation "2.7.4" ;
    skos:prefLabel "Water treatment – wetland"@en ;
    foaf:isPrimaryTopicOf luc:water_treatment_wetland.html .

