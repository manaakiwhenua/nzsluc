<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:dcterms="http://purl.org/dc/terms/"
>
  <skos:Concept rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/rehabilitating_land">
    <skos:broader>
      <rdf:Description rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/unused_and_transitioning">
        <skos:prefLabel xml:lang="en">Unused and transitioning land</skos:prefLabel>
        <skos:notation>1.4.0</skos:notation>
      </rdf:Description>
    </skos:broader>
    <skos:inScheme rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/scheme/nzlum0.4.0"/>
    <skos:definition xml:lang="en">Degraded land (e.g. due to erosion or flood damage) that is being actively rehabilitated through planting with indigenous or exotic species to return land to a natural state.</skos:definition>
    <skos:scopeNote xml:lang="en">This may include riparian plantings.</skos:scopeNote>
    <skos:notation>1.4.1</skos:notation>
    <skos:changeNote rdf:resource="https://github.com/manaakiwhenua/nzsluc/issues/36"/>
    <skos:prefLabel xml:lang="en">Rehabilitating land</skos:prefLabel>
    <foaf:isPrimaryTopicOf>
      <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/rehabilitating_land.html">
        <dcterms:format>text/html</dcterms:format>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/rehabilitating_land.ttl"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/rehabilitating_land.jsonld"/>
        <dcterms:hasFormat rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/rehabilitating_land.rdf"/>
      </foaf:Document>
    </foaf:isPrimaryTopicOf>
  </skos:Concept>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/rehabilitating_land.rdf">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/rehabilitating_land"/>
    <dcterms:format>application/rdf+xml</dcterms:format>
  </foaf:Document>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/rehabilitating_land.ttl">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/rehabilitating_land"/>
    <dcterms:format>text/turtle</dcterms:format>
  </foaf:Document>
  <foaf:Document rdf:about="https://nzlum.landcareresearch.co.nz/landuse/concept/rehabilitating_land.jsonld">
    <foaf:primaryTopic rdf:resource="https://nzlum.landcareresearch.co.nz/landuse/concept/rehabilitating_land"/>
    <dcterms:format>application/ld+json</dcterms:format>
  </foaf:Document>
</rdf:RDF>
