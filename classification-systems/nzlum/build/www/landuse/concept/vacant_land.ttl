@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:vacant_land.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:vacant_land.jsonld,
        luc:vacant_land.rdf,
        luc:vacant_land.ttl .

luc:vacant_land.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:vacant_land .

luc:vacant_land.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:vacant_land .

luc:vacant_land.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:vacant_land .

luc:vacant_transitioning_land_urban skos:notation "3.9.0" ;
    skos:prefLabel "Vacant and transitioning land"@en .

luc:vacant_land a skos:Concept ;
    skos:broader luc:vacant_transitioning_land_urban ;
    skos:changeNote "Notation changed from 3.9.1 to 3.9.3 at v0.4.0" ;
    skos:definition "Derelict land and developed land that is idle."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:notation "3.9.3" ;
    skos:prefLabel "Idle and derelict land"@en ;
    foaf:isPrimaryTopicOf luc:vacant_land.html .

