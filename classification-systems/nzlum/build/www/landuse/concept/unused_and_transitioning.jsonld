    },
    {
      "@id": "luc:unused_land",
      "skos:notation": "1.4.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unused land"
      }
    },
    {
      "@id": "luc:conservation",
      "skos:notation": "1.0.0",
