@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix luc: <https://nzlum.landcareresearch.co.nz/landuse/concept/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

luc:built_environment skos:notation "3.0.0" ;
    skos:prefLabel "Built environment"@en .

luc:community_services skos:notation "3.2.3" ;
    skos:prefLabel "Community services"@en .

luc:indoor_recreation skos:notation "3.2.2" ;
    skos:prefLabel "Indoor recreation"@en .

luc:outdoor_recreation skos:notation "3.2.1" ;
    skos:prefLabel "Outdoor recreation"@en .

luc:public_recreation_services.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat luc:public_recreation_services.jsonld,
        luc:public_recreation_services.rdf,
        luc:public_recreation_services.ttl .

luc:public_recreation_services.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic luc:public_recreation_services .

luc:public_recreation_services.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic luc:public_recreation_services .

luc:public_recreation_services.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic luc:public_recreation_services .

luc:public_recreation_services a skos:Concept ;
    skos:broader luc:built_environment ;
    skos:definition "Land designated for recreational facilities and community amenities, serving recreational needs and essential functions of the local population."@en ;
    skos:inScheme lus:nzlum0.3.0,
        lus:nzlum0.4.0 ;
    skos:narrower luc:community_services,
        luc:indoor_recreation,
        luc:outdoor_recreation ;
    skos:notation "3.2.0" ;
    skos:prefLabel "Public recreation and services"@en ;
    foaf:isPrimaryTopicOf luc:public_recreation_services.html ;
    lu:colour "#C19878" .

