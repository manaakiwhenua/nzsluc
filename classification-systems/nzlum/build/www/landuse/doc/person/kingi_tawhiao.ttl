@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu_person: <https://nzlum.landcareresearch.co.nz/landuse/doc/person/> .
@prefix lu_proverb: <https://nzlum.landcareresearch.co.nz/landuse/doc/proverb/> .

lu_proverb:kotahi_te_aho dcterms:creator lu_person:kingi_tawhiao .

lu_person:kingi_tawhiao.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat lu_person:kingi_tawhiao.jsonld,
        lu_person:kingi_tawhiao.rdf,
        lu_person:kingi_tawhiao.ttl .

lu_person:kingi_tawhiao.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic lu_person:kingi_tawhiao .

lu_person:kingi_tawhiao.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic lu_person:kingi_tawhiao .

lu_person:kingi_tawhiao.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic lu_person:kingi_tawhiao .

lu_person:kingi_tawhiao a foaf:Person ;
    foaf:isPrimaryTopicOf lu_person:kingi_tawhiao.html ;
    foaf:name "Kīngi Tāwhiao"@mi,
        "Tūkaroto Matutaera Pōtatau Te Wherowhero Tāwhiao"@mi .

