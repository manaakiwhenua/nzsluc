@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wtr: <https://nzlum.landcareresearch.co.nz/landuse/water-feature/> .

lus:water_features dcterms:title "NZLUM water features"@en .

wtr:reef.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat wtr:reef.jsonld,
        wtr:reef.rdf,
        wtr:reef.ttl .

wtr:reef.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic wtr:reef .

wtr:reef.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic wtr:reef .

wtr:reef.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic wtr:reef .

wtr:reef a skos:Concept ;
    skos:inScheme lus:water_features ;
    skos:notation "reef" ;
    foaf:isPrimaryTopicOf wtr:reef.html ;
    lu:colour "#A9B0AD" .

