@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wtr: <https://nzlum.landcareresearch.co.nz/landuse/water-feature/> .

lus:water_features dcterms:title "NZLUM water features"@en .

wtr:swamp.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat wtr:swamp.jsonld,
        wtr:swamp.rdf,
        wtr:swamp.ttl .

wtr:swamp.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic wtr:swamp .

wtr:swamp.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic wtr:swamp .

wtr:swamp.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic wtr:swamp .

wtr:swamp a skos:Concept ;
    skos:inScheme lus:water_features ;
    skos:notation "swamp" ;
    foaf:isPrimaryTopicOf wtr:swamp.html ;
    lu:colour "#83B09E" .

