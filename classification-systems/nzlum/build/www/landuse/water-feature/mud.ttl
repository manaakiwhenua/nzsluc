@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lu: <https://nzlum.landcareresearch.co.nz/landuse/> .
@prefix lus: <https://nzlum.landcareresearch.co.nz/landuse/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wtr: <https://nzlum.landcareresearch.co.nz/landuse/water-feature/> .

lus:water_features dcterms:title "NZLUM water features"@en .

wtr:mud.html a foaf:Document ;
    dcterms:format "text/html" ;
    dcterms:hasFormat wtr:mud.jsonld,
        wtr:mud.rdf,
        wtr:mud.ttl .

wtr:mud.jsonld a foaf:Document ;
    dcterms:format "application/ld+json" ;
    foaf:primaryTopic wtr:mud .

wtr:mud.rdf a foaf:Document ;
    dcterms:format "application/rdf+xml" ;
    foaf:primaryTopic wtr:mud .

wtr:mud.ttl a foaf:Document ;
    dcterms:format "text/turtle" ;
    foaf:primaryTopic wtr:mud .

wtr:mud a skos:Concept ;
    skos:inScheme lus:water_features ;
    skos:notation "mud" ;
    foaf:isPrimaryTopicOf wtr:mud.html ;
    lu:colour "#D9C49E" .

