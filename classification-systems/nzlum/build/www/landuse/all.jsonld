      "skos:prefLabel": {
        "@language": "en",
        "@value": "Airports/aerodromes"
      }
    },
    {
      "@id": "luc:short_rotation_seasonal_cropping",
      "@type": "skos:Concept",
      "lu:colour": "#7F7F54",
      "skos:broader": {
        "@id": "luc:production_agriculture_plantations"
      },
      "skos:changeNote": [
        {
          "@id": "https://github.com/manaakiwhenua/nzsluc/issues/65"
        },
        {
          "@language": "en",
          "@value": "The explicit five year periodicity was added in v0.4.0."
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "This class includes agricultural practices characterised by the cultivation of crops with rapid turnover cycles and seasonal planting patterns, typically optimised for efficient land use and high-yield production."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:narrower": [
        {
          "@id": "luc:seasonal_flowers_bulbs_turf"
        },
        {
          "@id": "luc:short_rotation_horticulture"
        },
        {
          "@id": "luc:arable_cropping"
        },
        {
          "@id": "luc:arable_mixed_livestock_cropping"
        }
      ],
      "skos:notation": "2.3.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Short-rotation and seasonal cropping"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "The period of rotation to be considered (e.g. in the listing of commodities, or when deciding whether there is any rotation at all) is five years."
        },
        {
          "@language": "en",
          "@value": "Arable, and mixed livestock cropping, integrating both crop cultivation and animal husbandry, are also included in this class."
        },
        {
          "@language": "en",
          "@value": "This class encompasses agricultural activities such as the cultivation of fast-growing crops such as maize, barley, and certain vegetables, often rotated on short-term cycles to maintain soil health and maximise productivity."
        }
      ],
      "skos:usageNote": {
        "@language": "en",
        "@value": "If the type of crop is known, record this in the commodity field. For mixed arable and livestock operations, both commodities should be captured as the primary commodity (neither is ancillary)."
      }
    },
