    {
      "@id": "luc:indigenous_plantation_forestry",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "luc:plantation_forests"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "Consideration of carbon sequestration and carbon credits were added in NZLUM v0.4.0"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area managed for pulpwood or saw-log production, or for carbon sequestration and carbon credits (native species)."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "2.1.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Indigenous plantation forestry"
      },
      "skos:usageNote": [
        {
          "@language": "en",
          "@value": "Specific additional attributes that could be captured in comments or supplementary attributes are plantation age, rotation number, and species."
        },
        {
          "@language": "en",
          "@value": "The specific commodity or commodities should be noted if known."
        }
      ]
    },
