        },
        {
          "@id": "mgmt:milking_herringbone"
        }
      ],
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Animal"
      }
    },
    {
      "@id": "luc:rehabilitating_land_ag",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "luc:vacant_and_transitioning_land"
      },
      "skos:changeNote": "Changed notation at v0.4.0",
      "skos:definition": {
        "@language": "en",
        "@value": "Land in the process of rehabilitation for agricultural production (e.g. after significant flooding), and which is actively being recovered."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.0"
      },
      "skos:notation": "2.8.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Rehabilitating land"
      }
    },
    {
      "@id": "luc:unused_degraded_land_ag",
      "@type": "skos:Concept",
      "owl:deprecated": true,
      "skos:broader": {
        "@id": "luc:land_in_transition_agriculture"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Unused land that is degraded through erosion or flood events that is not being rehabilitated."
      },
      "skos:historyNote": {
        "@language": "en",
        "@value": "Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.3.0"
      },
      "skos:notation": "2.8.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unused degraded land"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Can include contaminated land."
      }
    },
    {
      "@id": "luc:tree_crops",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "luc:perennial_horticulture"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Long-term cultivated plants, typically trees or woody shrubs, grown for fruits, nuts, or other edible parts. These crops require intensive management practices aimed at ensuring optimal growth, productivity, and quality over multiple years."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "2.4.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Tree crops"
      },
      "skos:usageNote": [
        {
          "@language": "en",
          "@value": "Examples include orchard fruits such as olives, apples, oranges, and apricots, as well as tree nuts such as hazelnuts, macadamias, and chestnuts, which should be recorded in the commodity attribute, if known."
        },
        {
          "@language": "en",
          "@value": "Management practices may include pruning, pest and disease control, irrigation, and harvesting techniques specific to tree crops."
        }
      ]
    },
    {
      "@id": "com:cranberries",
