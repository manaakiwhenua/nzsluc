      "lu:colour": "#E09962",
      "skos:broader": {
        "@id": "luc:public_recreation_services"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land used for providing essential services and facilities to support the local community."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Educational institutions, public healthcare facilities, libraries, museums, courts, prisons, civic buildings, emergency services, marae, religious buildings, cemeteries."
