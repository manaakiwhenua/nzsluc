      },
      "skos:notation": "cropping row alley"
    },
    {
      "@id": "luc:intensive_dry_stock",
      "@type": "skos:Concept",
      "lu:colour": "#357735",
      "skos:broader": {
        "@id": "luc:grazing_modified_pasture_systems"
      },
      "skos:changeNote": [
        {
          "@id": "https://github.com/manaakiwhenua/nzsluc/issues/66"
        },
        {
          "@language": "en",
          "@value": "A prior definition of this classes treated deer, goats, and horses as extensive by definition; it is now recogised that such systems can also be intensive."
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Non-milking platform grazing land with higher inputs (e.g. fertiliser), higher likelihood of irrigation, and higher stocking rates; typically on flat or rolling terrain."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "2.2.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Intensive dry stock"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Land used for high-intensity dry-stock grazing may include rotations for arable or winter forage crops, as well as grazing of non-lactating (dry) dairy cattle, beef cattle, sheep, and cattle breeding."
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Stock density is an ideal attribute to assist in classification of intensive vs extensive dry stock; physiography (i.e. flat/hill/high country) can be used as a proxy where stock density data is absent."
      }
    },
