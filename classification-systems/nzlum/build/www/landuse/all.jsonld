      "lu:colour": "#8D7735",
      "skos:broader": {
        "@id": "luc:grazing_modified_pasture_systems"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land on which milking cows (or other stock, such as goats or sheep) are grazed during the milking season, where dairy is the primary purpose of the land."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
