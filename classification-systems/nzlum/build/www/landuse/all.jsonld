    {
      "@id": "luc:permanent_carbon_forest",
      "@type": "skos:Concept",
      "owl:deprecated": true,
      "skos:broader": {
        "@id": "luc:plantation_forests"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "Retired at NZLUM v0.3 and replaced with consideration of carbon sequestration and carbon credits in the definitions of exotic and indigenous plantation forestry."
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An area planted with indigenous or exotic trees for the purpose of gaining carbon credits (carbon farming)."
      },
      "skos:historyNote": {
        "@language": "en",
        "@value": "Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.3.0"
      },
      "skos:notation": "2.1.5",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Permanent carbon forest"
      }
    },
