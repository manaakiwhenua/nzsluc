    {
      "@id": "luc:other_conserved_area",
      "@type": "skos:Concept",
      "lu:colour": "#FCFBFD",
      "skos:broader": {
        "@id": "luc:nature_cons"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land under forms of nature conservation protection that fall outside the scope of the CAPAD classification. This includes heritage agreements, voluntary conservation arrangements, registered property agreements, and recreation areas with primarily native cover ."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "1.1.7",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Other conserved area"
      },
      "skos:scopeNote": "If the recreation area is primarily cleared or non-native cover assign to 3.2.1 ‘Outdoor recreation’"
    },
    {
      "@id": "luc:national_park",
      "@type": "skos:Concept",
      "dcterms:source": {
        "@language": "en",
        "@value": "IUCN (2008) Protected Areas Management Categories, Category Ib: national park."
      },
      "lu:colour": "#7C76B6",
      "skos:broader": {
        "@id": "luc:nature_cons"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Protected area managed mainly for ecosystem conservation and recreation. A natural area of land, designated to:\n\n  a) protect the ecological integrity of one or more ecosystems for the current and future generations;\n\n  b) exclude exploitation or occupation detrimental to the purposes of designation of the area; and\n\n  c) provide a foundation for spiritual, scientific, educational, recreational and visitor opportunities, all of which must be environmentally and culturally compatible."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "1.1.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "National Park"
      }
    },
