    {
      "@id": "lu_proverb:kotahi_te_aho",
      "@type": "dcterms:BibliographicResource",
      "dcterms:creator": {
        "@id": "lu_person:kingi_tawhiao"
      },
      "dcterms:description": [
        {
          "@language": "en",
          "@value": "One strand of flax is easy to break, but many strands together will stand strong."
        },
        {
          "@language": "mi",
          "@value": "Kotahi te aho ka whati, ki te kāpuia e kore e whati."
        }
      ]
    },
