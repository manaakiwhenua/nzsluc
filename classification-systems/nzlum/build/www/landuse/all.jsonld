    {
      "@id": "luc:ports_water_transport",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "luc:transport"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Harbour locations where ships dock to transfer people or cargo, including terrestrial parts and designated marine areas that are specifically designated and controlled for activities associated with the port."
      },
      "skos:example": [
        {
          "@language": "en",
          "@value": "Harbours, navigational channels."
        },
        {
          "@language": "en",
          "@value": "Ports, docks, and wharves."
        }
      ],
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "3.6.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Ports and water transport"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "The water attribute can be used to differentiate the terrestrial and marine parts of the same facility."
      }
    },
    {
      "@id": "luc:hospitality",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "luc:commercial"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land and buildings providing accommodation, food, and beverage services to the public."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Hotels, motels, resorts, bed and breakfast establishments, restaurants, bars, nightclubs."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "3.3.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Hospitality"
      }
    },
    {
      "@id": "luc:high_density_residential",
      "@type": "skos:Concept",
      "lu:colour": "#4C3B39",
      "skos:broader": {
        "@id": "luc:residential"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Areas characterised by a high concentration of housing units per unit of land area, typically in multi-storey buildings or high-rise developments, often found in urban centres supporting high population density."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "3.1.1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "High-density residential"
      }
    },
    {
      "@id": "luc:unused_land_transition",
      "@type": "skos:Concept",
      "lu:colour": "#C8C69F",
      "owl:deprecated": true,
      "skos:broader": {
        "@id": "luc:conservation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Corridors and roadside areas may fit under this class, along with unused land (in the sense of productive, conservation or urban use), such as cliffs, rock faces, boulders, and tors, where there are relatively low levels of disturbance. It does not include land undergoing natural succession in the context of changing plant species."
      },
      "skos:historyNote": {
        "@language": "en",
        "@value": "Last included in NZLUM 0.3.0; not carried into NZLUM 0.4.0."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.3.0"
      },
      "skos:narrower": [
        {
          "@id": "luc:unused_land"
        },
        {
          "@id": "luc:land_undergoing_rehabilitation_natural"
        }
      ],
      "skos:notation": "1.4.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unused land and land in transition"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Delineation between indigenous and exotic vegetation for the minimal use and unused land and land in transition classes can be made by reference to land-cover information."
      }
    },
