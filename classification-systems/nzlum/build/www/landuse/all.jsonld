    {
      "@id": "luc:medium_density_residential",
      "@type": "skos:Concept",
      "lu:colour": "#644E4C",
      "skos:broader": {
        "@id": "luc:residential"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Areas featuring a moderate concentration of housing units per unit of land area, often in suburban or semi-urban settings."
      },
      "skos:example": {
        "@language": "en",
        "@value": "Townhouses, terraced housing, low-rise apartments."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "3.1.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Medium-density residential"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Alignment to the Medium Density Residential Standards (MfE 2022) should be considered."
      }
    },
    {
      "@id": "luc:arable_mixed_livestock_cropping",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "luc:short_rotation_seasonal_cropping"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Predominantly grain, seed, or fodder crops; over time it may include short-term (c. 1–3 years) pasture and livestock rotations, and/or vegetable rotations. Pasture and livestock rotations may occur less than 50% of the time.."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "2.3.2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Arable and mixed livestock cropping"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Includes maize, barley, wheat, peas, other grain and seed crops, and fodder crops. May be used for dairy support (which should be recorded as a management practice, if this is known)."
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "The specific commodity or commodities should be noted if known."
      }
    },
    {
      "@id": "luc:smallholder_farm",
      "@type": "skos:Concept",
      "lu:colour": "#E5D64F",
      "skos:broader": {
        "@id": "luc:production_agriculture_plantations"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "Added at v0.4.0 to capture the gap between 3.1.4 Rural residential (0.4–2 ha) and commercial pastoral classes (2.2.0)."
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A rural property larger than a rural residential property (> 2 ha) but where the primary motivation is still residential rather than commercial agricultural production, and where any land management is low-intensity and incidental to the residential occupation."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.0"
      },
      "skos:notation": "2.9.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Smallholder farm"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "Extends 3.1.4 Rural residential to properties that exceed the lifestyle block size threshold but retain distinctive residential/lifestyle character. Distinguishable from 2.2.0 Grazing modified pasture systems by the absence of commercial pastoral intent and the relatively low level of active land management."
        },
        {
          "@language": "en",
          "@value": "Properties classified here may carry small numbers of stock or maintain informal pasture, but these activities are subsidiary to the residential use of the land."
        }
      ],
      "skos:usageNote": [
        {
          "@language": "en",
          "@value": "As a subclass of 2.0.0, commodities and management practices may still be recorded."
        },
        {
          "@language": "en",
          "@value": "Typical evidence: NDVR lifestyle codes (property uses 21 single-unit lifestyle, 22 multi-unit lifestyle) or possibly category L with land area in the range 2–40 ha. Properties substantially exceeding 40 ha with lifestyle NDVR codes should typically be excluded, in favour of classification under 2.2.2 or 2.2.3."
        }
      ]
    },
    {
      "@id": "com:tomatoes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "lus:commodities"
      },
      "skos:notation": "tomatoes"
    },
    {
      "@id": "luc:community_services",
