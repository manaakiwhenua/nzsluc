    {
      "@id": "luc:conservation",
      "@type": "skos:Concept",
      "skos:definition": {
        "@language": "en",
        "@value": "Land that has a relatively low level of human intervention. The land may be formally reserved by government for conservation purposes, or conserved through other legal or administrative arrangements. Areas may have multiple uses but nature conservation is a central consideration. (Some land may be unused because of a deliberate decision of the government or landowner, or due to circumstances)."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:narrower": [
        {
          "@id": "luc:unused_and_transitioning"
        },
        {
          "@id": "luc:cultural_natural_heritage"
        },
        {
          "@id": "luc:nature_cons"
        },
        {
          "@id": "luc:minimal_use_relatively_natural"
        }
      ],
      "skos:notation": "1.0.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Conservation and Minimal Use"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Areas with lower levels of biodiversity protection are anticipated to have other primary uses, but biodiversity protection ranking could be captured as an ancillary use with class 1.1.4 and 1.1.5."
      },
      "skos:topConceptOf": {
        "@id": "lus:nzlum0.4.0"
      },
      "skos:usageNote": {
        "@language": "en",
        "@value": "Where a classification is based on information about legal protection, the relevant information (e.g. the Act) should be mentioned in the `comment` field."
      }
    },
    {
      "@id": "com:gerberas",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "lus:commodities"
      },
      "skos:notation": "gerberas"
    },
    {
      "@id": "mgmt:milking_rotary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "lus:management_practices"
      },
      "skos:notation": "milking rotary"
    },
    {
      "@id": "luc:minimal_use_relatively_natural",
      "@type": "skos:Concept",
      "lu:colour": "#FFC77A",
      "skos:broader": {
        "@id": "luc:conservation"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "This class includes land that is subject to relatively low levels of intervention or that is largely unused in the context of prime use or use for resource protection. This land may be covered with indigenous or exotic plant species. It includes land where the structure of the native vegetation generally remains intact despite deliberate use, although the floristics of the vegetation may have changed markedly (e.g. grazing on native tussock land)."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:narrower": [
        {
          "@id": "luc:grazing_native_vegetation"
        },
        {
          "@id": "luc:carbon_forest_retained"
        },
        {
          "@id": "luc:customary_use"
        },
        {
          "@id": "luc:defence_land_natural_areas"
        },
        {
          "@id": "luc:ground_water"
        },
        {
          "@id": "luc:surface_water_supply"
        },
        {
          "@id": "luc:environmental_infrastructure_protection"
        },
        {
          "@id": "luc:production_from_indigenous_vegetation"
        }
      ],
      "skos:notation": "1.3.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Minimal use from relatively natural environments"
      },
      "skos:scopeNote": {
        "@language": "en",
        "@value": "Where native grasses have been deliberately and extensively replaced with other species, the land use should not be classified under class 1."
      }
    },
    {
      "@id": "luc:production_from_indigenous_vegetation",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "luc:minimal_use_relatively_natural"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "The definition of this class was clarified in NZLUM v0.4.0 by explicitly referring to non-plantation native forests."
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Commercial production from retained (non-plantation) native forests and related activities on public and private land (e.g. selective native timber production without clearfelling, and other non-sawlong, non-pulpwood, native forest products including oil, wildflowers, firewood, fenceposts, and mānuka/kānuka honey)."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "1.3.4",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Production from indigenous vegetation"
      }
    },
    {
      "@id": "luc:municipal_wastewater",
      "@type": "skos:Concept",
      "skos:broader": {
        "@id": "luc:waste_treatment_disposal"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Wastewater generated from residential, commercial, and industrial activities within urban areas requiring treatment before discharge or reuse; includes municipal wastewater ponds and sewerage pipelines."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "3.8.3",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Municipal wastewater"
      }
    },
