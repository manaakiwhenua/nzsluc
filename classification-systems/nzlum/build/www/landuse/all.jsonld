    {
      "@id": "luc:habitat_or_species_management",
      "@type": "skos:Concept",
      "dcterms:source": {
        "@language": "en",
        "@value": "IUCN (2008) Protected Areas Management Categories, Category IV: Habitat/Species Management Area."
      },
      "lu:colour": "#C9CAE3",
      "skos:broader": {
        "@id": "luc:nature_cons"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Protected area managed mainly for conservation through management intervention. An area of land or sea subject to active intervention for management purposes to ensure the maintenance of habitats or to meet the requirements of specific species. This may include areas on private land."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:notation": "1.1.5",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Habitat or species management area"
      }
    },
    {
      "@id": "mgmt:mulching_matting",
