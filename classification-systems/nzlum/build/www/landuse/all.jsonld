    {
      "@id": "luc:unused_and_transitioning",
      "@type": "skos:Concept",
      "lu:colour": "#C8C69F",
      "skos:broader": {
        "@id": "luc:conservation"
      },
      "skos:changeNote": {
        "@id": "https://github.com/manaakiwhenua/nzsluc/issues/36"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Land unused for rural production and urban development, without particular conservation instruments, and without any apparent built structure; or land that is transitioning towards a vacant and considerably natural state."
      },
      "skos:inScheme": {
        "@id": "lus:nzlum0.4.0"
      },
      "skos:narrower": [
        {
          "@id": "luc:unused_land"
        },
        {
          "@id": "luc:rehabilitating_land"
        }
      ],
      "skos:notation": "1.4.0",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Unused and transitioning land"
      },
      "skos:scopeNote": [
        {
          "@language": "en",
          "@value": "Unused land (in the sense of non-productive, non-conservation or non-built uses), such as cliffs, rock faces, boulders, and tors, and where there are relatively low levels of disturbance, may be included."
        },
        {
          "@language": "en",
          "@value": "Corridors and roadside areas may fit under this class."
        },
        {
          "@language": "en",
          "@value": "Does not per se include land undergoing natural succession in the context of changing plant species."
        }
      ]
    },
    {
      "@id": "com:rosemary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "lus:commodities"
      },
      "skos:notation": "rosemary"
    },
