    {
      "@id": "luc:protected_landscape",
      "@type": "skos:Concept",
      "dcterms:source": {
        "@language": "en",
        "@value": "IUCN (2008) Protected Areas Management Categories, Category V: Protected Landscape/Seascape."
      },
      "lu:colour": "#E9E8F2",
      "skos:broader": {
        "@id": "luc:nature_cons"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Protected area managed mainly for landscape conservation and recreation. An area of land where the interaction of people and nature over time has produced a distinct character with significant aesthetic, cultural or ecological value, and often high biodiversity."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
