        "@id": "luc:built_environment"
      },
      "skos:changeNote": [
        {
          "@language": "en",
          "@value": "Class 3.5.0 redefined at v0.4.0 to include naviation and communciation infrastructure, which was formerly captured under class 3.6.0."
        },
        {
          "@id": "https://github.com/manaakiwhenua/nzsluc/issues/69"
        }
      ],
      "skos:definition": {
        "@language": "en",
        "@value": "Land allocated to providing electricity, gas, or water; or for navigation and communication infrastructure."
      },
      "skos:inScheme": [
        {
          "@id": "lus:nzlum0.4.0"
        },
        {
          "@id": "lus:nzlum0.3.0"
        }
      ],
      "skos:narrower": [
